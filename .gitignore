# Visual Studio / .NET
.vs/
concepts/
_agoraProbe/AgoraProbe/bin/
_agoraProbe/AgoraProbe/obj/

# Build output (covers every project, including leftover local trees)
bin/
obj/

# Visual Studio user-local settings (machine paths, debug profile, publish history)
*.user

# Local API file store used in Development
**/App_Data/

# Temporary files from checklist PDF export
docs/checklist/*.__export__.md
docs/checklist/*.__export__.pdf

# Local PDF brand copies (canonical logo is docs/partner-updates/brand/)
docs/partner-updates/sources/
docs/mobile-updates/sources/

# HBand Android SDK binaries (download with tools/download-hband-android-libs.ps1; see Platforms/Android/libs/README.md)
RaphCare.Mobile/Platforms/Android/libs/*.aar
RaphCare.Mobile/Platforms/Android/libs/*.jar

# Local Azure / Play publish outputs and signing material (never commit)
artifacts/
*.keystore
*.jks
raphcare-upload.keystore

# md-to-pdf export copies of the logo (scripts copy from docs/*/brand/)
docs/partner-updates/sources/brand/
docs/partner-updates/sources/archives/brand/
docs/mobile-updates/sources/brand/
docs/mobile-updates/sources/archives/brand/
docs/**/*.__export__.*
