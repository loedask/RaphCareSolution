@if (!string.IsNullOrEmpty(Href))
{
    <a class="hospital-deck-rail-item is-link @(IsActive ? "is-active" : null)"
       href="@Href"
       aria-current="@(IsActive ? "page" : null)">
        <span class="hospital-deck-rail-index" aria-hidden="true">@Index</span>
        <HospitalDeckIcon Name="@Icon" />
        @ChildContent
        @if (Count is int count)
        {
            <span class="hospital-deck-rail-count">@count</span>
        }
    </a>
}
else
{
    <button type="button"
            class="hospital-deck-rail-item @(IsActive ? "is-active" : null)"
            aria-current="@(IsActive ? "page" : null)"
            @onclick="OnSelect">
        <span class="hospital-deck-rail-index" aria-hidden="true">@Index</span>
        <HospitalDeckIcon Name="@Icon" />
        @ChildContent
        @if (Count is int count)
        {
            <span class="hospital-deck-rail-count">@count</span>
        }
    </button>
}

@code {
    [Parameter] public string Index { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "grid";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public int? Count { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
