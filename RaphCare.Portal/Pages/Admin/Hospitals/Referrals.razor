@page "/admin/hospitals/{ClinicId:guid}/referrals"
@layout AdminLayout
@using RaphCare.Domain.Common
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("Referral_PageTitle")</PageTitle>

<section class="admin-page hospital-deck">
    @if (_loading && _board is null)
    {
        <HospitalDeckLoading Message="@AppResources.T("Referral_Loading")" />
    }
    else
    {
        <HospitalDeckMasthead BackHref="@HospitalDeckReturnUrl.ForLinkedSectionReturn(ClinicId, "referrals")"
                              BackText="@AppResources.T("Common_BackToHospital")"
                              Monogram="@HospitalDeckInitials.FromName(_clinicName)"
                              Eyebrow="@AppResources.T("Referral_Title")"
                              Title="@_clinicName"
                              Lead="@AppResources.Format("Referral_Lead", _clinicName)"
                              StatusText="@FormatStatusLine()">
            <HospitalDeckChip Label="@AppResources.T("Referral_Sent")" Value="@SentCount.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Referral_Accepted")" Value="@AcceptedCount.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Referral_Completed")" Value="@CompletedCount.ToString()" />
        </HospitalDeckMasthead>

        <AdminAlert Message="@_error" />
        <AdminAlert Tone="success" Message="@_success" />

        <div class="hospital-deck-workspace">
        <HospitalDeckRail AriaLabel="@AppResources.T("Referral_SectionsAria")"
                          Kicker="@AppResources.T("Referral_Title")">
            <HospitalDeckRailItem Index="01" Icon="referral" IsActive="@(_tab == "open")" Count="@(_board?.Open.Count)" OnSelect='() => SetTab("open")'>
                @AppResources.T("Referral_OpenList")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="02" Icon="history" IsActive="@(_tab == "recent")" Count="@(_board?.Recent.Count)" OnSelect='() => SetTab("recent")'>
                @AppResources.T("Referral_Recent")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="03" Icon="admit" IsActive="@(_tab == "log")" OnSelect='() => SetTab("log")'>
                @AppResources.T("Referral_LogReferral")
            </HospitalDeckRailItem>
        </HospitalDeckRail>

        <div class="hospital-deck-stage">
        @if (_tab == "open")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Referral_Eyebrow")" Title="@AppResources.T("Referral_OpenList")">
                <div class="admin-page-card-body">
                    @if (_board is null || _board.Open.Count == 0)
                    {
                        <p class="text-muted">@AppResources.T("Referral_NoOpen")</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@AppResources.T("Referral_ReferredAt")</th>
                                        <th>@AppResources.T("Common_Patient")</th>
                                        <th>@AppResources.T("Referral_ReferredTo")</th>
                                        <th>@AppResources.T("Referral_Specialty")</th>
                                        <th>@AppResources.T("Referral_Reason")</th>
                                        <th>@AppResources.T("Common_Status")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var referral in _board.Open)
                                    {
                                        <tr>
                                            <td>@FormatLocal(referral.ReferredAt)</td>
                                            <td>
                                                <HospitalDirectoryPerson Name="@referral.PatientName"
                                                                         Href="@(referral.PatientId is Guid referralPatientId ? HospitalDeckReturnUrl.PatientHref(ClinicId, referralPatientId, HospitalDeckReturnUrl.ForClinicPage(ClinicId, "referrals")) : null)" />
                                            </td>
                                            <td>@referral.ReferredTo</td>
                                            <td>@(string.IsNullOrWhiteSpace(referral.Specialty) ? AppResources.T("Common_EmptyCell") : referral.Specialty)</td>
                                            <td>@(string.IsNullOrWhiteSpace(referral.Reason) ? AppResources.T("Common_EmptyCell") : referral.Reason)</td>
                                            <td>@FormatReferralStatus(referral.Status)</td>
                                            <td>
                                                @if (string.Equals(referral.Status, "Sent", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button" class="btn btn-secondary" disabled="@(_savingId == referral.Id)" @onclick="() => AcceptReferralAsync(referral.Id)">
                                                        @AppResources.T("Referral_Accept")
                                                    </button>
                                                }
                                                @if (string.Equals(referral.Status, "Sent", StringComparison.OrdinalIgnoreCase)
                                                     || string.Equals(referral.Status, "Accepted", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button" class="btn btn-primary" disabled="@(_savingId == referral.Id)" @onclick="() => CompleteReferralAsync(referral.Id)">
                                                        @AppResources.T("Referral_Complete")
                                                    </button>
                                                    <button type="button" class="btn btn-ghost" disabled="@(_savingId == referral.Id)" @onclick="() => CancelReferralAsync(referral.Id)">
                                                        @AppResources.T("Referral_Cancel")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </AdminPageCard>
        }
        else if (_tab == "recent")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Referral_Eyebrow")" Title="@AppResources.T("Referral_Recent")">
                <div class="admin-page-card-body">
                    @if (_board is null || _board.Recent.Count == 0)
                    {
                        <p class="text-muted">@AppResources.T("Referral_NoRecent")</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@AppResources.T("Referral_ReferredAt")</th>
                                        <th>@AppResources.T("Common_Patient")</th>
                                        <th>@AppResources.T("Referral_ReferredTo")</th>
                                        <th>@AppResources.T("Referral_Specialty")</th>
                                        <th>@AppResources.T("Referral_Reason")</th>
                                        <th>@AppResources.T("Common_Status")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var referral in _board.Recent)
                                    {
                                        <tr>
                                            <td>@FormatLocal(referral.ReferredAt)</td>
                                            <td>
                                                <HospitalDirectoryPerson Name="@referral.PatientName"
                                                                         Href="@(referral.PatientId is Guid referralPatientId ? HospitalDeckReturnUrl.PatientHref(ClinicId, referralPatientId, HospitalDeckReturnUrl.ForClinicPage(ClinicId, "referrals")) : null)" />
                                            </td>
                                            <td>@referral.ReferredTo</td>
                                            <td>@(string.IsNullOrWhiteSpace(referral.Specialty) ? AppResources.T("Common_EmptyCell") : referral.Specialty)</td>
                                            <td>@(string.IsNullOrWhiteSpace(referral.Reason) ? AppResources.T("Common_EmptyCell") : referral.Reason)</td>
                                            <td>@FormatReferralStatus(referral.Status)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </AdminPageCard>
        }
        else if (_tab == "log")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Referral_Eyebrow")" Title="@AppResources.T("Referral_LogReferral")">
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            @AppResources.T("Inpatient_FindPatientLabel")
                            <div class="inpatient-search-row">
                                <input class="form-control" @bind="_patientSearch" @bind:event="oninput" placeholder="@AppResources.T("Inpatient_NameOrPhonePlaceholder")" />
                                <button type="button" class="btn btn-secondary" disabled="@_searchingPatients" @onclick="SearchPatientsAsync">
                                    @(_searchingPatients ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_Search"))
                                </button>
                            </div>
                        </label>
                        <label>
                            @AppResources.T("Common_Patient")
                            <SearchableSelect TValue="string"
                                              @bind-Value="_selectedPatientId"
                                              Placeholder="@AppResources.T("Common_SelectPatient")"
                                              Options="PatientOptions" />
                        </label>
                        <label>
                            @AppResources.T("Referral_ReferredTo")
                            <input class="form-control" @bind="_referredTo" placeholder="@AppResources.T("Referral_ReferredToPlaceholder")" />
                        </label>
                        <label>
                            @AppResources.T("Referral_Specialty")
                            <input class="form-control" @bind="_specialty" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                        <label>
                            @AppResources.T("Referral_Reason")
                            <input class="form-control" @bind="_reason" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                        <label>
                            @AppResources.T("Referral_Notes")
                            <input class="form-control" @bind="_notes" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="CreateReferralAsync">
                            @AppResources.T("Referral_LogReferral")
                        </button>
                    </div>
                </div>
            </AdminPageCard>
        }
        </div>
        </div>

        <div class="hospital-deck-foot">
            <HospitalDeckBackLink Href="@HospitalDeckReturnUrl.ForLinkedSectionReturn(ClinicId, "referrals")" Text="@AppResources.T("Common_BackToHospital")" />
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _busy;
    private bool _searchingPatients;
    private string _tab = "open";
    private Guid? _savingId;
    private string? _error;
    private string? _success;
    private string _clinicName = AppResources.T("Common_ThisHospital");
    private string _clinicTimeZone = "UTC";
    private string _patientSearch = string.Empty;
    private string _selectedPatientId = string.Empty;
    private string _referredTo = string.Empty;
    private string _specialty = string.Empty;
    private string _reason = string.Empty;
    private string _notes = string.Empty;
    private ClinicReferralBoard? _board;
    private IReadOnlyList<ClinicPatientListItem> _patients = Array.Empty<ClinicPatientListItem>();

    private int SentCount => _board?.SentCount ?? 0;
    private int AcceptedCount => _board?.AcceptedCount ?? 0;
    private int CompletedCount => _board?.CompletedCount ?? 0;

    private IReadOnlyList<SelectOption<string>> PatientOptions =>
        _patients.Select(p => new SelectOption<string>(p.PatientId.ToString(), $"{p.FirstName} {p.LastName}")).ToArray();

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        await LoadBoardAsync();
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private void SetTab(string tab) => _tab = tab;

    private string FormatStatusLine() =>
        AppResources.Format("Referral_StatusLine", SentCount, AcceptedCount, CompletedCount);

    private string FormatLocal(DateTime utc) =>
        ClinicTimeZoneHelper.FormatClinicLocal(utc, _clinicTimeZone);

    private static string FormatReferralStatus(string? status) =>
        status switch
        {
            "Sent" => AppResources.T("Referral_Sent"),
            "Accepted" => AppResources.T("Referral_Accepted"),
            "Completed" => AppResources.T("Referral_Completed"),
            "Cancelled" => AppResources.T("Common_Cancelled"),
            _ => string.IsNullOrWhiteSpace(status) ? AppResources.T("Common_EmptyCell") : status
        };

    private async Task LoadBoardAsync()
    {
        _busy = true;
        if (_board is null)
            _loading = true;
        _error = null;
        var response = await AdminClinicService.GetReferralBoardAsync(ClinicId);
        _busy = false;
        _loading = false;
        if (response.IsSuccess && response.Data is not null)
        {
            _board = response.Data;
            if (!string.IsNullOrWhiteSpace(response.Data.ClinicName))
                _clinicName = response.Data.ClinicName;
        }
        else
            _error = response.ErrorMessage ?? AppResources.T("Referral_CouldNotLoad");
    }

    private async Task SearchPatientsAsync()
    {
        _searchingPatients = true;
        var patients = await AdminClinicService.GetPatientsAsync(
            ClinicId, 1, 50, string.IsNullOrWhiteSpace(_patientSearch) ? null : _patientSearch.Trim());
        _searchingPatients = false;

        if (patients.IsSuccess && patients.Data is not null)
            _patients = patients.Data.Items;
        else
            _error = patients.ErrorMessage ?? AppResources.T("Common_CouldNotLoadPatients");
    }

    private async Task CreateReferralAsync()
    {
        _error = null;
        _success = null;
        if (!Guid.TryParse(_selectedPatientId, out var patientId) || patientId == Guid.Empty)
        {
            _error = AppResources.T("Referral_PatientRequired");
            return;
        }

        if (string.IsNullOrWhiteSpace(_referredTo))
        {
            _error = AppResources.T("Referral_ReferredToRequired");
            return;
        }

        _busy = true;
        var response = await AdminClinicService.CreateReferralAsync(ClinicId, new CreateReferralRequest
        {
            PatientId = patientId,
            ReferredTo = _referredTo.Trim(),
            Specialty = string.IsNullOrWhiteSpace(_specialty) ? null : _specialty.Trim(),
            Reason = string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(),
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
        });
        _busy = false;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Referral_CouldNotCreate");
            return;
        }

        _success = AppResources.T("Referral_Created");
        _selectedPatientId = string.Empty;
        _referredTo = string.Empty;
        _specialty = string.Empty;
        _reason = string.Empty;
        _notes = string.Empty;
        _tab = "open";
        await LoadBoardAsync();
    }

    private Task AcceptReferralAsync(Guid referralId) => UpdateStatusAsync(referralId, "Accepted");

    private Task CompleteReferralAsync(Guid referralId) => UpdateStatusAsync(referralId, "Completed");

    private Task CancelReferralAsync(Guid referralId) => UpdateStatusAsync(referralId, "Cancelled");

    private async Task UpdateStatusAsync(Guid referralId, string status)
    {
        _savingId = referralId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.UpdateReferralStatusAsync(ClinicId, referralId, status);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Referral_CouldNotUpdate");
            return;
        }

        _success = AppResources.T("Referral_StatusUpdated");
        await LoadBoardAsync();
    }
}
