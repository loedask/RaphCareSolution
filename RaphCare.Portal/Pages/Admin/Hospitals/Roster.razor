@page "/admin/hospitals/{ClinicId:guid}/roster"
@layout AdminLayout
@using RaphCare.Domain.Common
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("Roster_PageTitle")</PageTitle>

<section class="admin-page hospital-deck">
    @if (_loading && _board is null)
    {
        <HospitalDeckLoading Message="@AppResources.T("Roster_Loading")" />
    }
    else
    {
        <HospitalDeckMasthead BackHref="@HospitalDeckReturnUrl.ForLinkedSectionReturn(ClinicId, "roster")"
                              BackText="@AppResources.T("Common_BackToHospital")"
                              Monogram="@HospitalDeckInitials.FromName(_clinicName)"
                              Eyebrow="@AppResources.T("Roster_Title")"
                              Title="@_clinicName"
                              Lead="@AppResources.Format("Roster_Lead", _clinicName)"
                              StatusText="@FormatStatusLine()"
                              ClinicId="@ClinicId"
                              ClinicName="@_clinicName"
                              CurrentCrumb="@AppResources.T("Roster_Title")">
            <HospitalDeckChip Label="@AppResources.T("Roster_Morning")" Value="@MorningCount.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Roster_Afternoon")" Value="@AfternoonCount.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Roster_Night")" Value="@NightCount.ToString()" />
        </HospitalDeckMasthead>

        <AdminAlert Message="@_error" />
        <AdminAlert Tone="success" Message="@_success" />

        <div class="hospital-deck-workspace">
        <HospitalDeckRail AriaLabel="@AppResources.T("Roster_SectionsAria")"
                          Kicker="@AppResources.T("Roster_Title")">
            <HospitalDeckRailItem Index="01" Icon="roster" IsActive="@(_tab == "list")" Count="@(_board?.Entries.Count)" OnSelect='() => SetTab("list")'>
                @AppResources.T("Roster_TodaysList")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="02" Icon="admit" IsActive="@(_tab == "add")" OnSelect='() => SetTab("add")'>
                @AppResources.T("Roster_AddPerson")
            </HospitalDeckRailItem>
        </HospitalDeckRail>

        <div class="hospital-deck-stage">
        @if (_tab == "list")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Roster_Eyebrow")"
                           Title="@AppResources.T("Roster_TodaysList")"
                           Lead="@AppResources.T("Roster_TodaysListLead")">
                <div class="admin-page-card-body">
                    <div class="form-grid" style="margin-bottom: 1rem;">
                        <label>
                            @AppResources.T("Roster_DayLabel")
                            <input class="form-control" type="date" @bind="_dayLocal" @bind:format="yyyy-MM-dd" @bind:after="LoadBoardAsync" />
                        </label>
                    </div>
                    @if (_board is null || _board.Entries.Count == 0)
                    {
                        <p class="text-muted">@AppResources.T("Roster_NoEntries")</p>
                    }
                    else
                    {
                        @foreach (var shift in ShiftOrder)
                        {
                            var shiftEntries = _board.Entries.Where(e => string.Equals(e.ShiftLabel, shift, StringComparison.OrdinalIgnoreCase)).ToList();
                            <h3 class="hospital-deck-section-title">@FormatShift(shift) (@shiftEntries.Count)</h3>
                            @if (shiftEntries.Count == 0)
                            {
                                <p class="text-muted">@AppResources.T("Roster_ShiftEmpty")</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>@AppResources.T("Common_Staff")</th>
                                                <th>@AppResources.T("Common_Roles")</th>
                                                <th>@AppResources.T("Roster_NoteLabel")</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in shiftEntries)
                                            {
                                                <tr>
                                                    <td>
                                                        <div>@entry.DisplayName</div>
                                                        @if (!string.IsNullOrWhiteSpace(entry.Email))
                                                        {
                                                            <div class="text-muted">@entry.Email</div>
                                                        }
                                                    </td>
                                                    <td>@(entry.Roles.Count == 0 ? AppResources.T("Common_EmptyCell") : string.Join(", ", entry.Roles))</td>
                                                    <td>@(string.IsNullOrWhiteSpace(entry.Note) ? AppResources.T("Common_EmptyCell") : entry.Note)</td>
                                                    <td>
                                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@(_removingId == entry.Id)" @onclick="() => RemoveAsync(entry.Id)">
                                                            @(_removingId == entry.Id ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_Remove"))
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    }
                </div>
            </AdminPageCard>
        }
        else if (_tab == "add")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Roster_Eyebrow")"
                           Title="@AppResources.T("Roster_AddPerson")"
                           Lead="@AppResources.T("Roster_AddPersonLead")">
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            @AppResources.T("Roster_DayLabel")
                            <input class="form-control" type="date" @bind="_dayLocal" @bind:format="yyyy-MM-dd" />
                        </label>
                        <label>
                            @AppResources.T("Common_Staff")
                            <SearchableSelect TValue="string"
                                              @bind-Value="_selectedStaffId"
                                              Placeholder="@AppResources.T("Roster_SelectStaff")"
                                              Options="StaffSelectOptions" />
                        </label>
                        <label>
                            @AppResources.T("Roster_ShiftLabel")
                            <SearchableSelect TValue="string"
                                              @bind-Value="_shiftLabel"
                                              Options="ShiftSelectOptions" />
                        </label>
                        <label>
                            @AppResources.T("Roster_NoteLabel")
                            <input class="form-control" @bind="_note" placeholder="@AppResources.T("Roster_NotePlaceholder")" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="AddAsync">
                            @(_busy ? AppResources.T("Common_PleaseWait") : AppResources.T("Roster_AddPerson"))
                        </button>
                    </div>
                </div>
            </AdminPageCard>
        }
        </div>
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private static readonly string[] ShiftOrder = ["Morning", "Afternoon", "Night"];

    private bool _loading = true;
    private bool _busy;
    private Guid? _removingId;
    private string _tab = "list";
    private string? _error;
    private string? _success;
    private string _clinicName = string.Empty;
    private string _clinicTimeZone = "UTC";
    private DateTime _dayLocal;
    private ClinicRosterBoard? _board;
    private IReadOnlyList<ClinicStaffMember> _staff = Array.Empty<ClinicStaffMember>();
    private string _selectedStaffId = string.Empty;
    private string _shiftLabel = "Morning";
    private string _note = string.Empty;

    private int MorningCount => _board?.MorningCount ?? 0;
    private int AfternoonCount => _board?.AfternoonCount ?? 0;
    private int NightCount => _board?.NightCount ?? 0;

    private IReadOnlyList<SelectOption<string>> StaffSelectOptions =>
        _staff
            .Where(s => s.UserId is Guid && !s.IsPendingInvitation)
            .Select(s => new SelectOption<string>(s.UserId!.Value.ToString(), DisplayStaff(s)))
            .ToArray();

    private IReadOnlyList<SelectOption<string>> ShiftSelectOptions =>
    [
        new("Morning", AppResources.T("Roster_Morning")),
        new("Afternoon", AppResources.T("Roster_Afternoon")),
        new("Night", AppResources.T("Roster_Night"))
    ];

    protected override void OnInitialized() =>
        CultureService.CultureChanged += OnCultureChanged;

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }
        else
        {
            _clinicName = AppResources.T("Common_ThisHospital");
        }

        var localNow = ClinicTimeZoneHelper.ToClinicLocal(DateTime.UtcNow, _clinicTimeZone);
        _dayLocal = localNow.Date;
        await LoadStaffAsync();
        await LoadBoardAsync();
    }

    private void SetTab(string tab) => _tab = tab;

    private string FormatStatusLine() =>
        AppResources.Format("Roster_DaySummary", MorningCount, AfternoonCount, NightCount);

    private static string FormatShift(string shift) =>
        shift switch
        {
            "Morning" => AppResources.T("Roster_Morning"),
            "Afternoon" => AppResources.T("Roster_Afternoon"),
            "Night" => AppResources.T("Roster_Night"),
            _ => shift
        };

    private static string DisplayStaff(ClinicStaffMember staff) =>
        string.IsNullOrWhiteSpace(staff.DisplayName) ? (staff.Email ?? "Staff") : staff.DisplayName;

    private DateTime SelectedDayUtc() =>
        DateTime.SpecifyKind(_dayLocal.Date, DateTimeKind.Utc);

    private async Task LoadStaffAsync()
    {
        var response = await AdminClinicService.GetStaffAsync(ClinicId);
        if (response.IsSuccess && response.Data is not null)
            _staff = response.Data.Where(s => s.IsActive).ToList();
    }

    private async Task LoadBoardAsync()
    {
        _busy = true;
        if (_board is null)
            _loading = true;
        _error = null;
        var response = await AdminClinicService.GetRosterBoardAsync(ClinicId, SelectedDayUtc());
        _busy = false;
        _loading = false;
        if (response.IsSuccess && response.Data is not null)
            _board = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("Roster_CouldNotLoad");
    }

    private async Task AddAsync()
    {
        _error = null;
        _success = null;
        if (!Guid.TryParse(_selectedStaffId, out var userId) || userId == Guid.Empty)
        {
            _error = AppResources.T("Roster_StaffRequired");
            return;
        }

        _busy = true;
        var response = await AdminClinicService.CreateRosterEntryAsync(ClinicId, new CreateRosterEntryRequest
        {
            ApplicationUserId = userId,
            DutyDate = SelectedDayUtc(),
            ShiftLabel = _shiftLabel,
            Note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim()
        });
        _busy = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Roster_CouldNotAdd");
            return;
        }

        _success = AppResources.T("Roster_Added");
        _note = string.Empty;
        _tab = "list";
        await LoadBoardAsync();
    }

    private async Task RemoveAsync(Guid entryId)
    {
        _error = null;
        _success = null;
        _removingId = entryId;
        var response = await AdminClinicService.DeleteRosterEntryAsync(ClinicId, entryId);
        _removingId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Roster_CouldNotRemove");
            return;
        }

        _success = AppResources.T("Roster_Removed");
        await LoadBoardAsync();
    }
}
