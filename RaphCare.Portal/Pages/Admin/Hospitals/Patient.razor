                                    <div class="admin-page-actions">
                                        <button type="button" class="btn btn-primary" disabled="@(_savingTherapyNote || string.IsNullOrWhiteSpace(_newNoteText))" @onclick="() => SaveTherapyNoteAsync(noteSessionId)">
                                            @(_savingTherapyNote ? AppResources.T("Common_Saving") : AppResources.T("PatientDetail_AddTherapyNote"))
                                        </button>
                                        <button type="button" class="btn btn-ghost" disabled="@_savingTherapyNote" @onclick="CancelNoteForm">
                                            @AppResources.T("Common_Cancel")
                                        </button>
                                    </div>
                                </div>
                            }
                                        }
                                else if (_carePanel == "plans")
                                {
                            <AdminAlert Message="@_carePlanError" />
                            @if (_loadingCarePlans)
                            {
                                <p class="text-muted">@AppResources.T("Common_Loading")</p>
                            }
                            else if (_behavioralPlans.Count == 0)
                            {
                                <p class="text-muted">@AppResources.T("PatientDetail_NoBehavioralCarePlans")</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>@AppResources.T("Common_Title")</th>
                                                <th>@AppResources.T("Common_Status")</th>
                                                <th>@AppResources.T("PatientDetail_TherapyGoal")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var plan in _behavioralPlans)
                                            {
                                                <tr>
                                                    <td>@plan.Title</td>
                                                    <td>@plan.Status</td>
                                                    <td>
                                                        @if (plan.Goals.Count == 0)
                                                        {
                                                            @AppResources.T("Common_EmptyCell")
                                                        }
                                                        else
                                                        {
                                                            @string.Join("; ", plan.Goals.Select(g => g.GoalDescription))
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <div class="admin-page-actions" style="margin-top: 1rem;">
                                @if (!_showCarePlanForm)
                                {
                                    <button type="button" class="btn btn-secondary" @onclick="() => _showCarePlanForm = true">
                                        @AppResources.T("PatientDetail_CreateCarePlan")
                                    </button>
                                }
                            </div>

                            @if (_showCarePlanForm)
                            {
                                <div class="form-grid single-column" style="margin-top: 1rem;">
                                    <div class="form-field">
                                        <label>@AppResources.T("PatientDetail_CarePlanTitle")</label>
                                        <input class="form-control" @bind="_newPlanTitle" />
                                    </div>
                                    <div class="form-field">
                                        <label>@AppResources.T("PatientDetail_CarePlanDescription")</label>
                                        <textarea class="form-control" rows="2" @bind="_newPlanDescription"></textarea>
                                    </div>
                                    <div class="form-field">
                                        <label>@AppResources.T("PatientDetail_TherapyGoal")</label>
                                        <input class="form-control" @bind="_newPlanGoal" />
                                    </div>
                                    <div class="form-field">
                                        <label>@AppResources.T("PatientDetail_GoalTargetDate")</label>
                                        <input class="form-control" type="date" @bind="_newPlanGoalDate" />
                                    </div>
                                    <div class="admin-page-actions">
                                        <button type="button" class="btn btn-primary" disabled="@(_savingCarePlan || string.IsNullOrWhiteSpace(_newPlanTitle) || string.IsNullOrWhiteSpace(_newPlanGoal))" @onclick="SaveCarePlanAsync">
                                            @(_savingCarePlan ? AppResources.T("Common_Saving") : AppResources.T("PatientDetail_CreateCarePlan"))
                                        </button>
                                        <button type="button" class="btn btn-ghost" disabled="@_savingCarePlan" @onclick="CancelCarePlanForm">
                                            @AppResources.T("Common_Cancel")
                                        </button>
                                    </div>
                                </div>
                            }
                                        }
                                else if (_carePanel == "ai")
                                {
                            <AdminAlert Message="@_aiDraftError" />
                            <div class="form-field">
                                <label>@AppResources.T("PatientDetail_AiNoteTextarea")</label>
                                <textarea class="form-control" rows="6" @bind="_aiDraftText"></textarea>
                            </div>
                            <div class="admin-page-actions" style="margin-top: 1rem;">
                                <button type="button" class="btn btn-secondary" disabled="@_draftingAiNote" @onclick="DraftAiNoteAsync">
                                    @(_draftingAiNote ? AppResources.T("Common_Loading") : AppResources.T("PatientDetail_DraftAiNote"))
                                </button>
                            </div>
                                        }
                                else if (_carePanel == "vitals")
                                {
                            @if (_patient.RecentVitals.Count == 0)
                            {
                                <p class="text-muted">@AppResources.T("Common_NoVisitVitals")</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>@AppResources.T("Common_Recorded")</th>
                                                <th>@AppResources.T("Common_Type")</th>
                                                <th>@AppResources.T("Common_Value")</th>
                                                <th>@AppResources.T("Common_Visit")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var vital in _patient.RecentVitals)
                                            {
                                                <tr>
                                                    <td>@FormatLocal(vital.RecordedAt)</td>
                                                    <td>@vital.Type</td>
                                                    <td>@vital.Value @vital.Unit</td>
                                                    <td>@(vital.VisitType ?? AppResources.T("Common_EmptyCell"))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                                        }
                                else if (_carePanel == "appointments")
                                {
                            @if (_patient.Appointments.Count == 0)
                            {
                                <p class="text-muted">@AppResources.T("Common_NoAppointmentsPatient") <a href="/admin/hospitals/@ClinicId/appointments">@AppResources.T("Common_BookOneLink")</a>.</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>@AppResources.T("Common_Date")</th>
                                                <th>@AppResources.T("Common_Provider")</th>
                                                <th>@AppResources.T("Common_Type")</th>
                                                <th>@AppResources.T("Common_Status")</th>
                                                <th>@AppResources.T("Common_Reason")</th>
                                                @if (_isAdministrator)
                                                {
                                                    <th></th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var appt in _patient.Appointments)
                                            {
                                                <tr>
                                                    <td>@FormatLocal(appt.ScheduledStart)</td>
                                                    <td>@appt.ProviderName</td>
                                                    <td>@appt.Type</td>
                                                    <td>@appt.Status</td>
                                                    <td>@(string.IsNullOrWhiteSpace(appt.Reason) ? AppResources.T("Common_EmptyCell") : appt.Reason)</td>
                                                    @if (_isAdministrator && appt.Status != "Cancelled")
                                                    {
                                                        <td class="admin-table-actions">
                                                            <a class="btn btn-ghost btn-sm" href="/admin/hospitals/@ClinicId/appointments">@AppResources.T("Common_Manage")</a>
                                                        </td>
                                                    }
                                                    else if (_isAdministrator)
                                                    {
                                                        <td></td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                                        }
                                else if (_carePanel == "visits")
                                {
                            @if (_patient.RecentVisits.Count == 0)
                            {
                                <p class="text-muted">@AppResources.T("Common_NoVisitsPatient")</p>
                            }
                            else
                            {
                                <div class="table-wrap">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>@AppResources.T("Common_Date")</th>
                                                <th>@AppResources.T("Common_Type")</th>
                                                <th>@AppResources.T("Common_Status")</th>
                                                <th>@AppResources.T("Common_Summary")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var visit in _patient.RecentVisits)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="/admin/hospitals/@ClinicId/visits/@visit.Id">@FormatLocal(visit.VisitStart)</a>
                                                    </td>
                                                    <td>@visit.VisitType</td>
                                                    <td>@visit.Status</td>
                                                    <td>@(string.IsNullOrWhiteSpace(visit.Summary) ? AppResources.T("Common_EmptyCell") : visit.Summary)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                                        }
                            </div>
                        </div>
                    </AdminPageCard>
                }
            </div>
        </div>

        <div class="hospital-deck-foot">
            <HospitalDeckBackLink Href="@BackUrl" Text="@BackLinkText" />
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }
    [Parameter] public Guid PatientId { get; set; }
    [SupplyParameterFromQuery(Name = "return")] public string? ReturnQuery { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicalPatientDeviceReadingsService DeviceReadingsService { get; set; } = default!;
    [Inject] private IMentalHealthService MentalHealthService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _loadingEmergencies;
    private bool _loadingAssessments;
    private bool _loadingInstrument;
    private bool _savingAssessment;
    private bool _loadingTherapy;
    private bool _savingTherapy;
    private bool _savingTherapyNote;
    private bool _loadingCarePlans;
    private bool _savingCarePlan;
    private bool _draftingAiNote;
    private bool _revoking;
    private bool _isAdministrator;
    private string _tab = "overview";
    private string _clinicalPanel = "plans";
    private string _coveragePanel = "insurance";
    private string _carePanel = "mood";
    private string? _error;
    private string? _actionError;
    private string? _assessmentError;
    private string? _therapyError;
    private string? _carePlanError;
    private string? _aiDraftError;
    private string? _emergencyError;
    private bool _emergencyClinicContextMissing;
    private string? _clinicName;
    private string _clinicTimeZone = "UTC";
    private ClinicPatientDetail? _patient;
    private string? _photoDataUrl;
    private List<PatientDeviceEmergencyEventViewModel> _emergencyEvents = [];
    private int _emergencyTotal;
    private int _emergencyPage = 1;
    private const int EmergencyPageSize = 20;
    private List<MentalHealthAssessmentListItem> _assessments = [];
    private bool _showInstrumentForm;
    private MentalHealthInstrument? _instrument;
    private Dictionary<int, int> _instrumentAnswers = new();
    private Guid? _expandedAssessmentId;
    private Guid? _loadingAssessmentDetailId;
    private MentalHealthAssessmentDetail? _expandedAssessmentDetail;
    private List<TherapySessionListItem> _therapySessions = [];
    private bool _showSessionForm;
    private string _newSessionType = "Individual";
    private string _newSessionSummary = string.Empty;
    private Guid? _noteSessionId;
    private string _newNoteText = string.Empty;
    private string _newCrisisRisk = string.Empty;
    private string _newCrisisDescription = string.Empty;
    private List<BehavioralCarePlanItem> _behavioralPlans = [];
    private bool _showCarePlanForm;
    private string _newPlanTitle = string.Empty;
    private string _newPlanDescription = string.Empty;
    private string _newPlanGoal = string.Empty;
    private DateTime _newPlanGoalDate = DateTime.UtcNow.Date.AddDays(30);
    private string _aiDraftText = string.Empty;

    private string BackUrl => HospitalDeckReturnUrl.Resolve(
        ClinicId,
        ReturnQuery,
        HospitalDeckReturnUrl.ForClinicTab(ClinicId, "patients"));

    private string BackLinkText =>
        BackUrl.Contains("/inpatient", StringComparison.OrdinalIgnoreCase)
            ? AppResources.T("Common_BackToInpatient")
            : BackUrl.Contains("/collection", StringComparison.OrdinalIgnoreCase)
                ? AppResources.T("Common_BackToCollection")
                : BackUrl.Contains("/casualty", StringComparison.OrdinalIgnoreCase)
                    ? AppResources.T("Common_BackToCasualty")
                    : BackUrl.Contains("/consult", StringComparison.OrdinalIgnoreCase)
                        ? AppResources.T("Common_BackToConsult")
                        : BackUrl.Contains("/theatre", StringComparison.OrdinalIgnoreCase)
                            ? AppResources.T("Common_BackToTheatre")
                            : BackUrl.Contains("/referrals", StringComparison.OrdinalIgnoreCase)
                                ? AppResources.T("Common_BackToReferrals")
                                : AppResources.T("Common_BackToHospital");


    private string ClinicDisplayName => _clinicName ?? AppResources.T("Common_ThisHospital");

    private string TimeZoneLabel =>
        string.IsNullOrWhiteSpace(_clinicTimeZone) ? AppResources.T("Common_HospitalTime") : _clinicTimeZone;

    private int ClinicalNotesCount =>
        _patient is null ? 0 : _patient.SoapNotes.Count + _patient.ClinicalNotes.Count;

    private string ClinicalPanelMeta => _clinicalPanel switch
    {
        "diagnoses" => _patient is null ? "0" : _patient.Diagnoses.Count.ToString(),
        "prescriptions" => _patient is null ? "0" : _patient.Prescriptions.Count.ToString(),
        "notes" => ClinicalNotesCount.ToString(),
        "labs" => _patient is null ? "0" : _patient.LabResults.Count.ToString(),
        _ => FormatCarePlanCount(_patient?.CarePlans.Count ?? 0)
    };

    private string CoveragePanelMeta => _coveragePanel switch
    {
        "invoices" => FormatInvoiceCount(_patient?.Invoices.Count ?? 0),
        _ => FormatInsuranceCount(_patient?.InsuranceProfiles.Count ?? 0)
    };

    private string CarePanelMeta => _carePanel switch
    {
        "assessments" => FormatAssessmentCount(_assessments.Count),
        "therapy" => FormatTherapySessionCount(_therapySessions.Count),
        "plans" => FormatBehavioralPlanCount(_behavioralPlans.Count),
        "ai" => AppResources.T("PatientDetail_AiNoteTab"),
        "vitals" => FormatVitalCount(_patient?.RecentVitals.Count ?? 0),
        "appointments" => FormatAppointmentCount(_patient?.Appointments.Count ?? 0),
        "visits" => FormatVisitCount(_patient?.RecentVisits.Count ?? 0),
        _ => FormatMoodCount(_patient?.MoodLogs.Count ?? 0)
    };

    private int ClinicalSectionCount =>
        _patient is null
            ? 0
            : _patient.CarePlans.Count
              + _patient.Diagnoses.Count
              + _patient.Prescriptions.Count
              + _patient.SoapNotes.Count
              + _patient.ClinicalNotes.Count
              + _patient.LabResults.Count;

    private int CoverageSectionCount =>
        _patient is null ? 0 : _patient.InsuranceProfiles.Count + _patient.Invoices.Count;

    private int DevicesSectionCount =>
        _patient is null
            ? _emergencyTotal
            : _patient.DeviceDailyRollups.Count + _patient.RecentDeviceReadings.Count + _emergencyTotal;

    private int CareSectionCount =>
        _patient is null
            ? _assessments.Count + _therapySessions.Count + _behavioralPlans.Count
            : _patient.MoodLogs.Count
              + _assessments.Count
              + _therapySessions.Count
              + _behavioralPlans.Count
              + _patient.RecentVitals.Count
              + _patient.Appointments.Count
              + _patient.RecentVisits.Count;

    private bool InstrumentAnswersComplete =>
        _instrument is not null
        && _instrument.Questions.All(q => _instrumentAnswers.ContainsKey(q.Order) && _instrumentAnswers[q.Order] is >= 0 and <= 3);

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        _clinicName = ClinicContext.CurrentClinicName;

        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        await LoadPatientAsync();
        if (_patient is not null)
        {
            await LoadPhotoAsync();
            await LoadEmergenciesAsync(reset: true);
            await LoadAssessmentsAsync();
            await LoadTherapySessionsAsync();
            await LoadBehavioralCarePlansAsync();
        }
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private void SetTab(string tab) => _tab = tab;

    private void SetClinicalPanel(string panel) => _clinicalPanel = panel;

    private void SetCoveragePanel(string panel) => _coveragePanel = panel;

    private void SetCarePanel(string panel) => _carePanel = panel;

    private async Task LoadPatientAsync()
    {
        _loading = true;
        _error = null;
        var response = await AdminClinicService.GetPatientDetailAsync(ClinicId, PatientId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
            _patient = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadPatient");
    }

    private async Task LoadPhotoAsync()
    {
        var response = await AdminClinicService.GetPatientPhotoAsync(ClinicId, PatientId);
        if (response.IsSuccess && response.Data is { Bytes.Length: > 0 } photo)
            _photoDataUrl = $"data:{photo.ContentType};base64,{Convert.ToBase64String(photo.Bytes)}";
        else
            _photoDataUrl = null;
    }

    private async Task LoadEmergenciesAsync(bool reset)
    {
        if (reset)
        {
            _emergencyPage = 1;
            _emergencyEvents = [];
            _emergencyTotal = 0;
        }

        _loadingEmergencies = true;
        _emergencyError = null;
        _emergencyClinicContextMissing = false;
        var response = await DeviceReadingsService.GetEmergencyEventsAsync(
            PatientId, _emergencyPage, EmergencyPageSize);
        _loadingEmergencies = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _emergencyError = response.ErrorMessage ?? AppResources.T("Common_CouldNotLoadEmergencyEvents");
            _emergencyClinicContextMissing = ApiErrorMessages.IsClinicSelectionRequired(_emergencyError);
            return;
        }

        if (reset)
            _emergencyEvents = response.Data.Items.ToList();
        else
            _emergencyEvents.AddRange(response.Data.Items);

        _emergencyTotal = response.Data.TotalCount;
    }

    private async Task RetryEmergenciesAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId, _clinicName).ConfigureAwait(false);
        await LoadEmergenciesAsync(reset: true);
    }

    private async Task LoadMoreEmergenciesAsync()
    {
        _emergencyPage++;
        await LoadEmergenciesAsync(reset: false);
    }

    private async Task LoadAssessmentsAsync()
    {
        _loadingAssessments = true;
        _assessmentError = null;
        var response = await MentalHealthService.GetAssessmentsAsync(ClinicId, PatientId, pageNumber: 1, pageSize: 50);
        _loadingAssessments = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _assessmentError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadAssessments");
            _assessments = [];
            return;
        }

        _assessments = response.Data.Items?.ToList() ?? [];
    }

    private async Task BeginInstrumentAsync(string assessmentType)
    {
        _assessmentError = null;
        _loadingInstrument = true;
        var response = await MentalHealthService.GetInstrumentAsync(assessmentType);
        _loadingInstrument = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _assessmentError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadInstrument");
            return;
        }

        _instrument = response.Data;
        _instrumentAnswers = new Dictionary<int, int>();
        _showInstrumentForm = true;
    }

    private void CancelInstrument()
    {
        _showInstrumentForm = false;
        _instrument = null;
        _instrumentAnswers = new Dictionary<int, int>();
    }

    private void SetInstrumentAnswer(int order, string? value)
    {
        if (int.TryParse(value, out var score) && score is >= 0 and <= 3)
            _instrumentAnswers[order] = score;
        else
            _instrumentAnswers.Remove(order);
    }

    private async Task SaveInstrumentAsync()
    {
        if (_instrument is null || !InstrumentAnswersComplete)
            return;

        _savingAssessment = true;
        _assessmentError = null;
        var request = new CreateMentalHealthAssessmentRequest
        {
            ClinicId = ClinicId,
            PatientId = PatientId,
            AssessmentType = _instrument.AssessmentType,
            Answers = _instrument.Questions
                .Select(q => new CreateMentalHealthAssessmentAnswerRequest
                {
                    Order = q.Order,
                    NumericScore = _instrumentAnswers[q.Order]
                })
                .ToList()
        };

        var response = await MentalHealthService.CreateAssessmentAsync(request);
        _savingAssessment = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _assessmentError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotSaveAssessment");
            return;
        }

        CancelInstrument();
        await LoadAssessmentsAsync();
        _expandedAssessmentId = response.Data.Id;
        _expandedAssessmentDetail = response.Data;
    }

    private async Task LoadTherapySessionsAsync()
    {
        _loadingTherapy = true;
        _therapyError = null;
        var response = await MentalHealthService.GetTherapySessionsAsync(ClinicId, PatientId, pageNumber: 1, pageSize: 50);
        _loadingTherapy = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _therapyError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadTherapySessions");
            _therapySessions = [];
            return;
        }

        _therapySessions = response.Data.Items?.ToList() ?? [];
    }

    private void CancelSessionForm()
    {
        _showSessionForm = false;
        _newSessionType = "Individual";
        _newSessionSummary = string.Empty;
    }

    private async Task SaveTherapySessionAsync()
    {
        _savingTherapy = true;
        _therapyError = null;
        var response = await MentalHealthService.CreateTherapySessionAsync(new CreateTherapySessionRequest
        {
            ClinicId = ClinicId,
            PatientId = PatientId,
            SessionType = string.IsNullOrWhiteSpace(_newSessionType) ? "Individual" : _newSessionType.Trim(),
            Summary = string.IsNullOrWhiteSpace(_newSessionSummary) ? null : _newSessionSummary.Trim(),
            IsConfidential = true
        });
        _savingTherapy = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _therapyError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotSaveTherapySession");
            return;
        }

        CancelSessionForm();
        await LoadTherapySessionsAsync();
    }

    private void BeginAddNote(Guid sessionId)
    {
        _noteSessionId = sessionId;
        _newNoteText = string.Empty;
        _newCrisisRisk = string.Empty;
        _newCrisisDescription = string.Empty;
        _therapyError = null;
    }

    private void CancelNoteForm()
    {
        _noteSessionId = null;
        _newNoteText = string.Empty;
        _newCrisisRisk = string.Empty;
        _newCrisisDescription = string.Empty;
    }

    private async Task SaveTherapyNoteAsync(Guid sessionId)
    {
        if (string.IsNullOrWhiteSpace(_newNoteText))
            return;

        _savingTherapyNote = true;
        _therapyError = null;
        var response = await MentalHealthService.AddTherapyNoteAsync(new AddTherapyNoteRequest
        {
            ClinicId = ClinicId,
            SessionId = sessionId,
            Notes = _newNoteText.Trim(),
            Category = "Progress",
            IsPrivate = true,
            CrisisRiskLevel = string.IsNullOrWhiteSpace(_newCrisisRisk) ? null : _newCrisisRisk.Trim(),
            CrisisDescription = string.IsNullOrWhiteSpace(_newCrisisDescription) ? null : _newCrisisDescription.Trim()
        });
        _savingTherapyNote = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _therapyError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotSaveTherapyNote");
            return;
        }

        CancelNoteForm();
        await LoadTherapySessionsAsync();
    }

    private async Task LoadBehavioralCarePlansAsync()
    {
        _loadingCarePlans = true;
        _carePlanError = null;
        var response = await MentalHealthService.GetBehavioralCarePlansAsync(ClinicId, PatientId, pageNumber: 1, pageSize: 50);
        _loadingCarePlans = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _carePlanError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadCarePlans");
            _behavioralPlans = [];
            return;
        }

        _behavioralPlans = response.Data.Items?.ToList() ?? [];
    }

    private void CancelCarePlanForm()
    {
        _showCarePlanForm = false;
        _newPlanTitle = string.Empty;
        _newPlanDescription = string.Empty;
        _newPlanGoal = string.Empty;
        _newPlanGoalDate = DateTime.UtcNow.Date.AddDays(30);
    }

    private async Task SaveCarePlanAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPlanTitle) || string.IsNullOrWhiteSpace(_newPlanGoal))
            return;

        _savingCarePlan = true;
        _carePlanError = null;
        var response = await MentalHealthService.CreateBehavioralCarePlanAsync(new CreateBehavioralCarePlanRequest
        {
            ClinicId = ClinicId,
            PatientId = PatientId,
            Title = _newPlanTitle.Trim(),
            Description = _newPlanDescription.Trim(),
            Goals =
            [
                new CreateBehavioralCarePlanGoalRequest
                {
                    GoalDescription = _newPlanGoal.Trim(),
                    TargetDate = DateTime.SpecifyKind(_newPlanGoalDate.Date, DateTimeKind.Utc)
                }
            ]
        });
        _savingCarePlan = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _carePlanError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotSaveCarePlan");
            return;
        }

        CancelCarePlanForm();
        await LoadBehavioralCarePlansAsync();
    }

    private async Task DraftAiNoteAsync()
    {
        _draftingAiNote = true;
        _aiDraftError = null;
        var response = await MentalHealthService.DraftMentalHealthNoteAsync(new DraftMentalHealthNoteRequest
        {
            ClinicId = ClinicId,
            PatientId = PatientId
        });
        _draftingAiNote = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _aiDraftError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotDraftAiNote");
            return;
        }

        _aiDraftText = response.Data.DraftText;
    }

