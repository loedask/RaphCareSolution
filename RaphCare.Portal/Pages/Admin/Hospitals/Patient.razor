                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>@AppResources.T("Common_Occurred")</th>
                                                <th>@AppResources.T("Common_Type")</th>
                                                <th>@AppResources.T("PatientDetail_Device")</th>
                                                <th>@AppResources.T("Common_Location")</th>
                                                <th>@AppResources.T("Common_Caregivers")</th>
                                            </tr>
                                        </thead>
