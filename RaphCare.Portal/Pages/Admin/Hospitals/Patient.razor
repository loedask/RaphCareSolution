                                        @(_loadingInstrument ? AppResources.T("Common_Loading") : AppResources.T("PatientDetail_RecordPhq9"))
                                    </button>
                                    <button type="button" class="btn btn-secondary" disabled="@_loadingInstrument" @onclick='() => BeginInstrumentAsync("GAD-7")'>
