    private async Task ToggleAssessmentDetailAsync(Guid assessmentId)
    {
        if (_expandedAssessmentId == assessmentId)
        {
            _expandedAssessmentId = null;
            _expandedAssessmentDetail = null;
            return;
        }

        _loadingAssessmentDetailId = assessmentId;
        _assessmentError = null;
        var response = await MentalHealthService.GetAssessmentByIdAsync(ClinicId, assessmentId);
        _loadingAssessmentDetailId = null;

        if (!response.IsSuccess || response.Data is null)
        {
            _assessmentError = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadAssessment");
            return;
        }

        _expandedAssessmentId = assessmentId;
        _expandedAssessmentDetail = response.Data;
    }

