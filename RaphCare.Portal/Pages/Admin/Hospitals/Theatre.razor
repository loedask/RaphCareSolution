@page "/admin/hospitals/{ClinicId:guid}/theatre"
@layout AdminLayout
@using RaphCare.Domain.Common
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("Theatre_PageTitle")</PageTitle>

<section class="admin-page hospital-deck">
    @if (_loading && _board is null)
    {
        <HospitalDeckLoading Message="@AppResources.T("Theatre_Loading")" />
    }
    else
    {
        <HospitalDeckMasthead BackHref="@($"/admin/hospitals/{ClinicId}")"
                              BackText="@AppResources.T("Common_BackToHospital")"
                              Monogram="@HospitalDeckInitials.FromName(_clinicName)"
                              Eyebrow="@AppResources.T("Theatre_Title")"
                              Title="@_clinicName"
                              Lead="@AppResources.Format("Theatre_Lead", _clinicName)"
                              StatusText="@FormatStatusLine()">
            <HospitalDeckChip Label="@AppResources.T("Theatre_Scheduled")" Value="@ScheduledCount.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Theatre_InProgress")" Value="@InProgressCount.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Theatre_Completed")" Value="@CompletedCount.ToString()" />
        </HospitalDeckMasthead>

        <AdminAlert Message="@_error" />
        <AdminAlert Tone="success" Message="@_success" />

        <div class="hospital-deck-workspace">
        <HospitalDeckRail AriaLabel="@AppResources.T("Theatre_SectionsAria")"
                          Kicker="@AppResources.T("Theatre_Title")">
            <HospitalDeckRailItem Index="01" Icon="calendar" IsActive="@(_tab == "list")" Count="@(_board?.Cases.Count)" OnSelect='() => SetTab("list")'>
                @AppResources.T("Theatre_TodaysList")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="02" Icon="admit" IsActive="@(_tab == "add")" OnSelect='() => SetTab("add")'>
                @AppResources.T("Theatre_AddCase")
            </HospitalDeckRailItem>
        </HospitalDeckRail>

        <div class="hospital-deck-stage">
        @if (_tab == "list")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Theatre_Eyebrow")" Title="@AppResources.T("Theatre_TodaysList")">
                <div class="admin-page-card-body">
                    @if (_board is null || _board.Cases.Count == 0)
                    {
                        <p class="text-muted">@AppResources.T("Theatre_NoCases")</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@AppResources.T("Theatre_ScheduledStart")</th>
                                        <th>@AppResources.T("Common_Patient")</th>
                                        <th>@AppResources.T("Theatre_Procedure")</th>
                                        <th>@AppResources.T("Theatre_TheatreName")</th>
                                        <th>@AppResources.T("Theatre_Surgeon")</th>
                                        <th>@AppResources.T("Common_Status")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var theatreCase in _board.Cases)
                                    {
                                        <tr>
                                            <td>@FormatLocal(theatreCase.ScheduledStart)</td>
                                            <td>
                                                <HospitalDirectoryPerson Name="@theatreCase.PatientName"
                                                                         Href="@($"/admin/hospitals/{ClinicId}/patients/{theatreCase.PatientId}")" />
                                            </td>
                                            <td>@theatreCase.ProcedureName</td>
                                            <td>@(string.IsNullOrWhiteSpace(theatreCase.TheatreName) ? AppResources.T("Common_EmptyCell") : theatreCase.TheatreName)</td>
                                            <td>@(string.IsNullOrWhiteSpace(theatreCase.SurgeonName) ? AppResources.T("Common_EmptyCell") : theatreCase.SurgeonName)</td>
                                            <td>@FormatCaseStatus(theatreCase.Status)</td>
                                            <td>
                                                @if (string.Equals(theatreCase.Status, "Scheduled", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button" class="btn btn-secondary" disabled="@(_savingId == theatreCase.Id)" @onclick="() => StartCaseAsync(theatreCase.Id)">
                                                        @AppResources.T("Theatre_Start")
                                                    </button>
                                                }
                                                @if (string.Equals(theatreCase.Status, "Scheduled", StringComparison.OrdinalIgnoreCase)
                                                     || string.Equals(theatreCase.Status, "InProgress", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button" class="btn btn-primary" disabled="@(_savingId == theatreCase.Id)" @onclick="() => CompleteCaseAsync(theatreCase.Id)">
                                                        @AppResources.T("Theatre_Complete")
                                                    </button>
                                                    <button type="button" class="btn btn-ghost" disabled="@(_savingId == theatreCase.Id)" @onclick="() => CancelCaseAsync(theatreCase.Id)">
                                                        @AppResources.T("Theatre_Cancel")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </AdminPageCard>
        }
        else if (_tab == "add")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Theatre_Eyebrow")" Title="@AppResources.T("Theatre_AddCase")">
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            @AppResources.T("Inpatient_FindPatientLabel")
                            <div class="inpatient-search-row">
                                <input class="form-control" @bind="_patientSearch" @bind:event="oninput" placeholder="@AppResources.T("Inpatient_NameOrPhonePlaceholder")" />
                                <button type="button" class="btn btn-secondary" disabled="@_searchingPatients" @onclick="SearchPatientsAsync">
                                    @(_searchingPatients ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_Search"))
                                </button>
                            </div>
                        </label>
                        <label>
                            @AppResources.T("Common_Patient")
                            <SearchableSelect TValue="string"
                                              @bind-Value="_selectedPatientId"
                                              Placeholder="@AppResources.T("Theatre_SelectPatient")"
                                              Options="PatientOptions" />
                        </label>
                        <label>
                            @AppResources.T("Theatre_Procedure")
                            <input class="form-control" @bind="_procedureName" placeholder="@AppResources.T("Theatre_ProcedurePlaceholder")" />
                        </label>
                        <label>
                            @AppResources.T("Theatre_TheatreName")
                            <input class="form-control" @bind="_theatreName" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                        <label>
                            @AppResources.T("Theatre_Surgeon")
                            <input class="form-control" @bind="_surgeonName" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                        <label>
                            @AppResources.T("Theatre_ScheduledStart")
                            <input class="form-control" type="datetime-local" @bind="_scheduledStart" @bind:format="yyyy-MM-ddTHH:mm" />
                        </label>
                        <label>
                            @AppResources.T("Common_Notes")
                            <input class="form-control" @bind="_notes" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="CreateCaseAsync">
                            @AppResources.T("Theatre_SubmitCase")
                        </button>
                    </div>
                </div>
            </AdminPageCard>
        }
        </div>
        </div>

        <div class="hospital-deck-foot">
            <HospitalDeckBackLink Href="@($"/admin/hospitals/{ClinicId}")" Text="@AppResources.T("Common_BackToHospital")" />
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _busy;
    private bool _searchingPatients;
    private string _tab = "list";
    private Guid? _savingId;
    private string? _error;
    private string? _success;
    private string _clinicName = AppResources.T("Common_ThisHospital");
    private string _clinicTimeZone = "UTC";
    private string _patientSearch = string.Empty;
    private string _selectedPatientId = string.Empty;
    private string _procedureName = string.Empty;
    private string _theatreName = string.Empty;
    private string _surgeonName = string.Empty;
    private string _notes = string.Empty;
    private DateTime _scheduledStart;
    private ClinicTheatreBoard? _board;
    private IReadOnlyList<ClinicPatientListItem> _patients = Array.Empty<ClinicPatientListItem>();

    private int ScheduledCount => _board?.ScheduledCount ?? 0;
    private int InProgressCount => _board?.InProgressCount ?? 0;
    private int CompletedCount => _board?.CompletedCount ?? 0;

    private IReadOnlyList<SelectOption<string>> PatientOptions =>
        _patients.Select(p => new SelectOption<string>(p.PatientId.ToString(), $"{p.FirstName} {p.LastName}")).ToArray();

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        ResetScheduleDefault();
        await LoadBoardAsync();
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private void SetTab(string tab) => _tab = tab;

    private void ResetScheduleDefault()
    {
        var localNow = ClinicTimeZoneHelper.ToClinicLocal(DateTime.UtcNow, _clinicTimeZone);
        _scheduledStart = localNow.Date.AddHours(8);
    }

    private string FormatStatusLine() =>
        AppResources.Format("Theatre_DaySummary", ScheduledCount, InProgressCount, CompletedCount);

    private string FormatLocal(DateTime utc) =>
        ClinicTimeZoneHelper.FormatClinicLocal(utc, _clinicTimeZone);

    private DateTime ToUtc(DateTime clinicLocal) =>
        ClinicTimeZoneHelper.ToUtcFromClinicLocal(clinicLocal, _clinicTimeZone);

    private static string FormatCaseStatus(string? status) =>
        status switch
        {
            "Scheduled" => AppResources.T("Theatre_Scheduled"),
            "InProgress" => AppResources.T("Theatre_InProgress"),
            "Completed" => AppResources.T("Theatre_Completed"),
            "Cancelled" => AppResources.T("Common_Cancelled"),
            _ => string.IsNullOrWhiteSpace(status) ? AppResources.T("Common_EmptyCell") : status
        };

    private async Task LoadBoardAsync()
    {
        _busy = true;
        if (_board is null)
            _loading = true;
        _error = null;
        var dayUtc = DateTime.UtcNow.Date;
        var response = await AdminClinicService.GetTheatreBoardAsync(ClinicId, dayUtc);
        _busy = false;
        _loading = false;
        if (response.IsSuccess && response.Data is not null)
            _board = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("Theatre_CouldNotLoad");
    }

    private async Task SearchPatientsAsync()
    {
        _searchingPatients = true;
        var patients = await AdminClinicService.GetPatientsAsync(
            ClinicId, 1, 50, string.IsNullOrWhiteSpace(_patientSearch) ? null : _patientSearch.Trim());
        _searchingPatients = false;

        if (patients.IsSuccess && patients.Data is not null)
            _patients = patients.Data.Items;
        else
            _error = patients.ErrorMessage ?? AppResources.T("Common_CouldNotLoadPatients");
    }

    private async Task CreateCaseAsync()
    {
        _error = null;
        _success = null;
        if (!Guid.TryParse(_selectedPatientId, out var patientId) || patientId == Guid.Empty)
        {
            _error = AppResources.T("Theatre_PatientRequired");
            return;
        }

        if (string.IsNullOrWhiteSpace(_procedureName))
        {
            _error = AppResources.T("Theatre_ProcedureRequired");
            return;
        }

        _busy = true;
        var response = await AdminClinicService.CreateTheatreCaseAsync(ClinicId, new CreateTheatreCaseRequest
        {
            PatientId = patientId,
            ScheduledStart = ToUtc(_scheduledStart),
            ProcedureName = _procedureName.Trim(),
            TheatreName = string.IsNullOrWhiteSpace(_theatreName) ? null : _theatreName.Trim(),
            SurgeonName = string.IsNullOrWhiteSpace(_surgeonName) ? null : _surgeonName.Trim(),
            Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()
        });
        _busy = false;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Theatre_CouldNotCreate");
            return;
        }

        _success = AppResources.T("Theatre_Created");
        _selectedPatientId = string.Empty;
        _procedureName = string.Empty;
        _theatreName = string.Empty;
        _surgeonName = string.Empty;
        _notes = string.Empty;
        ResetScheduleDefault();
        _tab = "list";
        await LoadBoardAsync();
    }

    private Task StartCaseAsync(Guid caseId) => UpdateStatusAsync(caseId, "InProgress");

    private Task CompleteCaseAsync(Guid caseId) => UpdateStatusAsync(caseId, "Completed");

    private Task CancelCaseAsync(Guid caseId) => UpdateStatusAsync(caseId, "Cancelled");

    private async Task UpdateStatusAsync(Guid caseId, string status)
    {
        _savingId = caseId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.UpdateTheatreCaseStatusAsync(ClinicId, caseId, status);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Theatre_CouldNotUpdate");
            return;
        }

        _success = AppResources.T("Theatre_StatusUpdated");
        await LoadBoardAsync();
    }
}
