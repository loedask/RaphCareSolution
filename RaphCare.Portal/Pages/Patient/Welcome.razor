@page "/patient/welcome"

<PageTitle>@AppResources.T("PatientWelcome_PageTitle")</PageTitle>

<section class="auth-page">
    <h1>@AppResources.T("PatientWelcome_Title")</h1>
    <p class="text-muted">@AppResources.T("PatientWelcome_Lead")</p>
    <div class="auth-actions">
        <a class="btn btn-primary" href="/">@AppResources.T("Common_BackToHome")</a>
        <button type="button" class="btn btn-secondary" @onclick="SignOutAsync">@AppResources.T("Common_SignOut")</button>
    </div>
</section>

@code {
    [Inject] private IWebAuthService WebAuth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var token = await WebAuth.GetTokenAsync();
        var kind = await WebAuth.GetAccountKindAsync();
        if (string.IsNullOrWhiteSpace(token) || kind != WebAccountKind.Patient)
            Navigation.NavigateTo("/patient/signin", replace: true);
    }

    private async Task SignOutAsync()
    {
        await WebAuth.SignOutAsync();
        Navigation.NavigateTo("/", replace: true);
    }
}
