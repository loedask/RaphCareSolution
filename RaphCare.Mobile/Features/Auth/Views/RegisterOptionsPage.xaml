<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RaphCare.Mobile.Features.Auth.Views"
             x:Class="RaphCare.Mobile.Features.Auth.Views.RegisterOptionsPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AuthBackgroundGradient}">

    <ScrollView>
        <VerticalStackLayout Padding="32" VerticalOptions="Center" Spacing="24">
            <Label Text="Create Account" Style="{StaticResource AuthTitleLabel}" />
            <Label Text="Choose how you'd like to sign up." Style="{StaticResource AuthSubtitleLabel}" />

            <Button Text="Continue with Email"
                    Style="{StaticResource AuthPrimaryButton}"
                    Command="{Binding CreateWithEmailCommand}"
                    Margin="0,32,0,0" />

            <Button Text="Back"
                    Style="{StaticResource AuthSecondaryButton}"
                    Command="{Binding BackCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
