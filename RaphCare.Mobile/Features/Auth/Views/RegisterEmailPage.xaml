<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Shared.Components"
             x:Class="RaphCare.Mobile.Features.Auth.Views.RegisterEmailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <HorizontalStackLayout Margin="0,48,0,24" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}" Text="←" FontSize="20" Command="{Binding BackCommand}" />
            </HorizontalStackLayout>

            <Label Text="Create with Email" Style="{StaticResource TitleLarge}" Margin="0,0,0,4" />
            <Label Text="Fill in your details to get started."
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   Margin="0,0,0,32" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <shared:InputField Grid.Column="0" LabelText="First name" Placeholder="John" Text="{Binding FirstName}" />
                <shared:InputField Grid.Column="1" LabelText="Last name" Placeholder="Doe" Text="{Binding LastName}" />
            </Grid>
            <shared:InputField LabelText="Email address" Placeholder="john@example.com" Keyboard="Email" Text="{Binding Email}" />
            <shared:InputField LabelText="Password" Placeholder="Min 8 characters" IsPassword="True" Text="{Binding Password}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="12" Margin="0,-8,0,0" />

            <shared:GradientButton Text="Continue"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,32,0,0" />

            <HorizontalStackLayout Margin="0,24,0,0" HorizontalOptions="Center" Spacing="4">
                <Label Text="Already have an account?" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />
                <Button Text="Sign in" Style="{StaticResource TextButton}" Padding="0" Command="{Binding SignInCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
