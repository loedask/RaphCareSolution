<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RaphCare.Mobile.Features.Auth.Views"
             x:Class="RaphCare.Mobile.Features.Auth.Views.LandingPage"
             x:Name="LandingPageRoot"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AuthBackgroundGradient}">

    <ScrollView>
        <VerticalStackLayout Padding="32" VerticalOptions="Center" Spacing="24">
            <Label Text="RaphCare" Style="{StaticResource AuthTitleLabel}" FontSize="36" />
            <Label Text="Your health, simplified." Style="{StaticResource AuthSubtitleLabel}" />

            <Button Text="Create Account"
                    Style="{StaticResource AuthPrimaryButton}"
                    Command="{Binding CreateAccountCommand}"
                    Margin="0,32,0,0" />

            <Button Text="Sign In"
                    Style="{StaticResource AuthSecondaryButton}"
                    Command="{Binding SignInCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
