<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RaphCare.Mobile.Features.Auth.Views"
             x:Class="RaphCare.Mobile.Features.Auth.Views.LandingPage"
             x:Name="LandingPageRoot"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AuthBackgroundGradient}">

    <ScrollView>
        <VerticalStackLayout Padding="24" VerticalOptions="Center" Spacing="12">
            <Label Text="RaphCare" Style="{StaticResource AuthTitleLabel}" FontSize="36" Margin="0,0,0,32" />
            <Label Text="Your health, simplified." Style="{StaticResource AuthSubtitleLabel}" Margin="0,0,0,48" />

            <Button Text="Sign In"
                    Style="{StaticResource AuthPrimaryButton}"
                    Command="{Binding SignInCommand}"
                    Margin="0,0,0,12" />

            <Button Text="Create Account"
                    Style="{StaticResource AuthSecondaryButton}"
                    Command="{Binding CreateAccountCommand}" />

            <Label Text="Healthcare without barriers."
                   Style="{StaticResource Micro}"
                   TextColor="{StaticResource TealGlowColor}"
                   HorizontalOptions="Center"
                   Margin="0,32,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
