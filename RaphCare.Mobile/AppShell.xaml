<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:auth="clr-namespace:RaphCare.Mobile.Core.Features.Auth.Views"
       xmlns:home="clr-namespace:RaphCare.Mobile.Core.Features.Home.Views"
       xmlns:appointments="clr-namespace:RaphCare.Mobile.Core.Features.Appointments.Views"
       xmlns:records="clr-namespace:RaphCare.Mobile.Core.Features.Records.Views"
       xmlns:insurance="clr-namespace:RaphCare.Mobile.Core.Features.Insurance.Views"
       xmlns:settings="clr-namespace:RaphCare.Mobile.Core.Features.Settings.Views"
       x:Class="RaphCare.Mobile.AppShell"
       x:Name="AppShellRoot"
       FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="{StaticResource CardColor}"
       Shell.TabBarTitleColor="{StaticResource PrimaryColor}"
       Shell.TabBarUnselectedColor="{StaticResource MutedForegroundColor}">

    <!-- Auth entry (no tab bar) -->
    <FlyoutItem Route="AuthRoot" FlyoutDisplayOptions="AsSingleItem">
        <ShellContent Route="LandingPage"
                      ContentTemplate="{DataTemplate auth:LandingPage}" />
    </FlyoutItem>

    <!-- Main app tabs (concept BottomNav: Home, Appointments, Records, Insurance, Profile) -->
    <TabBar Route="MainTabs">
        <ShellContent Route="HomePage"
                      Title="Home"
                      Icon="tab_home.svg"
                      ContentTemplate="{DataTemplate home:HomePage}" />
        <ShellContent Route="AppointmentsPage"
                      Title="Appointments"
                      Icon="tab_appointments.svg"
                      ContentTemplate="{DataTemplate appointments:AppointmentsPage}" />
        <ShellContent Route="RecordsPage"
                      Title="Records"
                      Icon="tab_records.svg"
                      ContentTemplate="{DataTemplate records:RecordsPage}" />
        <ShellContent Route="InsurancePage"
                      Title="Insurance"
                      Icon="tab_insurance.svg"
                      ContentTemplate="{DataTemplate insurance:InsurancePage}" />
        <ShellContent Route="SettingsPage"
                      Title="Profile"
                      Icon="tab_profile.svg"
                      ContentTemplate="{DataTemplate settings:SettingsPage}" />
    </TabBar>
</Shell>
