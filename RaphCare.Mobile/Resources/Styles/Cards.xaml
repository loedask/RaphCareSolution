<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Card border (use StrokeShape in view: RoundRectangle CornerRadius="12") -->
    <Style TargetType="Border" x:Key="CardBorder">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Gradient brush for hero / auth background -->
    <LinearGradientBrush x:Key="AuthBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource GradientMidColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource GradientEndColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Auth label styles (for auth pages) -->
    <Style TargetType="Label" x:Key="AuthTitleLabel">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Label" x:Key="AuthSubtitleLabel">
        <Setter Property="TextColor" Value="#E0D0F0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="24,0,24,24" />
    </Style>
</ResourceDictionary>
