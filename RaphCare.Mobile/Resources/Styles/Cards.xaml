<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Prototype radius 0.875rem. rounded-2xl 16, card-premium shadow-card -->
    <!-- Register method cards: p-5 rounded-2xl shadow-soft border border-border -->
    <Style TargetType="Border" x:Key="CardBorder">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- gradient-teal: teal -> accent (primary CTA buttons + accent icon wells) -->
    <LinearGradientBrush x:Key="GradientTealBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource TealColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Soft teal wash behind line icons (Home metrics, Profile rows, Settings). -->
    <LinearGradientBrush x:Key="AppIconWellSoftBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource IconWellSoftStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource IconWellSoftEndColor}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Border" x:Key="ProfileMenuIconBorder">
        <Setter Property="Background" Value="{StaticResource AppIconWellSoftBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#1B9BBB" Opacity="0.16" Radius="8" Offset="0,2" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="AppIconWellAccent">
        <Setter Property="Background" Value="{StaticResource GradientTealBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#1B9BBB" Opacity="0.28" Radius="10" Offset="0,3" />
        </Setter>
    </Style>

    <Style TargetType="Image" x:Key="AppIconImage">
        <Setter Property="WidthRequest" Value="20" />
        <Setter Property="HeightRequest" Value="20" />
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="CardPremium">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- gradient-brand: navy -> navy-light -> teal (Welcome screen) -->
    <LinearGradientBrush x:Key="AuthBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource GradientMidColor}" Offset="0.5" />
        <GradientStop Color="{StaticResource GradientEndColor}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Label" x:Key="AuthTitleLabel">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Label" x:Key="AuthSubtitleLabel">
        <Setter Property="TextColor" Value="{StaticResource TealGlowColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="24,0,24,24" />
    </Style>
</ResourceDictionary>
