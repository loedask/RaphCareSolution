<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Premium soft cards: larger radius, softer depth, more padding. -->
    <Style TargetType="Border" x:Key="CardBorder">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.07" Radius="16" Offset="0,6" />
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="GradientTealBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource TealColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AppIconWellSoftBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource IconWellSoftStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource IconWellSoftEndColor}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Border" x:Key="ProfileMenuIconBorder">
        <Setter Property="Background" Value="{StaticResource GradientTealBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="14" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#1B9BBB" Opacity="0.26" Radius="12" Offset="0,4" />
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="AppIconWellAccent">
        <Setter Property="Background" Value="{StaticResource GradientTealBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="14" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#1B9BBB" Opacity="0.26" Radius="12" Offset="0,4" />
        </Setter>
    </Style>

    <Style TargetType="Image" x:Key="AppIconImage">
        <Setter Property="WidthRequest" Value="20" />
        <Setter Property="HeightRequest" Value="20" />
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="CardPremium">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.08" Radius="18" Offset="0,8" />
        </Setter>
    </Style>

    <LinearGradientBrush x:Key="AuthBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource GradientStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource GradientMidColor}" Offset="0.48" />
        <GradientStop Color="{StaticResource GradientEndColor}" Offset="1" />
    </LinearGradientBrush>

    <Style TargetType="Label" x:Key="AuthTitleLabel">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="Label" x:Key="AuthSubtitleLabel">
        <Setter Property="TextColor" Value="{StaticResource TealGlowColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="28,0,28,28" />
    </Style>
</ResourceDictionary>
