<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Premium soft buttons: taller tap targets, softer corners, gentle primary glow. -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryForegroundColor}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24,16" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Shadow">
            <Shadow Brush="#1B9BBB" Opacity="0.22" Radius="14" Offset="0,4" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="Shadow">
            <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="OutlineTealButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TealGlowColor}" />
        <Setter Property="BorderColor" Value="{StaticResource TealGlowColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="Shadow">
            <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="TextButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Shadow">
            <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="AuthPrimaryButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="TextColor" Value="{StaticResource NavyColor}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24,16" />
        <Setter Property="Shadow">
            <Shadow Brush="Black" Opacity="0.14" Radius="16" Offset="0,6" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="AuthSecondaryButton" BasedOn="{StaticResource AuthPrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TealGlowColor}" />
        <Setter Property="BorderColor" Value="{StaticResource TealGlowColor}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="Shadow">
            <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="IconBackButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource ForegroundColor}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="Shadow">
            <Shadow Brush="Transparent" Opacity="0" Radius="0" Offset="0,0" />
        </Setter>
    </Style>
</ResourceDictionary>
