<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Premium soft identity (MAUI): calm wash, teal/navy brand. Intentionally beyond the React concept. -->
    <Color x:Key="BackgroundColor">#F3F6F9</Color>
    <Color x:Key="ForegroundColor">#121A2A</Color>

    <!-- primary / primary-foreground -->
    <Color x:Key="PrimaryColor">#1B9BBB</Color>
    <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
    <Color x:Key="PrimaryDarkColor">#157F97</Color>
    <Color x:Key="PrimaryLightColor">#4AD0D0</Color>

    <!-- secondary -->
    <Color x:Key="SecondaryColor">#EEF3F7</Color>
    <Color x:Key="SecondaryForegroundColor">#1E2A3E</Color>

    <!-- card / popover / surface -->
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="CardForegroundColor">#121A2A</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PopoverColor">#FFFFFF</Color>
    <Color x:Key="PopoverForegroundColor">#121A2A</Color>

    <!-- muted -->
    <Color x:Key="MutedColor">#E8EEF2</Color>
    <Color x:Key="MutedForegroundColor">#6B7789</Color>

    <!-- accent -->
    <Color x:Key="AccentColor">#2FB39A</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>

    <!-- destructive -->
    <Color x:Key="DestructiveColor">#DB4343</Color>
    <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>
    <Color x:Key="ErrorColor">#DB4343</Color>

    <!-- border / input / ring -->
    <Color x:Key="BorderColor">#E2E8EE</Color>
    <Color x:Key="InputColor">#E8EEF2</Color>
    <Color x:Key="RingColor">#1B9BBB</Color>

    <!-- RaphCare navy and teal -->
    <Color x:Key="NavyColor">#0F1728</Color>
    <Color x:Key="NavyLightColor">#1F2E48</Color>
    <Color x:Key="TealColor">#1B9BBB</Color>
    <Color x:Key="TealLightColor">#4AD0D0</Color>
    <Color x:Key="TealGlowColor">#8AE8E4</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#121A2A</Color>
    <Color x:Key="TextSecondaryColor">#6B7789</Color>
    <Color x:Key="TextMutedColor">#8A95A6</Color>

    <!-- Semantic health status -->
    <Color x:Key="SuccessColor">#37BE7F</Color>
    <Color x:Key="WarningColor">#F6A823</Color>
    <Color x:Key="HealthNormalColor">#37BE7F</Color>
    <Color x:Key="HealthAttentionColor">#F6A823</Color>
    <Color x:Key="HealthCriticalColor">#DB4343</Color>

    <!-- calm (mental health + notification wash) -->
    <Color x:Key="CalmColor">#F0F3F7</Color>
    <Color x:Key="CalmAccentColor">#7B6EB9</Color>
    <Color x:Key="CalmSoftColor">#EBE7F3</Color>

    <!-- Soft washes behind line icons -->
    <Color x:Key="IconWellSoftStartColor">#D5F5F1</Color>
    <Color x:Key="IconWellSoftEndColor">#C0EBE3</Color>
    <Color x:Key="IconWellRoseColor">#FFE4E8</Color>
    <Color x:Key="IconWellSkyColor">#E3EEFF</Color>
    <Color x:Key="IconWellMintColor">#DDF7EC</Color>
    <Color x:Key="IconWellVioletColor">#EDE8F8</Color>
    <Color x:Key="IconWellAmberColor">#FFF3D6</Color>

    <!-- Sidebar (future Shell / flyout) -->
    <Color x:Key="SidebarBackgroundColor">#F7F8FA</Color>
    <Color x:Key="SidebarForegroundColor">#3F3F46</Color>
    <Color x:Key="SidebarPrimaryColor">#18181B</Color>
    <Color x:Key="SidebarPrimaryForegroundColor">#FAFAFA</Color>
    <Color x:Key="SidebarAccentColor">#F4F4F5</Color>
    <Color x:Key="SidebarAccentForegroundColor">#18181B</Color>
    <Color x:Key="SidebarBorderColor">#E5E7EB</Color>
    <Color x:Key="SidebarRingColor">#1B9BBB</Color>

    <!-- Brand gradients -->
    <Color x:Key="GradientStartColor">#0F1728</Color>
    <Color x:Key="GradientMidColor">#1F2E48</Color>
    <Color x:Key="GradientEndColor">#1B9BBB</Color>
    <Color x:Key="GradientCardStartColor">#FFFFFF</Color>
    <Color x:Key="GradientCardEndColor">#F3F6F9</Color>
</ResourceDictionary>
