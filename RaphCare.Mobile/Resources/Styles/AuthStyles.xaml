<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Gradient background for auth screens -->
    <LinearGradientBrush x:Key="AuthBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#512BD4" Offset="0" />
        <GradientStop Color="#7B2CBF" Offset="0.5" />
        <GradientStop Color="#240046" Offset="1" />
    </LinearGradientBrush>

    <!-- Primary button style -->
    <Style TargetType="Button" x:Key="AuthPrimaryButton">
        <Setter Property="BackgroundColor" Value="#512BD4" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Secondary / outline button -->
    <Style TargetType="Button" x:Key="AuthSecondaryButton" BasedOn="{StaticResource AuthPrimaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="BorderColor" Value="White" />
        <Setter Property="BorderWidth" Value="2" />
    </Style>

    <!-- Auth label (title) -->
    <Style TargetType="Label" x:Key="AuthTitleLabel">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="Label" x:Key="AuthSubtitleLabel">
        <Setter Property="TextColor" Value="#E0D0F0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="Margin" Value="24,0,24,24" />
    </Style>

    <!-- Entry styling for auth forms -->
    <Style TargetType="Entry" x:Key="AuthEntry">
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
        <Setter Property="TextColor" Value="#1a1a1a" />
        <Setter Property="PlaceholderColor" Value="#888" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
</ResourceDictionary>
