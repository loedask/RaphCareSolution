<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Premium soft type: Space Grotesk display, DM Sans body (registered in MauiProgram). -->
    <Style TargetType="Label" x:Key="TitleLarge">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="Label" x:Key="TitleMedium">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.3" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="Label" x:Key="TitleSmall">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Label" x:Key="SectionTitle">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="Label" x:Key="BodyLarge">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.45" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Label" x:Key="BodyMedium">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.4" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Label" x:Key="BodySmall">
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryColor}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Label" x:Key="Caption">
        <Setter Property="TextColor" Value="{StaticResource TextMutedColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.35" />
    </Style>

    <Style TargetType="Label" x:Key="Micro">
        <Setter Property="TextColor" Value="{StaticResource TextMutedColor}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</ResourceDictionary>
