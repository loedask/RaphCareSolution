<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Premium soft inputs: soft fill, taller field, calm placeholder. -->
    <Style TargetType="Entry" x:Key="DefaultEntry">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedForegroundColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style TargetType="Entry" x:Key="AuthEntry" BasedOn="{StaticResource DefaultEntry}">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Entry" x:Key="PremiumEntry" BasedOn="{StaticResource DefaultEntry}">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style TargetType="Editor" x:Key="DefaultEditor">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedForegroundColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="112" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
</ResourceDictionary>
