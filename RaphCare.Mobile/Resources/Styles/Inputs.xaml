<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Entry -->
    <Style TargetType="Entry" x:Key="DefaultEntry">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="Entry" x:Key="AuthEntry" BasedOn="{StaticResource DefaultEntry}">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="PlaceholderColor" Value="#888" />
    </Style>

    <!-- Editor (multiline) -->
    <Style TargetType="Editor" x:Key="DefaultEditor">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMutedColor}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="100" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
</ResourceDictionary>
