<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RaphCare.Mobile"
             xmlns:converters="clr-namespace:RaphCare.Mobile.Core.Converters"
             x:Class="RaphCare.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:LanguageRowHighlightConverter x:Key="LanguageRowHighlightConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Typography.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/Inputs.xaml" />
                <ResourceDictionary Source="Resources/Styles/Cards.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Default body face (display styles in Typography.xaml set SpaceGrotesk). -->
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="DMSans" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="DMSans" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontFamily" Value="DMSans" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="FontFamily" Value="DMSans" />
            </Style>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
