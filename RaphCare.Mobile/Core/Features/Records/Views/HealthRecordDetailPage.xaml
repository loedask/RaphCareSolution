<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.Records.Models"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Records.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Records.Views.HealthRecordDetailPage"
             x:DataType="vm:HealthRecordDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Style="{StaticResource BodyMedium}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding WhenLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                <Label Text="{Binding WhenText}" Style="{StaticResource TitleMedium}" />

                <Label Text="{Binding StatusLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding StatusText}" Style="{StaticResource BodyMedium}" />

                <Label Text="{Binding TypeLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding VisitTypeText}" Style="{StaticResource BodyMedium}" />

                <Label Text="{Binding SummaryLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding SummaryText}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />

                <Label Text="{Binding VitalsSectionTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,16,0,0" />
                <CollectionView ItemsSource="{Binding VitalSigns}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VitalSignDisplayItem">
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding MainLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding RecordedLine}"
                                           Style="{StaticResource BodySmall}"
                                           TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding PrescriptionsSectionTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,16,0,0" />
                <CollectionView ItemsSource="{Binding Prescriptions}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CollectionOrderDisplayItem">
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding KindLabel}" Style="{StaticResource BodySmall}" />
                                    <Label Text="{Binding PickupCode}"
                                           Style="{StaticResource TitleMedium}"
                                           CharacterSpacing="4"
                                           Margin="0" />
                                    <Label Text="{Binding DetailLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding StatusText}"
                                           Style="{StaticResource BodySmall}"
                                           TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding LabsSectionTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,16,0,0" />
                <CollectionView ItemsSource="{Binding LabOrders}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CollectionOrderDisplayItem">
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding KindLabel}" Style="{StaticResource BodySmall}" />
                                    <Label Text="{Binding PickupCode}"
                                           Style="{StaticResource TitleMedium}"
                                           CharacterSpacing="4"
                                           Margin="0" />
                                    <Label Text="{Binding DetailLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding StatusText}"
                                           Style="{StaticResource BodySmall}"
                                           TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button Text="← Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
