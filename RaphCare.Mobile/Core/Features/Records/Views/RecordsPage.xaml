<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.Records.Models"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Records.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Records.Views.RecordsPage"
             x:DataType="vm:RecordsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">
        <Button Grid.Row="0"
                Text="{Binding RefreshButtonText}"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding RefreshCommand}"
                HorizontalOptions="Start" />

        <VerticalStackLayout Grid.Row="1"
                             Spacing="8"
                             IsVisible="{Binding ShowPickup}">
            <Label Text="{Binding PickupSectionTitle}" Style="{StaticResource SectionTitle}" />
            <Label Text="{Binding PickupHint}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource MutedForegroundColor}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PickupItems}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CollectionOrderDisplayItem">
                        <Grid>
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" InputTransparent="True">
                                    <Label Text="{Binding KindLabel}" Style="{StaticResource BodySmall}" />
                                    <Label Text="{Binding PickupCode}"
                                           Style="{StaticResource TitleLarge}"
                                           CharacterSpacing="4"
                                           HorizontalTextAlignment="Center"
                                           Margin="0" />
                                    <Label Text="{Binding DetailLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding ClinicName}"
                                           Style="{StaticResource BodySmall}"
                                           TextColor="{StaticResource MutedForegroundColor}" />
                                    <Label Text="{Binding StatusText}"
                                           Style="{StaticResource BodySmall}"
                                           TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>
                            <Button BackgroundColor="Transparent"
                                    Opacity="0.02"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                    CommandParameter="{Binding VisitId}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" Color="{StaticResource PrimaryColor}" />

            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:HealthRecordListDisplayItem">
                        <Grid Margin="0,0,0,12">
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" InputTransparent="True">
                                    <Label Text="{Binding PrimaryLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding SecondaryLine}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>
                            <Button BackgroundColor="Transparent"
                                    Opacity="0.02"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                    CommandParameter="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding EmptyStateText}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding ShowEmpty}"
                   InputTransparent="True" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource ErrorColor}"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   InputTransparent="True" />
        </Grid>
    </Grid>
</ContentPage>
