<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.Records.Models"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Records.ViewModels"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Records.Views.RecordsPage"
             x:DataType="vm:RecordsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="12">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding RefreshButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" />
                    <Button Text="{Binding ScanButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ScanPosterCommand}" />
                </HorizontalStackLayout>

                <Button Text="{Binding ClearCheckInButtonText}"
                        IsVisible="{Binding ShowClearCheckIn}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCheckInCommand}"
                        HorizontalOptions="Start" />

                <VerticalStackLayout Spacing="8"
                                     IsVisible="{Binding ShowPickup}">
                    <Label Text="{Binding PickupSectionTitle}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding PickupHint}"
                           Style="{StaticResource BodySmall}"
                           TextColor="{StaticResource MutedForegroundColor}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PickupItems}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CollectionOrderDisplayItem">
                                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                            CommandParameter="{Binding VisitId}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding KindLabel}" Style="{StaticResource BodySmall}" />
                                        <Label Text="{Binding PickupCode}"
                                               Style="{StaticResource TitleLarge}"
                                               CharacterSpacing="4"
                                               HorizontalTextAlignment="Center"
                                               Margin="0" />
                                        <Image Source="{Binding QrImage}"
                                               HeightRequest="140"
                                               WidthRequest="140"
                                               HorizontalOptions="Center"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding DetailLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                        <Label Text="{Binding ClinicName}"
                                               Style="{StaticResource BodySmall}"
                                               TextColor="{StaticResource MutedForegroundColor}" />
                                        <Label Text="{Binding StatusText}"
                                               Style="{StaticResource BodySmall}"
                                               TextColor="{StaticResource MutedForegroundColor}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCalled}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:HealthRecordListDisplayItem">
                                <Border Style="{StaticResource CardBorder}"
                                        Padding="16"
                                        Margin="0,0,0,12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                            CommandParameter="{Binding Id}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding PrimaryLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                        <Label Text="{Binding SecondaryLine}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding EmptyStateText}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{StaticResource MutedForegroundColor}"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding ShowEmpty}" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource BodyMedium}"
                       TextColor="{StaticResource ErrorColor}"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            </VerticalStackLayout>
        </ScrollView>

        <shared:BusyOverlay IsBusy="{Binding IsBusy}" Message="{Binding BusyMessage}" />
    </Grid>
</ContentPage>
