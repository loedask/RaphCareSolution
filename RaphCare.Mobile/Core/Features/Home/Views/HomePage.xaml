<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RaphCare.Mobile.Core.Features.Home.Views.HomePage"
             Title="Home"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" VerticalOptions="Center" Spacing="16">
            <Label x:Name="WelcomeLabel" Style="{StaticResource TitleLarge}" />
            <Label x:Name="SignedInLabel" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />
            <Button x:Name="OpenBlazorButton"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnOpenBlazorClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
