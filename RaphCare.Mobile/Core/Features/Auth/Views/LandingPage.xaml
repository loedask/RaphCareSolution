<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Auth.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.LandingPage"
             x:Name="LandingRoot"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Background="{StaticResource AuthBackgroundGradient}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28,64,28,40" Spacing="0">
                <Grid HeightRequest="12" />

                <!-- Branding: replace Resources/Images/raphcare_logo.png with your production asset (same key). -->
                <Border BackgroundColor="{StaticResource CardColor}"
                        StrokeThickness="0"
                        Padding="20,22"
                        Margin="0,0,0,32"
                        HorizontalOptions="Center"
                        MaximumWidthRequest="300">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.18" Radius="24" Offset="0,10" />
                    </Border.Shadow>
                    <Image Source="raphcare_logo.png"
                           Aspect="AspectFit"
                           HeightRequest="112"
                           SemanticProperties.Description="RaphCare logo" />
                </Border>

                <Label Text="{Binding WelcomeTagline}"
                       FontFamily="SpaceGrotesk"
                       TextColor="{StaticResource TealGlowColor}"
                       Opacity="0.92"
                       FontSize="20"
                       LineHeight="1.4"
                       HorizontalTextAlignment="Center"
                       Margin="12,0,12,40" />

                <Button Text="{Binding SignInText}"
                        Style="{StaticResource AuthPrimaryButton}"
                        Command="{Binding SignInCommand}"
                        Margin="0,0,0,14" />

                <Button Text="{Binding CreateAccountText}"
                        Style="{StaticResource AuthSecondaryButton}"
                        Command="{Binding CreateAccountCommand}" />

                <Label Text="{Binding FooterTagline}"
                       Style="{StaticResource Micro}"
                       TextColor="{StaticResource TealGlowColor}"
                       Opacity="0.6"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       Margin="0,40,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Language chip (concept: globe + language name) -->
        <Border Padding="14,10"
                StrokeThickness="1"
                Stroke="#40FFFFFF"
                BackgroundColor="#22FFFFFF"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,32,20,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.12" Radius="10" Offset="0,4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenLanguageSheetCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8">
                <Label Text="&#x1F310;"
                       FontSize="15"
                       VerticalOptions="Center" />
                <Label Text="{Binding CurrentLanguageNative}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TealGlowColor}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Bottom sheet: language list -->
        <Grid IsVisible="{Binding IsLanguageSheetOpen}"
              ZIndex="100"
              VerticalOptions="Fill">
            <Grid RowDefinitions="*,Auto">
                <BoxView Grid.Row="0"
                         Color="#99000000"
                         VerticalOptions="Fill">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseLanguageSheetCommand}" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <Border Grid.Row="1"
                        BackgroundColor="{StaticResource CardColor}"
                        Padding="24,20,24,36">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28,28,0,0" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.12" Radius="20" Offset="0,-4" />
                    </Border.Shadow>
                <VerticalStackLayout Spacing="18">
                    <Label Text="{Binding ChooseLanguageTitle}"
                           FontFamily="SpaceGrotesk"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource ForegroundColor}" />
                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding Languages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption">
                                <Border Padding="16,14"
                                        BackgroundColor="{Binding IsCurrent, Converter={StaticResource LanguageRowHighlightConverter}}"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource BorderColor}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectLanguageCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Native}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource ForegroundColor}" />
                                            <Label Text="{Binding English}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource MutedForegroundColor}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="✓"
                                               FontSize="18"
                                               TextColor="{StaticResource PrimaryColor}"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsCurrent}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
