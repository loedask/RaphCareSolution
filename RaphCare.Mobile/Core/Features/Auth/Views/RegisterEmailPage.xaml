<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:auth="clr-namespace:RaphCare.Mobile.Core.Features.Auth.Models"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.RegisterEmailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="16">
                <HorizontalStackLayout Margin="0,48,0,24" HorizontalOptions="Start">
                    <Button Style="{StaticResource IconBackButton}" Text="←" FontSize="20" Command="{Binding BackCommand}" />
                </HorizontalStackLayout>

                <Label Text="{Binding PageTitle}" Style="{StaticResource TitleLarge}" Margin="0,0,0,4" />
                <Label Text="{Binding Subtitle}"
                       Style="{StaticResource BodyMedium}"
                       TextColor="{StaticResource MutedForegroundColor}"
                       Margin="0,0,0,32" />

                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding AwaitingVerification, Converter={StaticResource InvertedBoolConverter}}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <shared:InputField Grid.Column="0" LabelText="{Binding FirstNameLabel}" Placeholder="{Binding PlaceholderFirst}" Text="{Binding FirstName}" />
                        <shared:InputField Grid.Column="1" LabelText="{Binding LastNameLabel}" Placeholder="{Binding PlaceholderLast}" Text="{Binding LastName}" />
                    </Grid>
                    <shared:InputField LabelText="{Binding EmailLabel}" Placeholder="{Binding PlaceholderEmail}" Keyboard="Email" Text="{Binding Email}" />
                    <shared:InputField LabelText="{Binding PasswordLabel}" Placeholder="{Binding PlaceholderPassword}" IsPassword="True" Text="{Binding Password}" />

                    <Label Text="{Binding ClinicLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                    <Label Text="{Binding ClinicHint}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <shared:InputField Grid.Column="0"
                                           Placeholder="{Binding ClinicSearchPlaceholder}"
                                           Text="{Binding ClinicSearchText}" />
                        <Button Grid.Column="1"
                                Text="{Binding ClinicSearchButtonText}"
                                Style="{StaticResource AuthSecondaryButton}"
                                Command="{Binding SearchClinicsCommand}"
                                VerticalOptions="End"
                                Padding="16,12" />
                    </Grid>
                    <Picker ItemsSource="{Binding Clinics}"
                            ItemDisplayBinding="{Binding DisplayName, x:DataType=auth:ClinicPickerItem}"
                            SelectedItem="{Binding SelectedClinic}"
                            Title="{Binding ClinicLabel}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding AwaitingVerification}">
                    <Label Text="{Binding VerificationCodeLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <shared:InputField Grid.Column="0"
                                           Placeholder="{Binding PlaceholderVerificationCode}"
                                           Keyboard="Numeric"
                                           Text="{Binding VerificationCode}" />
                        <Button Grid.Column="1"
                                Text="{Binding SendCodeButtonText}"
                                Style="{StaticResource AuthSecondaryButton}"
                                Command="{Binding SendCodeCommand}"
                                VerticalOptions="End"
                                Padding="16,12" />
                    </Grid>

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource MutedForegroundColor}"
                           FontSize="12"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           Margin="0,-8,0,0" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="12" Margin="0,-8,0,0" />

                <shared:GradientButton Text="{Binding ContinueText}"
                        Command="{Binding ContinueCommand}"
                        IsBusy="{Binding IsBusy}"
                        Margin="0,32,0,0" />

                <HorizontalStackLayout Margin="0,24,0,0"
                                       HorizontalOptions="Center"
                                       Spacing="4"
                                       IsVisible="{Binding AwaitingVerification, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="{Binding AlreadyHaveText}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />
                    <Button Text="{Binding SignInLinkText}" Style="{StaticResource TextButton}" Padding="0" Command="{Binding SignInCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <shared:BusyOverlay IsBusy="{Binding IsBusy}" Message="{Binding BusyMessage}" />
    </Grid>
</ContentPage>
