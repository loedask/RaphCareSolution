<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Shared.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.RegisterVoiceIntroPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">
            <HorizontalStackLayout Margin="0,0,0,16" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}" Text="←" FontSize="20" Command="{Binding BackCommand}" />
            </HorizontalStackLayout>

            <Border WidthRequest="80" HeightRequest="80" StrokeThickness="0" HorizontalOptions="Center" Margin="0,16,0,24"
                    BackgroundColor="{StaticResource SecondaryColor}">
                <Border.StrokeShape><RoundRectangle CornerRadius="40" /></Border.StrokeShape>
                <Label Text="🎤" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding Title}" Style="{StaticResource TitleLarge}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding IntroBody}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

            <shared:GradientButton Text="{Binding ContinueLabel}"
                                   Command="{Binding ContinueCommand}"
                                   Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
