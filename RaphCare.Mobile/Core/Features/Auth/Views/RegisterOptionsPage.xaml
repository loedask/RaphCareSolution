<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RaphCare.Mobile.Features.Auth.Views.RegisterOptionsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="0">
            <HorizontalStackLayout Margin="0,56,0,24" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}"
                        Command="{Binding BackCommand}"
                        Text="←" FontSize="20" />
            </HorizontalStackLayout>

            <Label Text="Create account" Style="{StaticResource TitleLarge}" Margin="0,0,0,8" />
            <Label Text="Choose how you'd like to sign up."
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   Margin="0,0,0,32" />

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CreateWithEmailCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" Padding="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="✉" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Email" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                        <Label Text="Register with email" Style="{StaticResource BodySmall}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <HorizontalStackLayout Margin="0,32,0,0" HorizontalOptions="Center" Spacing="4">
                <Label Text="Already have an account?" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />
                <Button Text="Sign in" Style="{StaticResource TextButton}" Padding="0" Command="{Binding SignInCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
