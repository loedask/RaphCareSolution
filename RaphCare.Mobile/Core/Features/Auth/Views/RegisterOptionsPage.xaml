<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.RegisterOptionsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="0">
            <HorizontalStackLayout Margin="0,56,0,24" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}"
                        Command="{Binding BackCommand}"
                        Text="←" FontSize="20" />
            </HorizontalStackLayout>

            <Label Text="{Binding PageTitle}" Style="{StaticResource TitleLarge}" Margin="0,0,0,8" />
            <Label Text="{Binding Subtitle}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   Margin="0,0,0,32" />

            <!-- Email: full-area Button on top so Command runs on the UI thread (TapGestureRecognizer can fire off-thread on Android). -->
            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center" InputTransparent="True">
                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" Padding="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="✉" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding EmailTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding EmailSubtitle}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Button BackgroundColor="Transparent"
                        Command="{Binding CreateWithEmailCommand}"
                        Opacity="0.02" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center" InputTransparent="True">
                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" Padding="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="📞" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding PhoneTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding PhoneSubtitle}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Button BackgroundColor="Transparent"
                        Command="{Binding CreateWithPhoneCommand}"
                        Opacity="0.02" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center" InputTransparent="True">
                        <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" Padding="0" VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text="🎤" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding VoiceTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding VoiceSubtitle}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Button BackgroundColor="Transparent"
                        Command="{Binding CreateWithVoiceCommand}"
                        Opacity="0.02" />
            </Grid>

            <HorizontalStackLayout Margin="0,32,0,0" HorizontalOptions="Center" Spacing="4">
                <Label Text="{Binding AlreadyHaveAccount}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />
                <Button Text="{Binding SignInText}" Style="{StaticResource TextButton}" Padding="0" Command="{Binding SignInCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
