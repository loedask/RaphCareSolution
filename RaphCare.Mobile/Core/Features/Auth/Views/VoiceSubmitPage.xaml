<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Shared.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.VoiceSubmitPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <HorizontalStackLayout Margin="0,48,0,16" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}" Text="←" FontSize="20" Command="{Binding BackCommand}" />
            </HorizontalStackLayout>

            <Label Text="{Binding Title}" Style="{StaticResource TitleLarge}" Margin="0,0,0,4" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" Margin="0,0,0,16" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowSuccess, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding PhoneLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                <Label Text="{Binding PhoneE164}" Style="{StaticResource BodySmall}" />

                <Label Text="{Binding LanguageLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Entry Text="{Binding Language}" Style="{StaticResource DefaultEntry}" />

                <Button Text="{Binding PickFileText}"
                        Style="{StaticResource AuthSecondaryButton}"
                        Command="{Binding PickFileCommand}"
                        Margin="0,12,0,0" />
                <Label Text="{Binding PickedFileName}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="12" />

                <shared:GradientButton Text="{Binding SubmitText}"
                                       Command="{Binding SubmitCommand}"
                                       IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                       Margin="0,16,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding ShowSuccess}">
                <Label Text="{Binding SuccessTitle}" Style="{StaticResource TitleLarge}" />
                <Label Text="{Binding SuccessTranscription}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />
                <shared:GradientButton Text="{Binding ContinueHomeText}" Command="{Binding ContinueHomeCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
