<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Shared.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.AccountCreatedPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AuthBackgroundGradient}">

    <ScrollView>
        <VerticalStackLayout Padding="32" VerticalOptions="Center" Spacing="20">
            <Label Text="✓"
                   FontSize="72"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TealGlowColor}"
                   Margin="0,0,0,8" />

            <Label Text="{Binding Headline}"
                   Style="{StaticResource AuthTitleLabel}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding Body}"
                   Style="{StaticResource AuthSubtitleLabel}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

            <shared:GradientButton Text="{Binding ContinueLabel}"
                                   Command="{Binding ContinueCommand}"
                                   Margin="0,32,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
