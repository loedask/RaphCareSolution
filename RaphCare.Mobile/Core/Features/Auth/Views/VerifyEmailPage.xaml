<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:RaphCare.Mobile.Features.Auth.Views"
             x:Class="RaphCare.Mobile.Features.Auth.Views.VerifyEmailPage"
             Shell.NavBarIsVisible="False"
             Background="{StaticResource AuthBackgroundGradient}">

    <ScrollView>
        <VerticalStackLayout Padding="32" VerticalOptions="Center" Spacing="24">
            <Label Text="Verify your email" Style="{StaticResource AuthTitleLabel}" />
            <Label Text="We sent a verification link to your email. Open it to verify your account, then sign in below."
                   Style="{StaticResource AuthSubtitleLabel}" />

            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" Margin="0,0,0,8" />

            <Button Text="Sign In"
                    Style="{StaticResource AuthPrimaryButton}"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,32,0,0" />

            <Button Text="Resend verification"
                    Style="{StaticResource AuthSecondaryButton}"
                    Command="{Binding ResendCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
