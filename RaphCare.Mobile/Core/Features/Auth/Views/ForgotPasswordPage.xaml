<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="0">
            <HorizontalStackLayout Margin="0,0,0,24" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}"
                        Text="←"
                        FontSize="20"
                        Command="{Binding BackCommand}" />
            </HorizontalStackLayout>

            <Label Text="{Binding PageTitle}"
                   Style="{StaticResource TitleLarge}"
                   TextColor="{StaticResource ForegroundColor}" />

            <Label Text="{Binding Subtitle}"
                   FontSize="14"
                   TextColor="{StaticResource MutedForegroundColor}"
                   Margin="0,0,0,20" />

            <shared:InputField LabelText="{Binding EmailLabel}"
                               Placeholder="{Binding EmailPlaceholder}"
                               Keyboard="Email"
                               Text="{Binding Email}"
                               IsVisible="{Binding AwaitingCode, Converter={StaticResource InvertedBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding AwaitingCode}" Spacing="0">
                <shared:InputField LabelText="{Binding CodeLabel}"
                                   Placeholder="{Binding CodePlaceholder}"
                                   Keyboard="Numeric"
                                   Text="{Binding VerificationCode}" />
                <shared:InputField LabelText="{Binding NewPasswordLabel}"
                                   Placeholder="{Binding PasswordPlaceholder}"
                                   IsPassword="True"
                                   Text="{Binding NewPassword}" />
                <shared:InputField LabelText="{Binding ConfirmPasswordLabel}"
                                   Placeholder="{Binding PasswordPlaceholder}"
                                   IsPassword="True"
                                   Text="{Binding ConfirmPassword}" />
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   FontSize="12"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Margin="0,8,0,0" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Margin="0,8,0,0" />

            <shared:GradientButton Text="{Binding ContinueButtonText}"
                                   Command="{Binding ContinueCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                   Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
