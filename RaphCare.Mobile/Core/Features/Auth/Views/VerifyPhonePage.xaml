<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Shared.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Auth.Views.VerifyPhonePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <HorizontalStackLayout Margin="0,48,0,24" HorizontalOptions="Start">
                <Button Style="{StaticResource IconBackButton}" Text="←" FontSize="20" Command="{Binding BackCommand}" />
            </HorizontalStackLayout>

            <Label Text="{Binding Title}" Style="{StaticResource TitleLarge}" Margin="0,0,0,4" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" Margin="0,0,0,8" />
            <Label Text="{Binding PhoneE164}" Style="{StaticResource BodySmall}" FontAttributes="Bold" TextColor="{StaticResource ForegroundColor}" Margin="0,0,0,24" />

            <Label Text="{Binding CodeLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
            <Entry Text="{Binding Code}" Keyboard="Numeric" Placeholder="000000" MaxLength="10" Style="{StaticResource DefaultEntry}" />

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" FontSize="12" />

            <shared:GradientButton Text="{Binding VerifyText}"
                                   Command="{Binding VerifyCommand}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                   Margin="0,16,0,0" />

            <Button Text="{Binding ResendText}"
                    Style="{StaticResource TextButton}"
                    Command="{Binding ResendCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
