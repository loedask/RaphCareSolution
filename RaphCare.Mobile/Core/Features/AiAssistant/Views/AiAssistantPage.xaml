<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.AiAssistant.ViewModels"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.AiAssistant.Models"
             xmlns:local="clr-namespace:RaphCare.Mobile.Core.Features.AiAssistant.Views"
             x:Class="RaphCare.Mobile.Core.Features.AiAssistant.Views.AiAssistantPage"
             x:DataType="vm:AiAssistantViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:AiAssistantChatMessage">
            <Grid Padding="0,4" ColumnDefinitions="48,*">
                <Border Grid.Column="1"
                        Padding="14,12"
                        HorizontalOptions="End"
                        MaximumWidthRequest="320"
                        Background="{StaticResource GradientTealBrush}"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16,16,4,16" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Text}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{StaticResource PrimaryForegroundColor}"
                           LineBreakMode="WordWrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:AiAssistantChatMessage">
            <Grid Padding="0,4" ColumnDefinitions="*,48">
                <Border Grid.Column="0"
                        Padding="14,12"
                        HorizontalOptions="Start"
                        MaximumWidthRequest="320"
                        Style="{StaticResource CardBorder}"
                        Margin="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16,16,16,4" />
                    </Border.StrokeShape>
                    <Label Text="{Binding Text}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{StaticResource ForegroundColor}"
                           LineBreakMode="WordWrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <local:AiAssistantMessageTemplateSelector x:Key="MessageTemplateSelector"
                                                  UserTemplate="{StaticResource UserMessageTemplate}"
                                                  AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <VerticalStackLayout Grid.Row="0"
                             Padding="24,16,24,8"
                             Spacing="6">
            <Label Text="{Binding IntroText}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource MutedForegroundColor}" />
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <CollectionView x:Name="MessagesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Messages}"
                        ItemTemplate="{StaticResource MessageTemplateSelector}"
                        Margin="16,0"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" Spacing="0">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}"
                               HeightRequest="28"
                               Margin="0,4" />

            <Label Text="{Binding DisclaimerText}"
                   Style="{StaticResource Caption}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   Margin="24,0,24,8"
                   IsVisible="{Binding HasDisclaimer}" />

            <Border Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource CardColor}"
                    Padding="12,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Editor Grid.Column="0"
                            Text="{Binding DraftMessage}"
                            Placeholder="{Binding PlaceholderText}"
                            AutoSize="TextChanges"
                            MaximumHeightRequest="120"
                            MinimumHeightRequest="44"
                            MaxLength="2000"
                            Style="{StaticResource BodyMedium}"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center" />
                    <shared:GradientButton Grid.Column="1"
                                           Text="{Binding SendButtonText}"
                                           Command="{Binding SendCommand}"
                                           Padding="16,10"
                                           MinimumHeightRequest="44"
                                           MinimumWidthRequest="72"
                                           VerticalOptions="End" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
