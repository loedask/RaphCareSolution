<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.AiAssistant.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.AiAssistant.Views.AiAssistantPage"
             x:DataType="vm:AiAssistantViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="{Binding IntroText}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource MutedForegroundColor}" />

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Editor Text="{Binding DraftMessage}"
                            Placeholder="{Binding PlaceholderText}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100"
                            MaxLength="2000"
                            Style="{StaticResource BodyMedium}" />
                    <shared:GradientButton Text="{Binding SendButtonText}"
                                           Command="{Binding SendCommand}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}"
                               VerticalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    IsVisible="{Binding HasReply}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ReplyHeading}"
                           Style="{StaticResource BodyMedium}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryColor}" />
                    <Label Text="{Binding ReplyText}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{StaticResource MutedForegroundColor}" />
                    <Label Text="{Binding DisclaimerText}"
                           Style="{StaticResource Caption}"
                           TextColor="{StaticResource MutedForegroundColor}"
                           Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding EmptyReplyText}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding HasReply, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
