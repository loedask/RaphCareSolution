<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Family.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Family.Views.AddFamilyMemberPage"
             x:DataType="vm:AddFamilyMemberViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Style="{StaticResource BodyMedium}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding FirstNameLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                <Entry Text="{Binding FirstName}" Placeholder="{Binding FirstNameLabel}" />

                <Label Text="{Binding LastNameLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Entry Text="{Binding LastName}" Placeholder="{Binding LastNameLabel}" />

                <Label Text="{Binding RelationshipLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Picker ItemsSource="{Binding RelationshipOptions}"
                        SelectedItem="{Binding SelectedRelationship}"
                        Title="{Binding RelationshipLabel}" />

                <HorizontalStackLayout Spacing="8" Margin="0,12,0,0">
                    <CheckBox IsChecked="{Binding HasDateOfBirth}" VerticalOptions="Center" />
                    <Label Text="{Binding DobHint}" Style="{StaticResource BodyMedium}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <DatePicker Date="{Binding DobDate}"
                            IsVisible="{Binding HasDateOfBirth}" />

                <Label Text="{Binding PhoneLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Entry Text="{Binding Phone}" Keyboard="Telephone" Placeholder="{Binding PhoneLabel}" />

                <Label Text="{Binding EmailLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="{Binding EmailLabel}" />

                <Button Text="{Binding SubmitLabel}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitCommand}"
                        Margin="0,16,0,0" />
                <Button Text="{Binding CancelLabel}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
