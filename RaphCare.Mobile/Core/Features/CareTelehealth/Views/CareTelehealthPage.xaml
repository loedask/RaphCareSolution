<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.CareTelehealth.Models"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.CareTelehealth.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.CareTelehealth.Views.CareTelehealthPage"
             x:DataType="vm:CareTelehealthViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">
        <Button Grid.Row="0"
                Text="{Binding RefreshButtonText}"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding RefreshCommand}"
                HorizontalOptions="Start" />

        <Label Grid.Row="1"
               Text="{Binding HintText}"
               Style="{StaticResource BodySmall}"
               TextColor="{StaticResource MutedForegroundColor}" />

        <Grid Grid.Row="2">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" Color="{StaticResource PrimaryColor}" />

            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TeleSessionListDisplayItem">
                        <Grid Margin="0,0,0,12">
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4" InputTransparent="True">
                                    <Label Text="{Binding PrimaryLine}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding SecondaryLine}" Style="{StaticResource BodySmall}" TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                            </Border>
                            <Button BackgroundColor="Transparent"
                                    Opacity="0.02"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenJoinCommand}"
                                    CommandParameter="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding EmptyStateText}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding ShowEmpty}"
                   InputTransparent="True" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource ErrorColor}"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   InputTransparent="True" />
        </Grid>
    </Grid>
</ContentPage>
