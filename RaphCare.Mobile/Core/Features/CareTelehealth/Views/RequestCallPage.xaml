<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.CareTelehealth.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.CareTelehealth.Views.RequestCallPage"
             x:DataType="vm:RequestCallViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="*,Auto" Padding="24">
        <VerticalStackLayout Grid.Row="0" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center">
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsIdle}" HorizontalOptions="Center">
                <Button Text="{Binding VideoModeText}" Command="{Binding SelectVideoCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="{Binding AudioModeText}" Command="{Binding SelectAudioCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="{Binding LowBandModeText}" Command="{Binding SelectLowBandCommand}" Style="{StaticResource SecondaryButton}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsConnecting}" IsVisible="{Binding IsConnecting}" Color="{StaticResource PrimaryColor}" />

            <Label Text="{Binding StateTitle}" Style="{StaticResource TitleLarge}" HorizontalTextAlignment="Center" />
            <Label Text="{Binding StateSubtitle}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <shared:GradientButton Text="{Binding StartButtonText}" Command="{Binding StartCommand}" IsVisible="{Binding ShowStartButton}" />
            <Button Text="{Binding BackButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
