<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Billing.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Billing.Views.AddPaymentMethodPage"
             x:DataType="vm:AddPaymentMethodViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Style="{StaticResource BodyMedium}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding MethodTypeLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                <Entry Text="{Binding MethodType}" Placeholder="Card" />

                <Label Text="{Binding ProviderLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Entry Text="{Binding ProviderName}" Placeholder="{Binding ProviderLabel}" />

                <Label Text="{Binding MaskedLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,12,0,0" />
                <Entry Text="{Binding MaskedDetails}" Placeholder="•••• 4242" />

                <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                    <CheckBox IsChecked="{Binding SetAsDefault}" VerticalOptions="Center" />
                    <Label Text="{Binding DefaultLabel}" Style="{StaticResource BodyMedium}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Text="{Binding SubmitLabel}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitCommand}"
                        Margin="0,16,0,0" />
                <Button Text="{Binding CancelLabel}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
