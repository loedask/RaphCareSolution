<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Appointments.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Appointments.Views.AppointmentDetailPage"
             x:DataType="vm:AppointmentDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   Style="{StaticResource BodyMedium}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding WhenLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                <Label Text="{Binding WhenText}" Style="{StaticResource TitleMedium}" />

                <Label Text="{Binding StatusLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding StatusText}" Style="{StaticResource BodyMedium}" />

                <Label Text="{Binding TypeLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding TypeText}" Style="{StaticResource BodyMedium}" />

                <Label Text="{Binding ReasonLabel}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" Margin="0,8,0,0" />
                <Label Text="{Binding ReasonText}" Style="{StaticResource BodyMedium}" TextColor="{StaticResource MutedForegroundColor}" />

                <VerticalStackLayout Spacing="12"
                                     Margin="0,16,0,0"
                                     IsVisible="{Binding ShowConsent}">
                    <Label Text="{Binding ConsentSectionTitle}" Style="{StaticResource TitleMedium}" />
                    <Label Text="{Binding ConsentTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                    <Label Text="{Binding ConsentBody}" Style="{StaticResource BodyMedium}" />
                    <Label Text="{Binding ConsentSignedLabel}"
                           Style="{StaticResource BodyMedium}"
                           TextColor="{StaticResource MutedForegroundColor}"
                           IsVisible="{Binding ConsentAlreadySigned}" />
                    <Button Text="{Binding AgreeButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AgreeConsentCommand}"
                            IsVisible="{Binding ConsentAlreadySigned, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Button Text="← Back"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    Margin="0,24,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
