<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Shared.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.EditProfilePage"
             x:DataType="vm:EditProfileViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,0,0,8">
                <Border BackgroundColor="{StaticResource SecondaryColor}"
                        StrokeThickness="0"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Label Text="👤" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding PhotoHint}"
                       Style="{StaticResource Caption}"
                       TextColor="{StaticResource MutedForegroundColor}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}" Margin="0">
                <VerticalStackLayout Padding="4" Spacing="12">
                    <shared:InputField LabelText="{Binding FirstNameLabel}" Text="{Binding FirstName}" />
                    <shared:InputField LabelText="{Binding LastNameLabel}" Text="{Binding LastName}" />
                    <shared:InputField LabelText="{Binding EmailLabel}" Text="{Binding Email}" Keyboard="Email" />
                    <shared:InputField LabelText="{Binding PhoneLabel}" Text="{Binding Phone}" Keyboard="Telephone" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding DobLabel}" Style="{StaticResource BodyMedium}" />
                        <DatePicker Date="{Binding DateOfBirth}" FontFamily="DMSans" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding GenderLabel}" Style="{StaticResource BodyMedium}" />
                        <Picker ItemsSource="{Binding GenderOptions}"
                                SelectedIndex="{Binding GenderIndex}"
                                FontFamily="DMSans" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />

            <shared:GradientButton Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
