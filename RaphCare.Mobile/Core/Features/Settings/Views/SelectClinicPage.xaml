<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             xmlns:auth="clr-namespace:RaphCare.Mobile.Core.Features.Auth.Models"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.SelectClinicPage"
             x:DataType="vm:SelectClinicViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="{Binding HintText}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}" />

            <Border Style="{StaticResource CardBorder}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ActiveClinicLabel}"
                           Style="{StaticResource Caption}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource MutedForegroundColor}" />
                    <Label Text="{Binding CurrentClinicSummary}"
                           Style="{StaticResource BodyMedium}"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <shared:InputField LabelText="{Binding SearchLabel}"
                               Placeholder="{Binding SearchPlaceholder}"
                               Text="{Binding SearchText}" />
            <Button Text="{Binding SearchButtonText}"
                    Style="{StaticResource AuthSecondaryButton}"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <shared:InputField LabelText="{Binding ReferenceLabel}"
                               Placeholder="{Binding ReferencePlaceholder}"
                               Text="{Binding ReferenceCodeText}" />
            <Button Text="{Binding UseCodeButtonText}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding UseCodeCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Button Text="{Binding ClearButtonText}"
                    Style="{StaticResource AuthSecondaryButton}"
                    Command="{Binding ClearCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   FontSize="12"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding ResultsEmptyHint}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   IsVisible="{Binding ShowResultsCard, Converter={StaticResource InvertedBoolConverter}}" />

            <VerticalStackLayout IsVisible="{Binding ShowResultsCard}" Spacing="8">
                <Label Text="{Binding ResultsHeading}"
                       Style="{StaticResource SectionTitle}"
                       Margin="0" />
                <Label Text="{Binding TapToActivateHint}"
                       Style="{StaticResource Caption}"
                       TextColor="{StaticResource MutedForegroundColor}"
                       IsVisible="{Binding HasSearchResults}" />
                <Border Style="{StaticResource CardBorder}"
                        IsVisible="{Binding HasSearchResults}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="auth:ClinicPickerItem">
                                <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                        <Label Text="{Binding ReferenceCode}"
                                               Style="{StaticResource Caption}"
                                               TextColor="{StaticResource MutedForegroundColor}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="→"
                                           TextColor="{StaticResource PrimaryColor}"
                                           VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
