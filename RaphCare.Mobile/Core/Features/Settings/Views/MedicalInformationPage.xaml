<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.Settings.Models"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.MedicalInformationPage"
             x:DataType="vm:MedicalInformationViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Padding="4" Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding BloodTypeLabel}" Style="{StaticResource BodyMedium}" />
                        <Picker ItemsSource="{Binding BloodTypeOptions}"
                                SelectedIndex="{Binding BloodTypeIndex}"
                                Title="{Binding BloodTypeLabel}"
                                FontFamily="DMSans" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding AllergiesLabel}" Style="{StaticResource BodyMedium}" />
                        <Label Text="{Binding ChipHint}"
                               Style="{StaticResource Caption}"
                               TextColor="{StaticResource MutedForegroundColor}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding AllergyChips}"
                                    Wrap="Wrap"
                                    AlignItems="Start"
                                    JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MedicalInfoChipItem">
                                    <Button Text="{Binding Label}"
                                            Command="{Binding ToggleCommand}"
                                            FontFamily="DMSans"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            CornerRadius="18"
                                            Padding="14,8"
                                            Margin="0,0,8,8"
                                            MinimumHeightRequest="36"
                                            BackgroundColor="{StaticResource SecondaryColor}"
                                            TextColor="{StaticResource ForegroundColor}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                                                <Setter Property="TextColor" Value="{StaticResource PrimaryForegroundColor}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding OtherNotesLabel}" Style="{StaticResource Caption}" />
                        <Editor Text="{Binding AllergiesOther}"
                                Placeholder="{Binding OtherNotesPlaceholder}"
                                AutoSize="TextChanges"
                                FontFamily="DMSans"
                                MinimumHeightRequest="56" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ChronicLabel}" Style="{StaticResource BodyMedium}" />
                        <Label Text="{Binding ChipHint}"
                               Style="{StaticResource Caption}"
                               TextColor="{StaticResource MutedForegroundColor}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding ChronicChips}"
                                    Wrap="Wrap"
                                    AlignItems="Start"
                                    JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:MedicalInfoChipItem">
                                    <Button Text="{Binding Label}"
                                            Command="{Binding ToggleCommand}"
                                            FontFamily="DMSans"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            CornerRadius="18"
                                            Padding="14,8"
                                            Margin="0,0,8,8"
                                            MinimumHeightRequest="36"
                                            BackgroundColor="{StaticResource SecondaryColor}"
                                            TextColor="{StaticResource ForegroundColor}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                                                <Setter Property="TextColor" Value="{StaticResource PrimaryForegroundColor}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                        <Label Text="{Binding OtherNotesLabel}" Style="{StaticResource Caption}" />
                        <Editor Text="{Binding ChronicOther}"
                                Placeholder="{Binding OtherNotesPlaceholder}"
                                AutoSize="TextChanges"
                                FontFamily="DMSans"
                                MinimumHeightRequest="56" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding MedicationsLabel}" Style="{StaticResource BodyMedium}" />
                        <Editor Text="{Binding Medications}" AutoSize="TextChanges" FontFamily="DMSans" MinimumHeightRequest="56" />
                    </VerticalStackLayout>
                    <shared:InputField LabelText="{Binding PrimaryDoctorLabel}" Text="{Binding PrimaryDoctor}" />
                </VerticalStackLayout>
            </Border>
            <shared:GradientButton Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
