<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.MedicalInformationPage"
             x:DataType="vm:MedicalInformationViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Padding="4" Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding BloodTypeLabel}" Style="{StaticResource BodyMedium}" />
                        <Picker ItemsSource="{Binding BloodTypeOptions}" SelectedIndex="{Binding BloodTypeIndex}" FontFamily="DMSans" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding AllergiesLabel}" Style="{StaticResource BodyMedium}" />
                        <Editor Text="{Binding Allergies}" AutoSize="TextChanges" FontFamily="DMSans" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ChronicLabel}" Style="{StaticResource BodyMedium}" />
                        <Editor Text="{Binding ChronicConditions}" AutoSize="TextChanges" FontFamily="DMSans" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding MedicationsLabel}" Style="{StaticResource BodyMedium}" />
                        <Editor Text="{Binding Medications}" AutoSize="TextChanges" FontFamily="DMSans" />
                    </VerticalStackLayout>
                    <shared:InputField LabelText="{Binding PrimaryDoctorLabel}" Text="{Binding PrimaryDoctor}" />
                </VerticalStackLayout>
            </Border>
            <shared:GradientButton Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
