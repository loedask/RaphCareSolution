<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="{Binding EntraHint}"
                   Style="{StaticResource BodySmall}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   LineBreakMode="WordWrap" />
            <Button Text="{Binding UpdateLabel}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenEntraResetCommand}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Padding="4" Spacing="12">
                    <shared:InputField LabelText="{Binding CurrentLabel}" Text="{Binding CurrentPassword}" IsPassword="True" />
                    <shared:InputField LabelText="{Binding NewLabel}" Text="{Binding NewPassword}" IsPassword="True" />
                    <shared:InputField LabelText="{Binding ConfirmLabel}" Text="{Binding ConfirmPassword}" IsPassword="True" />
                </VerticalStackLayout>
            </Border>
            <shared:GradientButton Text="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
