<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.PrivacyPage"
             x:DataType="vm:PrivacySettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="{Binding SecuritySectionTitle}"
                   Style="{StaticResource SectionTitle}"
                   Margin="4,0,0,0" />
            <Border Style="{StaticResource CardBorder}" Margin="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_lock_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding ChangePasswordTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding ChangePasswordSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" Opacity="0.5" VerticalOptions="Center" TextColor="{StaticResource MutedForegroundColor}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="16,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_shield_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding TwoFactorTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding TwoFactorSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding TwoFactor}" VerticalOptions="Center" OnColor="{StaticResource PrimaryColor}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding DataSectionTitle}"
                   Style="{StaticResource SectionTitle}"
                   Margin="4,0,0,0" />
            <Border Style="{StaticResource CardBorder}" Margin="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_upload_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding DataSharingTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding DataSharingSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding DataSharing}" VerticalOptions="Center" OnColor="{StaticResource PrimaryColor}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="16,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_download_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding DownloadTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding DownloadSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" Opacity="0.5" VerticalOptions="Center" TextColor="{StaticResource MutedForegroundColor}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DownloadDataCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="16,0" />
                    <Grid ColumnDefinitions="Auto,*" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_trash_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding DeleteTitle}" TextColor="{StaticResource DestructiveColor}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding DeleteSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

