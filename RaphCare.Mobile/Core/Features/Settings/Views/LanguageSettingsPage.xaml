<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             xmlns:auth="clr-namespace:RaphCare.Mobile.Core.Features.Auth.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.LanguageSettingsPage"
             x:DataType="vm:LanguageSettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Languages}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="auth:LanguageOption">
                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding English}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding Native}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="✓"
                                       IsVisible="{Binding IsCurrent}"
                                       TextColor="{StaticResource PrimaryColor}"
                                       VerticalOptions="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
