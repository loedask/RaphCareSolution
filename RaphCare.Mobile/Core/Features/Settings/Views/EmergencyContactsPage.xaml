<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             xmlns:models="clr-namespace:RaphCare.Mobile.Core.Features.Settings.Models"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.EmergencyContactsPage"
             x:DataType="vm:EmergencyContactsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <CollectionView ItemsSource="{Binding Contacts}" SelectionMode="None"
                            IsVisible="{Binding ShowEmpty, Converter={StaticResource InvertedBoolConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StoredEmergencyContact">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                                    <Label Text="{Binding Relationship}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                                    <Label Text="{Binding Phone}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="✎" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Text="🗑" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding EmptyText}"
                   Style="{StaticResource BodyMedium}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ShowEmpty}" />

            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ShowForm}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FormTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                    <shared:InputField LabelText="{Binding NameLabel}" Text="{Binding FormName}" />
                    <shared:InputField LabelText="{Binding RelationshipLabel}" Text="{Binding FormRelationship}" />
                    <shared:InputField LabelText="{Binding PhoneLabel}" Text="{Binding FormPhone}" Keyboard="Telephone" />
                    <shared:GradientButton Text="{Binding SaveFormButtonText}" Command="{Binding SaveFormCommand}" />
                    <Button Text="{Binding CancelFormButtonText}"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelFormCommand}" />
                </VerticalStackLayout>
            </Border>

            <shared:GradientButton Text="{Binding AddButtonText}"
                                   Command="{Binding AddCommand}"
                                   IsVisible="{Binding ShowForm, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
