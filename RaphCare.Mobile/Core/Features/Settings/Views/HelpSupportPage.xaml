<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.HelpSupportPage"
             x:DataType="vm:HelpSupportViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="{Binding ContactSectionTitle}"
                   Style="{StaticResource SectionTitle}"
                   Margin="4,0,0,0" />
            <Border Style="{StaticResource CardBorder}" Margin="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_help_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding FaqTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding FaqSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" Opacity="0.5" VerticalOptions="Center" TextColor="{StaticResource MutedForegroundColor}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FaqCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="16,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_message_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding MessageTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding MessageSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" Opacity="0.5" VerticalOptions="Center" TextColor="{StaticResource MutedForegroundColor}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MessageCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="16,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_phone_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding CallTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding CallSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" Opacity="0.5" VerticalOptions="Center" TextColor="{StaticResource MutedForegroundColor}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="16,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,14">
                        <Border Grid.Column="0" Style="{StaticResource ProfileMenuIconBorder}" Margin="0,0,12,0">
                            <Image Source="icon_mail_on_accent.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding EmailTitle}" Style="{StaticResource BodyMedium}" FontAttributes="Bold" />
                            <Label Text="{Binding EmailSubtitle}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="18" Opacity="0.5" VerticalOptions="Center" TextColor="{StaticResource MutedForegroundColor}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EmailCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding TipsSectionTitle}"
                   Style="{StaticResource SectionTitle}"
                   Margin="4,0,0,0" />
            <Border Style="{StaticResource CardBorder}" Margin="0">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="icon_sparkles.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit"
                               VerticalOptions="Start" />
                        <Label Text="{Binding Tip1}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="icon_sparkles.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit"
                               VerticalOptions="Start" />
                        <Label Text="{Binding Tip2}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="icon_sparkles.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit"
                               VerticalOptions="Start" />
                        <Label Text="{Binding Tip3}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10">
                        <Image Source="icon_sparkles.png" WidthRequest="14" HeightRequest="14" Aspect="AspectFit"
                               VerticalOptions="Start" />
                        <Label Text="{Binding Tip4}" Style="{StaticResource Caption}" TextColor="{StaticResource MutedForegroundColor}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding AppVersionLabel}"
                   Style="{StaticResource Micro}"
                   TextColor="{StaticResource MutedForegroundColor}"
                   HorizontalTextAlignment="Center"
                   Opacity="0.7" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

