<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:RaphCare.Mobile.Core.Common.Controls"
             xmlns:vm="clr-namespace:RaphCare.Mobile.Core.Features.Settings.ViewModels"
             x:Class="RaphCare.Mobile.Core.Features.Settings.Views.SupportMessagePage"
             x:DataType="vm:SupportMessageViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Padding="4" Spacing="12">
                    <shared:InputField LabelText="{Binding SubjectLabel}" Text="{Binding Subject}" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding MessageLabel}" Style="{StaticResource BodyMedium}" />
                        <Editor Text="{Binding Message}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="140"
                                FontFamily="DMSans" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />
            <shared:GradientButton Text="{Binding SendButtonText}" Command="{Binding SendCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
