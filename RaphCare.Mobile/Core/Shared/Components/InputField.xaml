<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="RaphCare.Mobile.Core.Shared.Components.InputField"
                    x:Name="RootLayout"
                    Spacing="4">
    <Label x:Name="LabelTitle" Text="{Binding LabelText, Source={x:Reference RootLayout}}"
           IsVisible="{Binding LabelText, Source={x:Reference RootLayout}, Converter={StaticResource StringNotEmptyConverter}}"
           Style="{StaticResource BodyMedium}" />
    <Entry x:Name="InputEntry"
           Placeholder="{Binding Placeholder, Source={x:Reference RootLayout}}"
           Text="{Binding Text, Source={x:Reference RootLayout}, Mode=TwoWay}"
           IsPassword="{Binding IsPassword, Source={x:Reference RootLayout}}"
           Keyboard="{Binding Keyboard, Source={x:Reference RootLayout}}"
           Style="{StaticResource DefaultEntry}" />
    <Label x:Name="LabelError" Text="{Binding ErrorText, Source={x:Reference RootLayout}}"
           IsVisible="{Binding ErrorText, Source={x:Reference RootLayout}, Converter={StaticResource StringNotEmptyConverter}}"
           TextColor="{StaticResource ErrorColor}"
           FontSize="12"
           Margin="0,-4,0,0" />
</VerticalStackLayout>
