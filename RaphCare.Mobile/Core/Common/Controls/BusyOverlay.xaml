<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RaphCare.Mobile.Core.Common.Controls.BusyOverlay"
             x:Name="Root"
             IsVisible="False"
             InputTransparent="True">

    <Grid BackgroundColor="#99121C30">
        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{StaticResource CardColor}"
                Padding="28,24"
                StrokeThickness="0"
                MaximumWidthRequest="280">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource NavyColor}" Opacity="0.18" Radius="24" Offset="0,8" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                <Grid WidthRequest="72"
                      HeightRequest="72"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <Border x:Name="PulseRing"
                            WidthRequest="72"
                            HeightRequest="72"
                            BackgroundColor="Transparent"
                            StrokeThickness="2.5"
                            Stroke="{StaticResource TealGlowColor}"
                            Opacity="0.55"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="36" />
                        </Border.StrokeShape>
                    </Border>

                    <Border WidthRequest="56"
                            HeightRequest="56"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            StrokeThickness="0"
                            InputTransparent="True">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource TealColor}" Offset="0" />
                                <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ActivityIndicator IsRunning="{Binding Source={x:Reference Root}, Path=IsBusy}"
                                           Color="White"
                                           WidthRequest="28"
                                           HeightRequest="28"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label x:Name="MessageLabel"
                       Style="{StaticResource BodyMedium}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource ForegroundColor}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
