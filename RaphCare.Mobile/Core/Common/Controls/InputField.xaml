<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="RaphCare.Mobile.Core.Common.Controls.InputField"
                    x:Name="RootLayout"
                    Spacing="4">
    <Label x:Name="LabelTitle" Text="{Binding LabelText, Source={x:Reference RootLayout}}"
           IsVisible="{Binding LabelText, Source={x:Reference RootLayout}, Converter={StaticResource StringNotEmptyConverter}}"
           Style="{StaticResource BodyMedium}" />
    <Border Stroke="{StaticResource BorderColor}"
            StrokeThickness="1"
            BackgroundColor="{StaticResource SecondaryColor}"
            Padding="14,2"
            Margin="0,0,0,14">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.04" Radius="8" Offset="0,2" />
        </Border.Shadow>
        <Grid ColumnDefinitions="*,Auto">
        <Entry x:Name="InputEntry"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Margin="0"
               BackgroundColor="Transparent"
               Placeholder="{Binding Placeholder, Source={x:Reference RootLayout}}"
               Text="{Binding Text, Source={x:Reference RootLayout}, Mode=TwoWay}"
               Keyboard="{Binding Keyboard, Source={x:Reference RootLayout}}"
               Style="{StaticResource DefaultEntry}" />
        <Button x:Name="PasswordVisibilityButton"
                Grid.Column="1"
                Style="{StaticResource TextButton}"
                FontSize="13"
                Padding="8,0,4,0"
                MinimumWidthRequest="52"
                VerticalOptions="Center"
                HorizontalOptions="End"
                IsVisible="False"
                Clicked="OnPasswordVisibilityClicked" />
        </Grid>
    </Border>
    <Label x:Name="LabelError" Text="{Binding ErrorText, Source={x:Reference RootLayout}}"
           IsVisible="{Binding ErrorText, Source={x:Reference RootLayout}, Converter={StaticResource StringNotEmptyConverter}}"
           TextColor="{StaticResource ErrorColor}"
           FontSize="12"
           Margin="0,-4,0,0" />
</VerticalStackLayout>
