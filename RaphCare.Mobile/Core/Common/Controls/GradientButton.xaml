<?xml version="1.0" encoding="utf-8" ?>
<Button xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="RaphCare.Mobile.Core.Common.Controls.GradientButton"
        x:Name="RootButton"
        TextColor="White"
        FontFamily="SpaceGrotesk"
        FontSize="16"
        FontAttributes="Bold"
        CornerRadius="16"
        Padding="24,16"
        MinimumHeightRequest="52"
        Opacity="1">
    <Button.Shadow>
        <Shadow Brush="#1B9BBB" Opacity="0.28" Radius="16" Offset="0,6" />
    </Button.Shadow>
    <Button.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource TealColor}" Offset="0" />
            <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
        </LinearGradientBrush>
    </Button.Background>
</Button>
