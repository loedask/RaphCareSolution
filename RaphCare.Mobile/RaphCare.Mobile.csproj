<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>RaphCare.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en</NeutralLanguage>
        <UserSecretsId>7c8e9f0a-1b2c-4d5e-8f9a-0b1c2d3e4f5a</UserSecretsId>

        <!-- XAML: use runtime inflation (SourceGen had issues with ResourceDictionary/Styles) -->

        <!-- Display name -->
        <ApplicationTitle>RaphCare</ApplicationTitle>

        <!-- App Identifier (stable before Play listing; do not change casually) -->
        <ApplicationId>com.yindula.raphcare</ApplicationId>

        <!-- Versions: display = marketing (Settings / APK name); code = Android versionCode (must rise for each Play upload). -->
        <ApplicationDisplayVersion>1.8.12</ApplicationDisplayVersion>
        <ApplicationVersion>24</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Compiled-binding hints; same exclusions as Publish-RaphCareAndroid*.ps1 -->
        <WarningsNotAsErrors>XC0022;XC0025</WarningsNotAsErrors>
    </PropertyGroup>

    <!-- Optional Release signing for Play upload. Pass from publish script / CI secrets; never commit the keystore. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RaphCareAndroidKeystore)' != '' And Exists('$(RaphCareAndroidKeystore)')">
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>$(RaphCareAndroidKeystore)</AndroidSigningKeyStore>
        <AndroidSigningStorePass>$(RaphCareAndroidKeystorePass)</AndroidSigningStorePass>
        <AndroidSigningKeyAlias>$(RaphCareAndroidKeyAlias)</AndroidSigningKeyAlias>
        <AndroidSigningKeyPass>$(RaphCareAndroidKeyPass)</AndroidSigningKeyPass>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="appsettings.json;appsettings.Development.json;appsettings.TestHosting.json" />
        <!-- Packaged into the app bundle so Release devices can read hosted API settings -->
        <MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />
        <MauiAsset Include="appsettings.Development.json" LogicalName="appsettings.Development.json" />
        <MauiAsset Include="appsettings.TestHosting.json" LogicalName="appsettings.TestHosting.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon (RaphCare R mark; white adaptive background) -->
        <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#FFFFFF" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="256,256" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />
        <MauiImage Update="Resources\Images\raphcare_logo.png" BaseSize="320,120" />
        <MauiImage Update="Resources\Images\tab_home.svg" BaseSize="24,24" />
        <MauiImage Update="Resources\Images\tab_appointments.svg" BaseSize="24,24" />
        <MauiImage Update="Resources\Images\tab_records.svg" BaseSize="24,24" />
        <MauiImage Update="Resources\Images\tab_insurance.svg" BaseSize="24,24" />
        <MauiImage Update="Resources\Images\tab_profile.svg" BaseSize="24,24" />
        <MauiImage Update="Resources\Images\icon_*.svg" BaseSize="24,24" />

        <!-- Custom Fonts (OFL license texts live alongside but are not MauiFont items) -->
        <MauiFont Include="Resources\Fonts\*.ttf" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Plugin.BLE" Version="3.1.0" />
        <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
        <PackageReference Include="ZXing.Net" Version="0.16.9" />
        <PackageReference Include="SkiaSharp" Version="3.119.0" />
        <ProjectReference Include="..\RaphCare.Mobile.Kernel\RaphCare.Mobile.Kernel.csproj" />
        <ProjectReference Include="..\RaphCare.Client\RaphCare.Client.csproj" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Identity.Client" Version="4.66.0" />
    </ItemGroup>

    <!-- Native Agora RTC (Java); Bind=false. We call RtcEngine via JNI from Platforms/Android. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidMavenLibrary Include="io.agora.rtc:full-sdk" Version="4.5.2" Bind="false" VerifyDependencies="false" />
    </ItemGroup>

    <!-- iOS: after running tools/download-agora-ios-framework.ps1, embed AgoraRtcKit for native video. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND Exists('Platforms\iOS\AgoraRtcKit\AgoraRtcKit.xcframework')">
        <NativeReference Include="Platforms\iOS\AgoraRtcKit\AgoraRtcKit.xcframework" Kind="Framework" />
    </ItemGroup>

    <!-- HBand / Veepoo vendor SDK (optional). Run tools/download-hband-android-libs.ps1.
         Default Android items auto-include **/*.aar with Bind=true (breaks jl_rcsp binding).
         Remove those, then re-add with Bind=false for JNI-only use. See docs/12.
         Do not embed gson-*.jar: GoogleGson is already pulled in and duplicates break D8. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidLibrary Remove="Platforms\Android\libs\**\*.aar" />
        <AndroidLibrary Remove="Platforms\Android\libs\**\*.jar" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' AND Exists('Platforms\Android\libs\vpbluetooth-1.20.aar')">
        <AndroidLibrary Include="Platforms\Android\libs\vpbluetooth-1.20.aar" Bind="false" />
        <AndroidLibrary Include="Platforms\Android\libs\vpprotocol-2.3.81.15.aar" Bind="false" Condition="Exists('Platforms\Android\libs\vpprotocol-2.3.81.15.aar')" />
        <AndroidLibrary Include="Platforms\Android\libs\JL_Watch_V1.13.1_11214-release.aar" Bind="false" Condition="Exists('Platforms\Android\libs\JL_Watch_V1.13.1_11214-release.aar')" />
        <AndroidLibrary Include="Platforms\Android\libs\jl_rcsp_V0.7.2_527-release.aar" Bind="false" Condition="Exists('Platforms\Android\libs\jl_rcsp_V0.7.2_527-release.aar')" />
        <AndroidLibrary Include="Platforms\Android\libs\jl_bt_ota_V1.10.0_10931-release.aar" Bind="false" Condition="Exists('Platforms\Android\libs\jl_bt_ota_V1.10.0_10931-release.aar')" />
        <AndroidLibrary Include="Platforms\Android\libs\BmpConvert_V1.6.0_10604-release.aar" Bind="false" Condition="Exists('Platforms\Android\libs\BmpConvert_V1.6.0_10604-release.aar')" />
        <AndroidLibrary Include="Platforms\Android\libs\abpartool-release.aar" Bind="false" Condition="Exists('Platforms\Android\libs\abpartool-release.aar')" />
        <AndroidMavenLibrary Include="no.nordicsemi.android.support.v18:scanner" Version="1.4.2" Bind="false" VerifyDependencies="false" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="Xamarin.AndroidX.LocalBroadcastManager" Version="1.1.0.16" />
    </ItemGroup>

</Project>
