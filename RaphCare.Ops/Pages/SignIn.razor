@page "/signin"
@layout AuthLayout

<PageTitle>@AppResources.T("SignIn_PageTitle")</PageTitle>

<div class="auth-card auth-card-form">
    <h2 class="auth-card-title">@AppResources.T("SignIn_Title")</h2>
    <p class="auth-card-subtitle">@AppResources.T("SignIn_Subtitle")</p>

    <AdminAlert Message="@_error" />
    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="text-muted">@_status</p>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div class="form-grid single-column">
            <div class="form-field">
                <label>@AppResources.T("Common_Email")</label>
                <InputText class="form-control" @bind-Value="_model.Email" type="email" disabled="@_awaitingCode" />
            </div>
            <div class="form-field">
                <label>@AppResources.T("Common_Password")</label>
                <InputText class="form-control" @bind-Value="_model.Password" type="password" disabled="@_awaitingCode" />
            </div>
            @if (_awaitingCode)
            {
                <div class="form-field">
                    <label>@AppResources.T("Common_VerificationCode")</label>
                    <InputText class="form-control" @bind-Value="_model.VerificationCode" maxlength="12" autocomplete="one-time-code" />
                </div>
            }
        </div>
        <div class="form-actions" style="margin-top: 1rem;">
            <button class="btn btn-primary btn-block" type="submit" disabled="@_busy">
                @(_busy ? AppResources.T("Common_PleaseWait") : _awaitingCode ? AppResources.T("Common_VerifyAndSignIn") : AppResources.T("Common_SignIn"))
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Inject] private IEmailAuthService EmailAuth { get; set; } = default!;
    [Inject] private IOpsAuthService Auth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private readonly SignInModel _model = new();
    private bool _busy;
    private bool _awaitingCode;
    private string? _error;
    private string? _status;
    private string _returnUrl = "/fleet";

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (string.IsNullOrEmpty(uri.Query))
            return;

        foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2
                && string.Equals(pair[0], "returnUrl", StringComparison.OrdinalIgnoreCase)
                && IsSafeReturnUrl(Uri.UnescapeDataString(pair[1])))
            {
                _returnUrl = Uri.UnescapeDataString(pair[1]);
                break;
            }
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _status = null;

        var code = _awaitingCode ? VerificationCodeText.NormalizeOrNull(_model.VerificationCode) : null;
        var response = await EmailAuth.SignInProfessionalAsync(_model.Email.Trim(), _model.Password, code);
        _busy = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_SignInFailed");
            return;
        }

        if (response.Data.RequiresVerification)
        {
            _awaitingCode = true;
            _status = AppResources.T("Common_VerificationCodeSentEmail");
            return;
        }

        if (string.IsNullOrWhiteSpace(response.Data.Token))
        {
            _error = AppResources.T("Common_SignInFailed");
            return;
        }

        await Auth.StoreSessionAsync(response.Data.Token);
        Navigation.NavigateTo(_returnUrl, replace: true);
    }

    private static bool IsSafeReturnUrl(string url) =>
        !string.IsNullOrWhiteSpace(url)
        && url.StartsWith("/", StringComparison.Ordinal)
        && !url.StartsWith("//", StringComparison.Ordinal);

    private sealed class SignInModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string VerificationCode { get; set; } = string.Empty;
    }
}
