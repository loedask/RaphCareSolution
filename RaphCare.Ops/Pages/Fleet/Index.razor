@page "/fleet"
@implements IAsyncDisposable
@using System.Text.Json
<PageTitle>@AppResources.T("Fleet_PageTitle")</PageTitle>

<section class="admin-page admin-brand-page">
    <AdminPageHeader CssClass="brand-hero"
                     Eyebrow="@AppResources.T("OpsLayout_NavSection")"
                     Title="@AppResources.T("Fleet_Title")"
                     Lead="@AppResources.T("Fleet_Lead")" />

    @if (_loading)
    {
        <p class="admin-loading-copy">@AppResources.T("Common_Loading")</p>
    }
    else if (_authRequired)
    {
        <AdminEmptyState CssClass="admin-guidance-state"
                         Title="@AppResources.T("Fleet_AuthTitle")"
                         Lead="@AppResources.T("Fleet_AuthLead")">
            <div class="admin-guidance-actions">
                <a class="btn btn-primary" href="@_signInReturnUrl">@AppResources.T("Common_SignInAgain")</a>
            </div>
        </AdminEmptyState>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <AdminAlert Message="@_error" />
        }

        <AdminPageCard Title="@AppResources.T("Fleet_AddTitle")" Lead="@AppResources.T("Fleet_AddLead")">
            <div class="admin-page-card-body">
                <div class="fleet-add-form">
                    <div class="fleet-add-grid">
                        <div class="fleet-add-field">
                            <span class="fleet-add-label">@AppResources.T("Common_Hospitals")</span>
                            <SearchableSelect TValue="string"
                                              Placeholder="@AppResources.T("Fleet_SelectHospital")"
                                              Value="_newClinicId"
                                              ValueChanged="OnNewClinicChanged"
                                              Options="HospitalSelectOptions" />
                        </div>
                        <label class="fleet-add-field">
                            <span class="fleet-add-label">@AppResources.T("Fleet_SerialLabel")</span>
                            <input class="form-control"
                                   @bind="_newSerial"
                                   @bind:event="oninput"
                                   placeholder="@AppResources.T("Fleet_SerialPlaceholder")"
                                   autocomplete="off"
                                   spellcheck="false" />
                        </label>
                        <label class="fleet-add-field">
                            <span class="fleet-add-label">@AppResources.T("Fleet_MacLabel")</span>
                            <input class="form-control"
                                   @bind="_newMac"
                                   @bind:event="oninput"
                                   placeholder="@AppResources.T("Fleet_MacPlaceholder")"
                                   autocomplete="off"
                                   spellcheck="false" />
                        </label>
                        <div class="fleet-add-field fleet-add-field-span">
                            <span class="fleet-add-label">@AppResources.T("Fleet_ModelLabel")</span>
                            <div class="fleet-model-radios" role="radiogroup" aria-label="@AppResources.T("Fleet_ModelLabel")">
                                @foreach (var model in FleetModels)
                                {
                                    <label class="fleet-model-radio @(_newModel == model ? "selected" : null)">
                                        <input type="radio"
                                               name="fleet-add-model"
                                               value="@model"
                                               checked="@(_newModel == model)"
                                               @onchange="() => _newModel = model" />
                                        <span>@model</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="fleet-add-actions">
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@(_saving || string.IsNullOrWhiteSpace(_newClinicId) || string.IsNullOrWhiteSpace(_newSerial))"
                                @onclick="AddDeviceAsync">
                            @(_saving ? AppResources.T("Common_Saving") : AppResources.T("Fleet_AddButton"))
                        </button>
                    </div>

                    <div class="fleet-scan-panel">
                        <div class="fleet-scan-panel-head">
                            <span class="fleet-scan-panel-title">@AppResources.T("Fleet_ScanToolsTitle")</span>
                            <p class="fleet-scan-hint">@AppResources.T("Fleet_ScanPrivacy")</p>
                        </div>
                        <div class="fleet-scan-actions">
                            <button type="button"
                                    class="btn btn-secondary fleet-scan-btn"
                                    disabled="@(_cameraMode is not null || _extracting)"
                                    @onclick="StartBarcodeScanAsync">
                                @AppResources.T("Fleet_ScanBarcode")
                            </button>
                            <button type="button"
                                    class="btn btn-secondary fleet-scan-btn"
                                    disabled="@(_cameraMode is not null || _extracting)"
                                    @onclick="StartTakePictureAsync">
                                @AppResources.T("Fleet_TakePicture")
                            </button>
                            <button type="button"
                                    class="btn btn-secondary fleet-scan-btn"
                                    disabled="@(_cameraMode is not null || _extracting)"
                                    @onclick="TriggerPhotoPick">
                                @(_extracting ? AppResources.T("Fleet_ScanExtracting") : AppResources.T("Fleet_ExtractPhoto"))
                            </button>
                            <input id="@PhotoInputId"
                                   type="file"
                                   accept="image/*"
                                   hidden
                                   @onchange="OnPhotoSelectedAsync" />
                        </div>

                        @if (_scanCandidates.Count > 0)
                        {
                            <div class="fleet-scan-candidates">
                                <span class="fleet-scan-candidates-label">@AppResources.T("Fleet_ScanCandidates")</span>
                                <div class="fleet-scan-candidate-list">
                                    @foreach (var candidate in _scanCandidates)
                                    {
                                        <button type="button"
                                                class="fleet-scan-candidate"
                                                @onclick="() => ApplyCandidate(candidate)">
                                            <span class="fleet-scan-candidate-kind">@CandidateKindLabel(candidate.Kind)</span>
                                            @candidate.Value
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_addError))
                    {
                        <p class="claim-error">@_addError</p>
                    }
                    @if (!string.IsNullOrEmpty(_addSuccess))
                    {
                        <p class="fleet-add-feedback">@_addSuccess</p>
                    }
                    @if (!string.IsNullOrEmpty(_scanMacHint))
                    {
                        <p class="fleet-add-feedback">@_scanMacHint</p>
                    }
                </div>
            </div>
        </AdminPageCard>

        <AdminPageCard Title="@AppResources.T("Fleet_StockTitle")">
            <AdminPageCardMeta>
                <span class="admin-progress-pill">@AppResources.Format("Fleet_TotalMeta", _totalCount)</span>
            </AdminPageCardMeta>
            <div class="admin-page-card-body">
                <div class="fleet-stock-toolbar">
                    <div class="fleet-add-field">
                        <span class="fleet-add-label">@AppResources.T("Common_Hospitals")</span>
                        <SearchableSelect TValue="string"
                                          Placeholder="@AppResources.T("Fleet_AllHospitals")"
                                          Value="_filterClinicId"
                                          ValueChanged="OnFilterClinicChangedAsync"
                                          Options="HospitalFilterOptions" />
                    </div>
                    <label class="fleet-add-field">
                        <span class="fleet-add-label">@AppResources.T("Fleet_SerialFilterLabel")</span>
                        <input class="form-control"
                               @bind="_filterSerial"
                               @bind:event="oninput"
                               @bind:after="ReloadListAsync"
                               placeholder="@AppResources.T("Fleet_SerialPlaceholder")"
                               autocomplete="off"
                               spellcheck="false" />
                    </label>
                    <label class="admin-checkbox fleet-stock-checkbox">
                        <input type="checkbox" @bind="_unassignedOnly" @bind:after="ReloadListAsync" />
                        @AppResources.T("Fleet_UnassignedOnly")
                    </label>
                </div>

                @if (_devices.Count == 0)
                {
                    <p class="text-muted">@(_unassignedOnly ? AppResources.T("Fleet_EmptyUnassignedOnly") : AppResources.T("Fleet_EmptyStock"))</p>
                }
                else
                {
                    <div class="admin-table-wrap">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Hospitals")</th>
                                    <th>@AppResources.T("Fleet_SerialLabel")</th>
                                    <th>@AppResources.T("Fleet_ModelLabel")</th>
                                    <th>@AppResources.T("Fleet_MacLabel")</th>
                                    <th>@AppResources.T("Fleet_ActivatedLabel")</th>
                                    <th>Status</th>
                                    <th>@AppResources.T("Fleet_ActionsColumn")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in _devices)
                                {
                                    <tr>
                                        <td>@ClinicName(device.ClinicId)</td>
                                        <td>@device.SerialNumber</td>
                                        <td>@device.Model</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(device.BluetoothMacAddress))
                                            {
                                                <span class="text-muted">@AppResources.T("Fleet_MacNotSet")</span>
                                            }
                                            else
                                            {
                                                <code>@device.BluetoothMacAddress</code>
                                            }
                                        </td>
                                        <td>
                                            @(device.ActivatedAt is DateTime activated
                                                ? activated.ToString("yyyy-MM-dd")
                                                : AppResources.T("Fleet_MacNotSet"))
                                        </td>
                                        <td>
                                            @(string.IsNullOrWhiteSpace(device.Status) ? (device.IsAssigned ? AppResources.T("Fleet_StatusAssigned") : AppResources.T("Fleet_StatusInStock")) : device.Status)
                                        </td>
                                        <td>
                                            <div class="claim-form-row" style="flex-wrap: wrap; gap: 0.5rem; align-items: center;">
                                                @if (device.IsAssigned)
                                                {
                                                    <span class="text-muted">@AppResources.T("Fleet_AlreadyAssigned")</span>
                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            disabled="@(_busyDeviceId == device.Id)"
                                                            @onclick="() => RevokeAsync(device)">
                                                        @(_busyDeviceId == device.Id ? AppResources.T("Common_Saving") : AppResources.T("Fleet_RevokeButton"))
                                                    </button>
                                                }
                                                else
                                                {
                                                    <SearchableSelect TValue="string"
                                                                      CssClass="fleet-assign-select"
                                                                      Placeholder="@AppResources.T("Fleet_SelectPatient")"
                                                                      Value="@GetAssignPatient(device.Id)"
                                                                      ValueChanged="v => SetAssignPatient(device.Id, v)"
                                                                      Options="PatientSelectOptions(device.ClinicId)" />
                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            disabled="@(_busyDeviceId == device.Id || string.IsNullOrWhiteSpace(GetAssignPatient(device.Id)))"
                                                            @onclick="() => AssignAsync(device)">
                                                        @(_busyDeviceId == device.Id ? AppResources.T("Common_Saving") : AppResources.T("Fleet_AssignButton"))
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-ghost"
                                                            disabled="@(_busyDeviceId == device.Id)"
                                                            @onclick="() => DeleteAsync(device)">
                                                        @(_busyDeviceId == device.Id ? AppResources.T("Common_Saving") : AppResources.T("Fleet_DeleteButton"))
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </AdminPageCard>
    }
</section>

@if (_cameraMode is not null)
{
    <div class="qr-scan-overlay">
        <video id="fleet-scan-video" autoplay playsinline muted></video>
        <div class="qr-scan-overlay-actions">
            @if (_cameraMode == "photo")
            {
                <button type="button"
                        class="btn btn-primary"
                        disabled="@_extracting"
                        @onclick="CapturePictureAsync">
                    @(_extracting ? AppResources.T("Fleet_ScanExtracting") : AppResources.T("Fleet_CaptureFrame"))
                </button>
                <button type="button" class="btn btn-secondary" disabled="@_extracting" @onclick="StopCameraAsync">
                    @AppResources.T("Fleet_CancelCamera")
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" @onclick="StopCameraAsync">
                    @AppResources.T("Fleet_StopScan")
                </button>
            }
        </div>
    </div>
}

@code {
    private const string FleetPath = "/fleet";
    private const string PhotoInputId = "fleet-scan-file";

    private static readonly string[] FleetModels = ["E585", "E580", "Y6 Pro"];

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    [Inject] private IPlatformFleetDevicesService FleetService { get; set; } = default!;
    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;
    private string? _cameraMode;
    private bool _extracting;
    private bool _authRequired;
    private bool _unassignedOnly;
    private Guid? _busyDeviceId;
    private string? _error;
    private string? _addError;
    private string? _addSuccess;
    private string? _scanMacHint;
    private string _newClinicId = string.Empty;
    private string _newSerial = string.Empty;
    private string _newMac = string.Empty;
    private string _newModel = "E585";
    private string _filterClinicId = string.Empty;
    private string _filterSerial = string.Empty;
    private int _totalCount;
    private IReadOnlyList<ClinicListItem> _clinics = Array.Empty<ClinicListItem>();
    private IReadOnlyList<FleetDeviceListItem> _devices = Array.Empty<FleetDeviceListItem>();
    private IReadOnlyList<FleetDeviceScanParser.Candidate> _scanCandidates = Array.Empty<FleetDeviceScanParser.Candidate>();
    private readonly Dictionary<Guid, IReadOnlyList<ClinicPatientListItem>> _patientsByClinic = new();
    private readonly Dictionary<Guid, string> _assignPatientByDevice = new();
    private DotNetObjectReference<Index>? _jsSelf;

    private string _signInReturnUrl =>
        $"/signin?returnUrl={Uri.EscapeDataString(FleetPath)}";

    private IReadOnlyList<SelectOption<string>> HospitalSelectOptions =>
        _clinics.Select(c => new SelectOption<string>(c.Id.ToString(), c.Name)).ToArray();

    private IReadOnlyList<SelectOption<string>> HospitalFilterOptions =>
        new[] { new SelectOption<string>(string.Empty, AppResources.T("Fleet_AllHospitals")) }
            .Concat(HospitalSelectOptions)
            .ToArray();

    private IReadOnlyList<SelectOption<string>> PatientSelectOptions(Guid clinicId) =>
        PatientsForClinic(clinicId)
            .Select(p => new SelectOption<string>(p.PatientId.ToString(), $"{p.FirstName} {p.LastName}"))
            .ToArray();

    private void OnNewClinicChanged(string? value) =>
        _newClinicId = value ?? string.Empty;

    private async Task OnFilterClinicChangedAsync(string? value)
    {
        _filterClinicId = value ?? string.Empty;
        await ReloadListAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var clinicsResponse = await AdminClinicService.GetClinicsAsync();
        if (!clinicsResponse.IsSuccess || clinicsResponse.Data is null)
        {
            _loading = false;
            _error = clinicsResponse.ErrorMessage ?? AppResources.T("Common_CouldNotLoadHospitals");
            _authRequired = clinicsResponse.StatusCode is 401 or 403;
            return;
        }

        _clinics = clinicsResponse.Data;
        await ReloadListAsync();
        _loading = false;
    }

    private async Task ReloadListAsync()
    {
        _error = null;
        Guid? clinicFilter = Guid.TryParse(_filterClinicId, out var clinicId) ? clinicId : null;
        var response = await FleetService.GetDevicesAsync(
            pageNumber: 1,
            pageSize: 100,
            clinicId: clinicFilter,
            unassignedOnly: _unassignedOnly ? true : null,
            serialContains: string.IsNullOrWhiteSpace(_filterSerial) ? null : _filterSerial.Trim());

        if (!response.IsSuccess || response.Data is null)
        {
            _devices = Array.Empty<FleetDeviceListItem>();
            _totalCount = 0;
            _error = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotLoad");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        _devices = response.Data.Items;
        _totalCount = response.Data.TotalCount;
        foreach (var device in _devices.Where(d => !d.IsAssigned))
        {
            if (!_assignPatientByDevice.ContainsKey(device.Id))
                _assignPatientByDevice[device.Id] = string.Empty;
            await EnsurePatientsLoadedAsync(device.ClinicId);
        }
    }

    private async Task EnsurePatientsLoadedAsync(Guid clinicId)
    {
        if (_patientsByClinic.ContainsKey(clinicId))
            return;

        var response = await AdminClinicService.GetPatientsAsync(clinicId, pageNumber: 1, pageSize: 100);
        _patientsByClinic[clinicId] = response.IsSuccess && response.Data?.Items is not null
            ? response.Data.Items
            : Array.Empty<ClinicPatientListItem>();
    }

    private IReadOnlyList<ClinicPatientListItem> PatientsForClinic(Guid clinicId) =>
        _patientsByClinic.TryGetValue(clinicId, out var list) ? list : Array.Empty<ClinicPatientListItem>();

    private string ClinicName(Guid clinicId) =>
        _clinics.FirstOrDefault(c => c.Id == clinicId)?.Name ?? clinicId.ToString("N")[..8];

    private string GetAssignPatient(Guid deviceId) =>
        _assignPatientByDevice.TryGetValue(deviceId, out var value) ? value : string.Empty;

    private void SetAssignPatient(Guid deviceId, string? patientId) =>
        _assignPatientByDevice[deviceId] = patientId ?? string.Empty;

    private async Task AddDeviceAsync()
    {
        _addError = null;
        _addSuccess = null;
        _scanMacHint = null;
        if (!Guid.TryParse(_newClinicId, out var clinicId) || string.IsNullOrWhiteSpace(_newSerial))
        {
            _addError = AppResources.T("Fleet_AddValidation");
            return;
        }

        _saving = true;
        var response = await FleetService.CreateDeviceAsync(
            clinicId,
            _newSerial.Trim(),
            _newModel,
            string.IsNullOrWhiteSpace(_newMac) ? null : _newMac.Trim());
        _saving = false;

        if (!response.IsSuccess)
        {
            _addError = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotAdd");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        _addSuccess = AppResources.Format("Fleet_AddedFormat", _newSerial.Trim());
        _newSerial = string.Empty;
        _newMac = string.Empty;
        _scanCandidates = Array.Empty<FleetDeviceScanParser.Candidate>();
        await ReloadListAsync();
    }

    private async Task AssignAsync(FleetDeviceListItem device)
    {
        if (!Guid.TryParse(GetAssignPatient(device.Id), out var patientId))
            return;

        _busyDeviceId = device.Id;
        _error = null;
        var response = await FleetService.AssignDeviceToPatientAsync(device.Id, patientId);
        _busyDeviceId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotAssign");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        await ReloadListAsync();
    }

    private async Task RevokeAsync(FleetDeviceListItem device)
    {
        var confirmed = await Js.InvokeAsync<bool>(
            "confirm",
            AppResources.Format("Fleet_RevokeConfirmFormat", device.SerialNumber));
        if (!confirmed)
            return;

        _busyDeviceId = device.Id;
        _error = null;
        var response = await FleetService.UnassignDeviceFromPatientAsync(device.Id);
        _busyDeviceId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotRevoke");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        await ReloadListAsync();
    }

    private async Task DeleteAsync(FleetDeviceListItem device)
    {
        var confirmed = await Js.InvokeAsync<bool>(
            "confirm",
            AppResources.Format("Fleet_DeleteConfirmFormat", device.SerialNumber));
        if (!confirmed)
            return;

        _busyDeviceId = device.Id;
        _error = null;
        var response = await FleetService.DeleteDeviceAsync(device.Id);
        _busyDeviceId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotDelete");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        await ReloadListAsync();
    }

    private async Task StartBarcodeScanAsync()
    {
        _addError = null;
        _addSuccess = null;
        _scanMacHint = null;
        _cameraMode = "barcode";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);
        _jsSelf ??= DotNetObjectReference.Create(this);
        var started = false;
        try
        {
            started = await Js.InvokeAsync<bool>("raphCareOpsFleet.startBarcodeScan", _jsSelf);
        }
        catch
        {
            started = false;
        }

        if (!started)
        {
            _cameraMode = null;
            _addError = AppResources.T("Fleet_ScanUnsupported");
        }
    }

    private async Task StartTakePictureAsync()
    {
        _addError = null;
        _addSuccess = null;
        _scanMacHint = null;
        _cameraMode = "photo";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);
        var started = false;
        try
        {
            started = await Js.InvokeAsync<bool>("raphCareOpsFleet.startLiveCamera");
        }
        catch
        {
            started = false;
        }

        if (!started)
        {
            _cameraMode = null;
            _addError = AppResources.T("Fleet_CameraUnsupported");
        }
    }

    private async Task StopCameraAsync()
    {
        _cameraMode = null;
        try
        {
            await Js.InvokeVoidAsync("raphCareOpsFleet.stopAllCameras");
        }
        catch
        {
            // Overlay is already closing.
        }
    }

    private async Task CapturePictureAsync()
    {
        _addError = null;
        _addSuccess = null;
        _scanMacHint = null;
        _extracting = true;
        await InvokeAsync(StateHasChanged);

        var dto = await ExtractFromJsAsync("raphCareOpsFleet.captureAndExtract");
        _extracting = false;
        _cameraMode = null;
        ApplyExtractDto(dto);
    }

    [JSInvokable]
    public async Task OnFleetBarcodeDetected(string value)
    {
        _cameraMode = null;
        ApplyParseResult(FleetDeviceScanParser.ParseBarcode(value), fromBarcode: true);
        await InvokeAsync(StateHasChanged);
    }

    private async Task TriggerPhotoPick()
    {
        _addError = null;
        _addSuccess = null;
        _scanMacHint = null;
        try
        {
            var opened = await Js.InvokeAsync<bool>("raphCareOpsFleet.clickFileInput", PhotoInputId);
            if (!opened)
                _addError = AppResources.T("Fleet_ScanFailed");
        }
        catch
        {
            _addError = AppResources.T("Fleet_ScanFailed");
        }
    }

    private async Task OnPhotoSelectedAsync(ChangeEventArgs _)
    {
        _addError = null;
        _addSuccess = null;
        _scanMacHint = null;

        // Start JS immediately so the File is snapshotted before any re-render clears the input.
        var extractTask = ExtractFromJsAsync("raphCareOpsFleet.extractFromFileInput", PhotoInputId);
        _extracting = true;
        await InvokeAsync(StateHasChanged);

        var dto = await extractTask;
        _extracting = false;
        ApplyExtractDto(dto);
    }

    private async Task<FleetPhotoExtractDto?> ExtractFromJsAsync(string identifier, params object?[] args)
    {
        try
        {
            var raw = await Js.InvokeAsync<string>(identifier, args);
            if (string.IsNullOrWhiteSpace(raw))
                return null;
            return JsonSerializer.Deserialize<FleetPhotoExtractDto>(raw, JsonOptions);
        }
        catch
        {
            return null;
        }
    }

    private void ApplyExtractDto(FleetPhotoExtractDto? dto)
    {
        if (dto is null || !dto.Ok)
        {
            _addError = dto?.Error switch
            {
                "nofile" => AppResources.T("Fleet_ScanNoFile"),
                "busy" => AppResources.T("Fleet_ScanBusy"),
                "nocamera" => AppResources.T("Fleet_CameraUnsupported"),
                "ocrload" => AppResources.T("Fleet_ScanOcrLoadFailed"),
                "ocrfail" or "imgload" => AppResources.T("Fleet_ScanOcrFailed"),
                _ => AppResources.T("Fleet_ScanFailed")
            };
            return;
        }

        if (dto.Barcodes is { Count: > 0 })
        {
            ApplyParseResult(FleetDeviceScanParser.ParseBarcode(dto.Barcodes[0]), fromBarcode: true);
            return;
        }

        ApplyParseResult(FleetDeviceScanParser.Parse(dto.Text), fromBarcode: false);
    }

    private void ApplyParseResult(FleetDeviceScanParser.Result result, bool fromBarcode)
    {
        _scanCandidates = result.Candidates;
        if (!string.IsNullOrWhiteSpace(result.SuggestedModel)
            && FleetModels.Contains(result.SuggestedModel, StringComparer.Ordinal))
        {
            _newModel = result.SuggestedModel;
        }

        if (string.IsNullOrWhiteSpace(result.PreferredValue))
        {
            _addError = AppResources.T("Fleet_ScanNothingFound");
            _scanMacHint = null;
            return;
        }

        if (result.PreferredLooksLikeMac)
        {
            _newMac = result.PreferredValue;
            _scanMacHint = fromBarcode ? null : AppResources.T("Fleet_ScanMacHint");
        }
        else
        {
            _newSerial = result.PreferredValue;
            _scanMacHint = null;
        }

        _addSuccess = AppResources.T("Fleet_ScanFound");
    }

    private void ApplyCandidate(FleetDeviceScanParser.Candidate candidate)
    {
        if (string.Equals(candidate.Kind, "Mac", StringComparison.OrdinalIgnoreCase))
        {
            _newMac = candidate.Value;
            _scanMacHint = AppResources.T("Fleet_ScanMacHint");
        }
        else
        {
            _newSerial = candidate.Value;
            _scanMacHint = null;
        }

        _addSuccess = AppResources.T("Fleet_ScanFound");
        _addError = null;
    }

    private static string CandidateKindLabel(string kind) =>
        string.Equals(kind, "Mac", StringComparison.OrdinalIgnoreCase)
            ? AppResources.T("Fleet_CandidateMac")
            : AppResources.T("Fleet_CandidateSerial");

    public async ValueTask DisposeAsync()
    {
        if (_cameraMode is not null)
        {
            try
            {
                await Js.InvokeVoidAsync("raphCareOpsFleet.stopAllCameras");
            }
            catch
            {
                // Page is leaving.
            }
        }

        _jsSelf?.Dispose();
    }

    private sealed class FleetPhotoExtractDto
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
        public string? Text { get; set; }
        public List<string>? Barcodes { get; set; }
    }
}
