@page "/fleet"
<PageTitle>@AppResources.T("Fleet_PageTitle")</PageTitle>

<section class="admin-page admin-brand-page">
    <AdminPageHeader CssClass="brand-hero"
                     Eyebrow="@AppResources.T("OpsLayout_NavSection")"
                     Title="@AppResources.T("Fleet_Title")"
                     Lead="@AppResources.T("Fleet_Lead")" />

    @if (_loading)
    {
        <p class="admin-loading-copy">@AppResources.T("Common_Loading")</p>
    }
    else if (_authRequired)
    {
        <AdminEmptyState CssClass="admin-guidance-state"
                         Title="@AppResources.T("Fleet_AuthTitle")"
                         Lead="@AppResources.T("Fleet_AuthLead")">
            <div class="admin-guidance-actions">
                <a class="btn btn-primary" href="@_signInReturnUrl">@AppResources.T("Common_SignInAgain")</a>
            </div>
        </AdminEmptyState>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <AdminAlert Message="@_error" />
        }

        <AdminPageCard Title="@AppResources.T("Fleet_AddTitle")" Lead="@AppResources.T("Fleet_AddLead")">
            <div class="admin-page-card-body">
                <div class="claim-form">
                    <div class="claim-form-row" style="flex-wrap: wrap; gap: 0.75rem;">
                        <label>
                            @AppResources.T("Common_Hospitals")
                            <select class="form-control" @bind="_newClinicId">
                                <option value="">@AppResources.T("Fleet_SelectHospital")</option>
                                @foreach (var clinic in _clinics)
                                {
                                    <option value="@clinic.Id">@clinic.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            @AppResources.T("Fleet_SerialLabel")
                            <input class="form-control" @bind="_newSerial" @bind:event="oninput" placeholder="@AppResources.T("Fleet_SerialPlaceholder")" />
                        </label>
                        <div class="fleet-model-field">
                            <span class="fleet-model-label">@AppResources.T("Fleet_ModelLabel")</span>
                            <div class="fleet-model-radios" role="radiogroup" aria-label="@AppResources.T("Fleet_ModelLabel")">
                                @foreach (var model in FleetModels)
                                {
                                    <label class="fleet-model-radio @(_newModel == model ? "selected" : null)">
                                        <input type="radio"
                                               name="fleet-add-model"
                                               value="@model"
                                               checked="@(_newModel == model)"
                                               @onchange="() => _newModel = model" />
                                        <span>@model</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <button type="button"
                                class="btn btn-primary"
                                disabled="@(_saving || string.IsNullOrWhiteSpace(_newClinicId) || string.IsNullOrWhiteSpace(_newSerial))"
                                @onclick="AddDeviceAsync">
                            @(_saving ? AppResources.T("Common_Saving") : AppResources.T("Fleet_AddButton"))
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_addError))
                    {
                        <p class="claim-error">@_addError</p>
                    }
                    @if (!string.IsNullOrEmpty(_addSuccess))
                    {
                        <p class="text-muted">@_addSuccess</p>
                    }
                </div>
            </div>
        </AdminPageCard>

        <AdminPageCard Title="@AppResources.T("Fleet_StockTitle")">
            <AdminPageCardMeta>
                <span class="admin-progress-pill">@AppResources.Format("Fleet_TotalMeta", _totalCount)</span>
            </AdminPageCardMeta>
            <div class="admin-page-card-body">
                <div class="claim-form-row" style="flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
                    <label>
                        @AppResources.T("Common_Hospitals")
                        <select class="form-control" @bind="_filterClinicId" @bind:after="ReloadListAsync">
                            <option value="">@AppResources.T("Fleet_AllHospitals")</option>
                            @foreach (var clinic in _clinics)
                            {
                                <option value="@clinic.Id">@clinic.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        @AppResources.T("Fleet_SerialFilterLabel")
                        <input class="form-control" @bind="_filterSerial" @bind:event="oninput" @bind:after="ReloadListAsync" placeholder="@AppResources.T("Fleet_SerialPlaceholder")" />
                    </label>
                    <label class="admin-checkbox">
                        <input type="checkbox" @bind="_unassignedOnly" @bind:after="ReloadListAsync" />
                        @AppResources.T("Fleet_UnassignedOnly")
                    </label>
                </div>

                @if (_devices.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Fleet_EmptyStock")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Fleet_SerialLabel")</th>
                                    <th>@AppResources.T("Fleet_ModelLabel")</th>
                                    <th>@AppResources.T("Common_Hospitals")</th>
                                    <th>@AppResources.T("Common_Status")</th>
                                    <th>@AppResources.T("Fleet_AssignColumn")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in _devices)
                                {
                                    <tr>
                                        <td><code>@device.SerialNumber</code></td>
                                        <td>@device.Model</td>
                                        <td>@ClinicName(device.ClinicId)</td>
                                        <td>
                                            <span class="badge @(device.IsAssigned ? "badge-success" : "badge-muted")">
                                                @(string.IsNullOrWhiteSpace(device.Status) ? (device.IsAssigned ? AppResources.T("Fleet_StatusAssigned") : AppResources.T("Fleet_StatusInStock")) : device.Status)
                                            </span>
                                        </td>
                                        <td>
                                            @if (device.IsAssigned)
                                            {
                                                <span class="text-muted">@AppResources.T("Fleet_AlreadyAssigned")</span>
                                            }
                                            else
                                            {
                                                <div class="claim-form-row" style="gap: 0.5rem; flex-wrap: wrap;">
                                                    <select class="form-control"
                                                            value="@GetAssignPatient(device.Id)"
                                                            @onchange="e => SetAssignPatient(device.Id, e.Value?.ToString())">
                                                        <option value="">@AppResources.T("Fleet_SelectPatient")</option>
                                                        @foreach (var patient in PatientsForClinic(device.ClinicId))
                                                        {
                                                            <option value="@patient.PatientId">@patient.FirstName @patient.LastName</option>
                                                        }
                                                    </select>
                                                    <button type="button"
                                                            class="btn btn-secondary btn-sm"
                                                            disabled="@(_assigningDeviceId == device.Id || string.IsNullOrWhiteSpace(GetAssignPatient(device.Id)))"
                                                            @onclick="() => AssignAsync(device)">
                                                        @(_assigningDeviceId == device.Id ? AppResources.T("Common_Saving") : AppResources.T("Fleet_AssignButton"))
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </AdminPageCard>
    }
</section>

@code {
    private const string FleetPath = "/fleet";

    private static readonly string[] FleetModels = ["E585", "E580", "Y6 Pro"];

    [Inject] private IPlatformFleetDevicesService FleetService { get; set; } = default!;
    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;
    private bool _authRequired;
    private bool _unassignedOnly = true;
    private Guid? _assigningDeviceId;
    private string? _error;
    private string? _addError;
    private string? _addSuccess;
    private string _newClinicId = string.Empty;
    private string _newSerial = string.Empty;
    private string _newModel = "E585";
    private string _filterClinicId = string.Empty;
    private string _filterSerial = string.Empty;
    private int _totalCount;
    private IReadOnlyList<ClinicListItem> _clinics = Array.Empty<ClinicListItem>();
    private IReadOnlyList<FleetDeviceListItem> _devices = Array.Empty<FleetDeviceListItem>();
    private readonly Dictionary<Guid, IReadOnlyList<ClinicPatientListItem>> _patientsByClinic = new();
    private readonly Dictionary<Guid, string> _assignPatientByDevice = new();

    private string _signInReturnUrl =>
        $"/signin?returnUrl={Uri.EscapeDataString(FleetPath)}";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var clinicsResponse = await AdminClinicService.GetClinicsAsync();
        if (!clinicsResponse.IsSuccess || clinicsResponse.Data is null)
        {
            _loading = false;
            _error = clinicsResponse.ErrorMessage ?? AppResources.T("Common_CouldNotLoadHospitals");
            _authRequired = clinicsResponse.StatusCode is 401 or 403;
            return;
        }

        _clinics = clinicsResponse.Data;
        await ReloadListAsync();
        _loading = false;
    }

    private async Task ReloadListAsync()
    {
        _error = null;
        Guid? clinicFilter = Guid.TryParse(_filterClinicId, out var clinicId) ? clinicId : null;
        var response = await FleetService.GetDevicesAsync(
            pageNumber: 1,
            pageSize: 100,
            clinicId: clinicFilter,
            unassignedOnly: _unassignedOnly ? true : null,
            serialContains: string.IsNullOrWhiteSpace(_filterSerial) ? null : _filterSerial.Trim());

        if (!response.IsSuccess || response.Data is null)
        {
            _devices = Array.Empty<FleetDeviceListItem>();
            _totalCount = 0;
            _error = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotLoad");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        _devices = response.Data.Items;
        _totalCount = response.Data.TotalCount;
        foreach (var device in _devices.Where(d => !d.IsAssigned))
        {
            if (!_assignPatientByDevice.ContainsKey(device.Id))
                _assignPatientByDevice[device.Id] = string.Empty;
            await EnsurePatientsLoadedAsync(device.ClinicId);
        }
    }

    private async Task EnsurePatientsLoadedAsync(Guid clinicId)
    {
        if (_patientsByClinic.ContainsKey(clinicId))
            return;

        var response = await AdminClinicService.GetPatientsAsync(clinicId, pageNumber: 1, pageSize: 100);
        _patientsByClinic[clinicId] = response.IsSuccess && response.Data?.Items is not null
            ? response.Data.Items
            : Array.Empty<ClinicPatientListItem>();
    }

    private IReadOnlyList<ClinicPatientListItem> PatientsForClinic(Guid clinicId) =>
        _patientsByClinic.TryGetValue(clinicId, out var list) ? list : Array.Empty<ClinicPatientListItem>();

    private string ClinicName(Guid clinicId) =>
        _clinics.FirstOrDefault(c => c.Id == clinicId)?.Name ?? clinicId.ToString("N")[..8];

    private string GetAssignPatient(Guid deviceId) =>
        _assignPatientByDevice.TryGetValue(deviceId, out var value) ? value : string.Empty;

    private void SetAssignPatient(Guid deviceId, string? patientId) =>
        _assignPatientByDevice[deviceId] = patientId ?? string.Empty;

    private async Task AddDeviceAsync()
    {
        _addError = null;
        _addSuccess = null;
        if (!Guid.TryParse(_newClinicId, out var clinicId) || string.IsNullOrWhiteSpace(_newSerial))
        {
            _addError = AppResources.T("Fleet_AddValidation");
            return;
        }

        _saving = true;
        var response = await FleetService.CreateDeviceAsync(clinicId, _newSerial.Trim(), _newModel);
        _saving = false;

        if (!response.IsSuccess)
        {
            _addError = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotAdd");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        _addSuccess = AppResources.Format("Fleet_AddedFormat", _newSerial.Trim());
        _newSerial = string.Empty;
        await ReloadListAsync();
    }

    private async Task AssignAsync(FleetDeviceListItem device)
    {
        if (!Guid.TryParse(GetAssignPatient(device.Id), out var patientId))
            return;

        _assigningDeviceId = device.Id;
        _error = null;
        var response = await FleetService.AssignDeviceToPatientAsync(device.Id, patientId);
        _assigningDeviceId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Fleet_CouldNotAssign");
            _authRequired = response.StatusCode is 401 or 403;
            return;
        }

        await ReloadListAsync();
    }

}
