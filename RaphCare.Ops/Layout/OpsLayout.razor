@inherits LayoutComponentBase

<div class="admin-shell admin-shell-hospital">
    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-left">
                <a class="admin-topbar-brand" href="/" title="@AppResources.T("Common_Home")">
                    <div class="admin-brand-icon admin-topbar-brand-icon">+</div>
                    <span class="admin-topbar-brand-title">@AppResources.T("Common_AppName")</span>
                </a>
                <nav class="admin-workspace-nav" aria-label="@AppResources.T("OpsLayout_NavSection")">
                    <NavLink class="admin-ops-nav-link" href="/" Match="NavLinkMatch.All">
                        @AppResources.T("Common_Home")
                    </NavLink>
                    <NavLink class="admin-ops-nav-link" href="/fleet" Match="NavLinkMatch.Prefix">
                        @AppResources.T("Fleet_Nav")
                    </NavLink>
                </nav>
            </div>
            <div class="admin-topbar-right">
                <span class="admin-ops-user-pill">@AppResources.T("OpsLayout_UserRole")</span>
                <button type="button" class="btn btn-ghost admin-topbar-signout" @onclick="SignOutAsync">
                    @AppResources.T("Common_SignOut")
                </button>
            </div>
        </header>

        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

@code {
    [Inject] private IOpsAuthService Auth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("signin", StringComparison.OrdinalIgnoreCase))
            return;

        if (!await Auth.IsSessionValidAsync().ConfigureAwait(true))
        {
            var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            if (string.IsNullOrWhiteSpace(returnUrl) || returnUrl == "/")
                returnUrl = "/fleet";
            Navigation.NavigateTo($"/signin?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
        }
    }

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync().ConfigureAwait(true);
        Navigation.NavigateTo("/signin", replace: true);
    }
}
