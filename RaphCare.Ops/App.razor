<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(OpsLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(OpsLayout)">
            <p class="admin-loading-copy">@AppResources.T("Common_NotFound")</p>
        </LayoutView>
    </NotFound>
</Router>
