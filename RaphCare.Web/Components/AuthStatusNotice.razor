<div class="auth-notice" role="status" aria-live="polite">
    <span class="auth-notice-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
        </svg>
    </span>
    <div class="auth-notice-body">
        <p class="auth-notice-title">@AppResources.T("Common_CodeSentTitle")</p>
        @if (!string.IsNullOrWhiteSpace(Email))
        {
            <p class="auth-notice-email">@AppResources.Format("Common_CodeSentToEmail", Email.Trim())</p>
        }
        <p class="auth-notice-hint">@AppResources.T("Common_CodeSentSpamHint")</p>
    </div>
</div>

@code {
    [Parameter] public string? Email { get; set; }
}
