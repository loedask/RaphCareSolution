<div class="bed-chip-wrap">
    <span class="bed-chip @ToneClass"
          title="@Title"
          role="img"
          aria-label="@(string.IsNullOrWhiteSpace(Title) ? Label : Title)">
        <span class="bed-glyph" aria-hidden="true">
            <span class="bed-glyph-pillow"></span>
            <span class="bed-glyph-mattress">
                <span class="bed-glyph-label">@Label</span>
            </span>
        </span>
        @if (!string.IsNullOrWhiteSpace(Caption))
        {
            <small class="bed-chip-caption">@Caption</small>
        }
    </span>
    @ChildContent
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Tone { get; set; } = "other";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ToneClass => Tone switch
    {
        "occupied" => "bed-chip-occupied",
        "available" => "bed-chip-free",
        "maintenance" => "bed-chip-maintenance",
        _ => "bed-chip-other"
    };
}
