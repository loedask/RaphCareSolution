<div class="hospital-deck-missing">
    <AdminAlert Message="@Message" />
    <a class="btn btn-secondary hospital-deck-back" href="@BackHref">@BackText</a>
</div>

@code {
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string BackHref { get; set; } = "/admin/hospitals";
    [Parameter] public string BackText { get; set; } = string.Empty;
}
