@inject IUiCultureService CultureService
@implements IDisposable

<div class="language-picker" role="group" aria-label="@AppResources.T("Language_Aria")">
    <label class="language-picker-label" for="@_selectId">@AppResources.T("Language_Label")</label>
    <select id="@_selectId"
            class="language-picker-select"
            value="@CultureService.CurrentCode"
            @onchange="OnChangedAsync">
        @foreach (var lang in WebLanguagePreference.SupportedLanguages)
        {
            <option value="@lang.Code">@lang.Native</option>
        }
    </select>
</div>

@code {
    private readonly string _selectId = $"lang-{Guid.NewGuid():N}";

    protected override void OnInitialized() =>
        CultureService.CultureChanged += OnCultureChanged;

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OnChangedAsync(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? "en";
        await CultureService.SetCultureAsync(code);
    }

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;
}
