@page "/admin"
@layout AdminLayout

<PageTitle>RaphCare Admin</PageTitle>

<section class="admin-dashboard">
    <div class="admin-hero">
        <h2>Platform overview</h2>
        <p>Manage hospital onboarding, tenants, and platform configuration.</p>
        <a class="btn btn-primary" href="/admin/hospitals/register">Register a hospital</a>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Loading hospitals…</p>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-label">Registered hospitals</div>
                <div class="stat-value">@_clinics.Count</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active hospitals</div>
                <div class="stat-value">@_clinics.Count(c => c.IsActive)</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total facilities</div>
                <div class="stat-value">@_clinics.Sum(c => c.FacilityCount)</div>
            </div>
        </div>

        @if (_clinics.Count == 0)
        {
            <div class="empty-state">
                <h3>No hospitals yet</h3>
                <p>Start by registering your first hospital through the onboarding wizard.</p>
                <a class="btn btn-secondary" href="/admin/hospitals/register">Start onboarding</a>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <h3>Recent hospitals</h3>
                    <a href="/admin/hospitals">View all</a>
                </div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Country</th>
                            <th>Facilities</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var clinic in _clinics.Take(5))
                        {
                            <tr>
                                <td>@clinic.Name</td>
                                <td>@clinic.Country</td>
                                <td>@clinic.FacilityCount</td>
                                <td>
                                    <span class="badge @(clinic.IsActive ? "badge-success" : "badge-muted")">
                                        @(clinic.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;

    private bool _loading = true;
    private string? _error;
    private IReadOnlyList<ClinicListItem> _clinics = Array.Empty<ClinicListItem>();

    protected override async Task OnInitializedAsync()
    {
        var response = await AdminClinicService.GetClinicsAsync();
        _loading = false;
        if (response.IsSuccess && response.Data is not null)
            _clinics = response.Data;
        else
            _error = response.ErrorMessage ?? "Could not load hospitals.";
    }
}
