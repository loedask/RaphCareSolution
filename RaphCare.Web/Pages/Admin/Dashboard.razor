@page "/admin"
@layout AdminLayout
@using RaphCare.Domain.Common
@implements IDisposable

<PageTitle>RaphCare Admin</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <h1>@(_dashboard?.ClinicName ?? "Platform overview")</h1>
            <p class="admin-page-lead">
                @if (_dashboard is not null)
                {
                    <span>Hospital dashboard for your active context.</span>
                }
                else if (ClinicContext.CurrentClinicId is null && _clinics.Count > 1)
                {
                    <span>Select a hospital from the top bar to see scoped metrics.</span>
                }
                else
                {
                    <span>Manage hospital onboarding and your linked organizations.</span>
                }
            </p>
        </div>
        @if (ClinicContext.CurrentClinicId is Guid clinicId)
        {
            <a class="btn btn-secondary" href="/admin/hospitals/@clinicId">Hospital details</a>
        }
        else
        {
            <a class="btn btn-primary" href="/admin/hospitals/register">+ Register hospital</a>
        }
    </header>

    @if (_loading)
    {
        <p class="text-muted">Loading dashboard…</p>
    }
    else if (_authRequired)
    {
        <div class="empty-state admin-guidance-state">
            <div class="empty-state-icon" aria-hidden="true">⌂</div>
            <h3>Finish registering your hospital</h3>
            <p>Your professional account is ready. Register your hospital to unlock the full clinic portal, or sign in again if your session expired.</p>
            <div class="admin-guidance-actions">
                <a class="btn btn-primary" href="/admin/hospitals/register">Register hospital</a>
                <a class="btn btn-secondary" href="@_signInReturnUrl">Sign in again</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    else if (_dashboard is not null)
    {
        <div class="stat-grid">
            <div class="stat-card stat-card-blue">
                <div class="stat-card-top">
                    <span class="stat-label">Patients</span>
                    <span class="stat-icon" aria-hidden="true">👤</span>
                </div>
                <div class="stat-value">@_dashboard.PatientCount</div>
            </div>
            <div class="stat-card stat-card-green">
                <div class="stat-card-top">
                    <span class="stat-label">Staff</span>
                    <span class="stat-icon" aria-hidden="true">◎</span>
                </div>
                <div class="stat-value">@_dashboard.StaffCount</div>
            </div>
            <div class="stat-card stat-card-violet">
                <div class="stat-card-top">
                    <span class="stat-label">Providers</span>
                    <span class="stat-icon" aria-hidden="true">⚕</span>
                </div>
                <div class="stat-value">@_dashboard.ProviderCount</div>
            </div>
            <div class="stat-card stat-card-blue">
                <div class="stat-card-top">
                    <span class="stat-label">Facilities</span>
                    <span class="stat-icon" aria-hidden="true">⌂</span>
                </div>
                <div class="stat-value">@_dashboard.FacilityCount</div>
            </div>
            <div class="stat-card stat-card-green">
                <div class="stat-card-top">
                    <span class="stat-label">Today</span>
                    <span class="stat-icon" aria-hidden="true">📅</span>
                </div>
                <div class="stat-value">@_dashboard.AppointmentsTodayCount</div>
            </div>
            <div class="stat-card stat-card-violet">
                <div class="stat-card-top">
                    <span class="stat-label">Next 7 days</span>
                    <span class="stat-icon" aria-hidden="true">→</span>
                </div>
                <div class="stat-value">@_dashboard.UpcomingAppointmentsCount</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Upcoming appointments</h3>
                <a class="card-header-link" href="/admin/hospitals/@_dashboard.ClinicId/appointments">View all →</a>
            </div>
            @if (_dashboard.UpcomingAppointments.Count == 0)
            {
                <div class="admin-page-card-body">
                    <p class="text-muted">No upcoming appointments in the next 7 days.</p>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>When</th>
                                <th>Patient</th>
                                <th>Provider</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in _dashboard.UpcomingAppointments)
                            {
                                <tr>
                                    <td>@ClinicTimeZoneHelper.FormatClinicLocal(appt.ScheduledStart, _clinicTimeZone)</td>
                                    <td>@appt.PatientName</td>
                                    <td>@appt.ProviderName</td>
                                    <td>@appt.Type</td>
                                    <td>@appt.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat-card stat-card-blue">
                <div class="stat-card-top">
                    <span class="stat-label">My hospitals</span>
                    <span class="stat-icon" aria-hidden="true">⌂</span>
                </div>
                <div class="stat-value">@_clinics.Count</div>
            </div>
            <div class="stat-card stat-card-green">
                <div class="stat-card-top">
                    <span class="stat-label">Active hospitals</span>
                    <span class="stat-icon" aria-hidden="true">✓</span>
                </div>
                <div class="stat-value">@_clinics.Count(c => c.IsActive)</div>
            </div>
            <div class="stat-card stat-card-violet">
                <div class="stat-card-top">
                    <span class="stat-label">Total facilities</span>
                    <span class="stat-icon" aria-hidden="true">◎</span>
                </div>
                <div class="stat-value">@_clinics.Sum(c => c.FacilityCount)</div>
            </div>
        </div>

        @if (_clinics.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon" aria-hidden="true">⌂</div>
                <h3>No hospitals yet</h3>
                <p>Start by registering your first hospital through the onboarding wizard.</p>
                <a class="btn btn-primary" href="/admin/hospitals/register">Start onboarding</a>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <h3>Your hospitals</h3>
                    <a class="card-header-link" href="/admin/hospitals">View all →</a>
                </div>
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Country</th>
                                <th>Facilities</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var clinic in _clinics.Take(5))
                            {
                                <tr>
                                    <td><a class="card-header-link" href="/admin/hospitals/@clinic.Id"><strong>@clinic.Name</strong></a></td>
                                    <td>@clinic.Country</td>
                                    <td>@clinic.FacilityCount</td>
                                    <td>
                                        <span class="badge @(clinic.IsActive ? "badge-success" : "badge-muted")">
                                            @(clinic.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</section>

@code {
    private const string AdminPath = "/admin";

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _authRequired;
    private string? _error;
    private ClinicDashboard? _dashboard;
    private IReadOnlyList<ClinicListItem> _clinics = Array.Empty<ClinicListItem>();
    private string _clinicTimeZone = "UTC";

    private string _signInReturnUrl =>
        $"/professional/signin?returnUrl={Uri.EscapeDataString(AdminPath)}";

    protected override async Task OnInitializedAsync()
    {
        ClinicContext.Changed += OnClinicContextChanged;
        await LoadAsync();
    }

    private void OnClinicContextChanged() => _ = ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _dashboard = null;

        var clinicsResponse = await AdminClinicService.GetClinicsAsync();
        if (!clinicsResponse.IsSuccess || clinicsResponse.Data is null)
        {
            _loading = false;
            _error = clinicsResponse.ErrorMessage ?? "Could not load hospitals.";
            _authRequired = clinicsResponse.StatusCode is 401 or 403;
            return;
        }

        _clinics = clinicsResponse.Data;

        if (ClinicContext.CurrentClinicId is Guid clinicId)
        {
            var clinicTask = AdminClinicService.GetClinicAsync(clinicId);
            var dashboardTask = AdminClinicService.GetDashboardAsync(clinicId);
            await Task.WhenAll(clinicTask, dashboardTask).ConfigureAwait(false);

            if (clinicTask.Result.IsSuccess && clinicTask.Result.Data is not null)
                _clinicTimeZone = clinicTask.Result.Data.TimeZone;

            _loading = false;
            if (dashboardTask.Result.IsSuccess && dashboardTask.Result.Data is not null)
            {
                _dashboard = dashboardTask.Result.Data;
                return;
            }

            _error = dashboardTask.Result.ErrorMessage ?? "Could not load hospital dashboard.";
            return;
        }

        _loading = false;
    }

    public void Dispose() => ClinicContext.Changed -= OnClinicContextChanged;
}
