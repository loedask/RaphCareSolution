    private void AddPrescriptionLine() => _rxLines.Add(new ClinicVisitPrescriptionItem());

    private void RemoveLastPrescriptionLine()
    {
        if (_rxLines.Count > 1)
            _rxLines.RemoveAt(_rxLines.Count - 1);
    }

    private async Task AddPrescriptionAsync()
    {
        _savingPrescription = true;
        _error = null;
        _success = null;
        var lines = _rxLines
            .Where(l => !string.IsNullOrWhiteSpace(l.MedicationName))
            .Select(l => new ClinicVisitPrescriptionItem
            {
                MedicationName = l.MedicationName,
                Dosage = l.Dosage,
                Frequency = l.Frequency,
                DurationDays = l.DurationDays
            })
            .ToList();
        var response = await AdminClinicService.AddVisitPrescriptionAsync(ClinicId, VisitId, new AddVisitPrescriptionRequest
        {
            Notes = _rxNotes,
            Items = lines
        });
        _savingPrescription = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotAddPrescription");
            return;
        }

        _success = AppResources.T("Common_PrescriptionAdded");
        _rxLines.Clear();
        _rxLines.Add(new ClinicVisitPrescriptionItem());
        _rxNotes = string.Empty;
        await LoadVisitAsync();
    }

