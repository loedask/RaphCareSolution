@page "/admin/hospitals/{ClinicId:guid}/visits/{VisitId:guid}"
@layout AdminLayout
@using RaphCare.Domain.Common
@inject NavigationManager Navigation
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@(_visit is null ? AppResources.T("Visit_PageTitleFallback") : AppResources.Format("Common_VisitHeader", _visit.PatientName)) @AppResources.T("Common_PageTitleAdminSuffix")</PageTitle>

<section class="admin-page">
    @if (_loading)
    {
        <p class="text-muted">@AppResources.T("Common_LoadingVisit")</p>
    }
    else if (_visit is null)
    {
        <div class="alert alert-error">@(_error ?? AppResources.T("Common_VisitNotFound"))</div>
        <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId/appointments">@AppResources.T("Common_BackToAppointments")</a>
    }
    else
    {
        <header class="admin-page-header">
            <div>
                <h1>@AppResources.Format("Common_VisitHeader", _visit.PatientName)</h1>
                <p class="admin-page-lead">@AppResources.Format("Visit_DetailLead", _visit.VisitType, _visit.ProviderName, TimeZoneLabel)</p>
            </div>
            <span class="badge @(_visit.Status == "Completed" ? "badge-muted" : "badge-success")">@_visit.Status</span>
        </header>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="alert alert-success">@_success</div>
        }

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_EncounterEyebrow")</p>
                    <h2>@AppResources.T("Common_Details")</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                <dl class="admin-detail-grid">
                    <div>
                        <dt>@AppResources.T("Common_Started")</dt>
                        <dd>@FormatLocal(_visit.VisitStart)</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("Common_Ended")</dt>
                        <dd>@(_visit.VisitEnd is { } end ? FormatLocal(end) : AppResources.T("Common_EmptyCell"))</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("Common_Patient")</dt>
                        <dd><a href="/admin/hospitals/@ClinicId/patients/@_visit.PatientId">@_visit.PatientName</a></dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("Common_Provider")</dt>
                        <dd>@_visit.ProviderName</dd>
                    </div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_visit.Summary))
                {
                    <p class="hint" style="margin-top: 1rem;">@_visit.Summary</p>
                }
                @if (_isAdministrator && _visit.Status == "InProgress")
                {
                    <div class="admin-page-actions" style="margin-top: 1rem;">
                        <label>
                            @AppResources.T("Common_Summary")
                            <input class="form-control" @bind="_completeSummary" placeholder="@AppResources.T("Common_OptionalVisitSummary")" />
                        </label>
                        <button type="button" class="btn btn-primary" disabled="@_completing" @onclick="CompleteVisitAsync">
                            @(_completing ? AppResources.T("Common_Completing") : AppResources.T("Common_CompleteVisit"))
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("PatientDetail_ClinicalEyebrow")</p>
                    <h2>@AppResources.T("Common_VitalsTitle")</h2>
                </div>
                <span class="admin-progress-pill">@FormatVitalCount(_visit.Vitals.Count)</span>
            </header>
            <div class="admin-page-card-body">
                @if (_isAdministrator && _visit.Status == "InProgress")
                {
                    <div class="form-grid" style="margin-bottom: 1rem;">
                        <label>
                            @AppResources.T("Common_Type")
                            <select class="form-control" @bind="_vitalType">
                                <option value="HR">@AppResources.T("Common_HeartRateOption")</option>
                                <option value="BP">@AppResources.T("Common_BloodPressureOption")</option>
                                <option value="Temp">@AppResources.T("Common_TemperatureOption")</option>
                                <option value="SpO2">@AppResources.T("Common_Spo2Option")</option>
                                <option value="Weight">@AppResources.T("Common_WeightOption")</option>
                            </select>
                        </label>
                        <label>
                            @AppResources.T("Common_Value")
                            <input class="form-control" type="number" step="0.1" @bind="_vitalValue" />
                        </label>
                        <label>
                            @AppResources.T("Visit_UnitLabel")
                            <input class="form-control" @bind="_vitalUnit" placeholder="@AppResources.T("Common_UnitPlaceholder")" />
                        </label>
                    </div>
                    <div class="admin-page-actions" style="margin-bottom: 1.25rem;">
                        <button type="button" class="btn btn-primary" disabled="@_recording" @onclick="RecordVitalAsync">
                            @(_recording ? AppResources.T("Common_Saving") : AppResources.T("Common_RecordVital"))
                        </button>
                    </div>
                }

                @if (_visit.Vitals.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoVitalsYet")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Recorded")</th>
                                    <th>@AppResources.T("Common_Type")</th>
                                    <th>@AppResources.T("Common_Value")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vital in _visit.Vitals)
                                {
                                    <tr>
                                        <td>@FormatLocal(vital.RecordedAt)</td>
                                        <td>@vital.Type</td>
                                        <td>@vital.Value @(vital.Unit ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-actions">
            <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId/appointments">@AppResources.T("Visit_AppointmentsNav")</a>
            <a class="btn btn-ghost" href="/admin/hospitals/@ClinicId/patients/@_visit.PatientId">@AppResources.T("Common_PatientChartLink")</a>
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }
    [Parameter] public Guid VisitId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _isAdministrator;
    private bool _recording;
    private bool _completing;
    private string? _error;
    private string? _success;
    private string _clinicTimeZone = "UTC";
    private ClinicVisitDetail? _visit;
    private string _vitalType = "HR";
    private decimal _vitalValue;
    private string _vitalUnit = "bpm";
    private string _completeSummary = string.Empty;

    private string TimeZoneLabel =>
        string.IsNullOrWhiteSpace(_clinicTimeZone) ? AppResources.T("Common_HospitalTime") : _clinicTimeZone;

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        await LoadVisitAsync();
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private async Task LoadVisitAsync()
    {
        _loading = true;
        _error = null;
        var response = await AdminClinicService.GetVisitAsync(ClinicId, VisitId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _visit = response.Data;
            _completeSummary = response.Data.Summary ?? string.Empty;
        }
        else
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotLoadVisit");
    }

    private string FormatLocal(DateTime utc) =>
        ClinicTimeZoneHelper.FormatClinicLocal(utc, _clinicTimeZone);

    private static string FormatVitalCount(int count) =>
        count == 1
            ? AppResources.Format("Common_VitalCountLabel", count)
            : AppResources.Format("Common_VitalCountLabelPlural", count);

    private async Task RecordVitalAsync()
    {
        _recording = true;
        _error = null;
        _success = null;

        if (_vitalType is "HR") _vitalUnit = string.IsNullOrWhiteSpace(_vitalUnit) ? "bpm" : _vitalUnit;
        if (_vitalType is "Temp") _vitalUnit = string.IsNullOrWhiteSpace(_vitalUnit) ? "°C" : _vitalUnit;
        if (_vitalType is "SpO2") _vitalUnit = string.IsNullOrWhiteSpace(_vitalUnit) ? "%" : _vitalUnit;

        var response = await AdminClinicService.RecordVisitVitalAsync(ClinicId, VisitId, new RecordVisitVitalRequest
        {
            Type = _vitalType,
            Value = _vitalValue,
            Unit = _vitalUnit
        });
        _recording = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotRecordVital");
            return;
        }

        _success = AppResources.T("Common_VitalRecorded");
        _vitalValue = 0;
        await LoadVisitAsync();
    }

    private async Task CompleteVisitAsync()
    {
        _completing = true;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CompleteVisitAsync(
            ClinicId,
            VisitId,
            string.IsNullOrWhiteSpace(_completeSummary) ? null : _completeSummary.Trim());
        _completing = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotCompleteVisit");
            return;
        }

        _visit = response.Data;
        _success = AppResources.T("Common_VisitCompleted");
    }
}
