@page "/admin/hospitals/register"
@layout AdminLayout

<PageTitle>Register hospital — RaphCare Admin</PageTitle>

@if (_completed && _result is not null)
{
    <section class="admin-page onboarding-success">
        <div class="success-card">
            <div class="success-icon" aria-hidden="true">✓</div>
            <h1>@_result.Name is registered</h1>
            <p class="text-muted">The hospital is active on the platform. Patients can select it during registration once staff are provisioned.</p>

            <div class="review-grid">
                <div class="review-item">
                    <span class="review-label">Hospital ID</span>
                    <span class="review-value"><code>@_result.ClinicId</code></span>
                </div>
                @if (_result.PrimaryFacilityName is not null)
                {
                    <div class="review-item">
                        <span class="review-label">Primary facility</span>
                        <span class="review-value">@_result.PrimaryFacilityName</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_draft.AdminEmail))
                {
                    <div class="review-item">
                        <span class="review-label">Admin contact (pending)</span>
                        <span class="review-value">@_draft.AdminFullName — @_draft.AdminEmail</span>
                    </div>
                }
            </div>

            <div class="admin-page-actions">
                <a class="btn btn-primary" href="/admin/hospitals/@_result.ClinicId">Open hospital</a>
                <a class="btn btn-secondary" href="/admin/hospitals">View all hospitals</a>
                <button type="button" class="btn btn-secondary" @onclick="StartAnotherAsync">Register another</button>
            </div>
        </div>
    </section>
}
else
{
    <section class="admin-page onboarding-page">
        <div class="lifecycle-stepper" aria-label="Onboarding progress">
            @foreach (var s in _steps)
            {
                var done = s.Id < _step;
                var active = s.Id == _step;
                var stateClass = active ? "active" : done ? "done" : "pending";
                <div class="lifecycle-step @stateClass">
                    <div class="lifecycle-step-marker">
                        @if (done)
                        {
                            <span aria-hidden="true">✓</span>
                        }
                        else
                        {
                            <span>@s.Id</span>
                        }
                    </div>
                    <span class="lifecycle-step-label">@s.Label</span>
                </div>
                @if (s.Id < _stepCount)
                {
                    <div class="lifecycle-connector @(s.Id < _step ? "done" : "")"></div>
                }
            }
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">Hospital onboarding · Step @_step of @_stepCount</p>
                    <h1>@_stepMeta.Title</h1>
                    @if (!string.IsNullOrEmpty(_stepMeta.Subtitle))
                    {
                        <p class="admin-page-lead">@_stepMeta.Subtitle</p>
                    }
                </div>
                <div class="admin-page-head-meta">
                    <span class="admin-progress-pill">@_progressPercent% complete</span>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(_resumeMessage))
            {
                <div class="alert alert-info admin-page-alert">@_resumeMessage</div>
            }

            @if (!string.IsNullOrEmpty(_submitError))
            {
                <div class="alert alert-error admin-page-alert">
                    <p class="admin-alert-text">@_submitError</p>
                    @if (_authRetryRequired)
                    {
                        <p class="admin-alert-hint">Your hospital details are saved on this device. Sign in again, then return here to finish registration.</p>
                        <a class="btn btn-secondary btn-sm" href="@_signInReturnUrl">Sign in and continue</a>
                    }
                </div>
            }

            <div class="admin-page-card-body">
                @switch (_step)
                {
                    case 1:
                        <p class="onboarding-intro">Register a new healthcare organization on RaphCare. This wizard collects hospital identity, a primary facility, and an administrator contact for follow-up provisioning.</p>
                        <div class="feature-card-grid">
                            <div class="feature-card">
                                <div class="feature-card-icon hospital">⌂</div>
                                <h3>Hospital tenant</h3>
                                <p>Creates the clinic record and regional settings for your organization.</p>
                            </div>
                            <div class="feature-card">
                                <div class="feature-card-icon facility">◎</div>
                                <h3>Primary facility</h3>
                                <p>Add a physical campus or virtual telehealth site as the first location.</p>
                            </div>
                            <div class="feature-card">
                                <div class="feature-card-icon admin">👤</div>
                                <h3>Administrator</h3>
                                <p>Capture who will manage the hospital on the platform.</p>
                            </div>
                        </div>
                        break;

                    case 2:
                        <div class="form-grid">
                            <div class="form-field span-2">
                                <label for="name">Hospital name *</label>
                                <InputText id="name" class="form-control" @bind-Value="_draft.Name" placeholder="e.g. RaphCare General Hospital" />
                            </div>
                            <div class="form-field">
                                <label for="reg">Registration number *</label>
                                <InputText id="reg" class="form-control" @bind-Value="_draft.RegistrationNumber" placeholder="e.g. HPCSA-12345" />
                            </div>
                            <div class="form-field">
                                <label for="country">Country *</label>
                                <InputSelect id="country" class="form-control" @bind-Value="_draft.Country">
                                    @foreach (var c in _countries)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-field span-2">
                                <label for="tz">Time zone *</label>
                                <InputSelect id="tz" class="form-control" @bind-Value="_draft.TimeZone">
                                    @foreach (var tz in _timeZones)
                                    {
                                        <option value="@tz">@tz</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        break;

                    case 3:
                        <div class="form-grid">
                            <div class="form-field span-2">
                                <label for="facName">Facility name</label>
                                <InputText id="facName" class="form-control" @bind-Value="_draft.FacilityName" placeholder="e.g. Main campus" />
                            </div>
                            <div class="form-field span-2">
                                <label for="address">Street address</label>
                                <InputText id="address" class="form-control" @bind-Value="_draft.FacilityAddress" />
                            </div>
                            <div class="form-field">
                                <label for="city">City</label>
                                <InputText id="city" class="form-control" @bind-Value="_draft.FacilityCity" />
                            </div>
                            <div class="form-field checkbox-field">
                                <label>
                                    <InputCheckbox @bind-Value="_draft.IsVirtualFacility" />
                                    Virtual / telehealth-only site
                                </label>
                            </div>
                        </div>
                        break;

                    case 4:
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="adminName">Administrator full name</label>
                                <InputText id="adminName" class="form-control" @bind-Value="_draft.AdminFullName" placeholder="e.g. Dr. Jane Smith" />
                            </div>
                            <div class="form-field">
                                <label for="adminEmail">Administrator email</label>
                                <InputText id="adminEmail" class="form-control" @bind-Value="_draft.AdminEmail" type="email" placeholder="admin@hospital.org" />
                            </div>
                        </div>
                        <p class="hint">Admin accounts will be linked via email sign-in. Contact details are stored for follow-up provisioning.</p>
                        break;

                    case 5:
                        <div class="review-grid">
                            <div class="review-item">
                                <span class="review-label">Hospital</span>
                                <span class="review-value">@_draft.Name</span>
                            </div>
                            <div class="review-item">
                                <span class="review-label">Registration #</span>
                                <span class="review-value">@_draft.RegistrationNumber</span>
                            </div>
                            <div class="review-item">
                                <span class="review-label">Country</span>
                                <span class="review-value">@_draft.Country</span>
                            </div>
                            <div class="review-item">
                                <span class="review-label">Time zone</span>
                                <span class="review-value">@_draft.TimeZone</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_draft.FacilityName))
                            {
                                <div class="review-item">
                                    <span class="review-label">Primary facility</span>
                                    <span class="review-value">@_draft.FacilityName @(_draft.IsVirtualFacility ? "(virtual)" : "")</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_draft.AdminEmail))
                            {
                                <div class="review-item">
                                    <span class="review-label">Administrator</span>
                                    <span class="review-value">@_draft.AdminFullName — @_draft.AdminEmail</span>
                                </div>
                            }
                        </div>
                        break;
                }
            </div>

            <footer class="admin-page-card-foot">
                <div class="admin-page-actions">
                    @if (_step > 1)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="GoBackAsync" disabled="@_submitting">Back</button>
                    }
                    else
                    {
                        <a class="btn btn-ghost" href="/admin/hospitals">Cancel</a>
                    }

                    <div class="admin-page-actions-right">
                        @if (_step < _stepCount)
                        {
                            <button type="button" class="btn btn-ghost" @onclick="GoNextAsync">Skip step</button>
                            <button type="button" class="btn btn-primary" @onclick="GoNextAsync" disabled="@(!CanContinue)">Continue →</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" @onclick="SubmitAsync" disabled="@(_submitting || !CanContinue)">
                                @(_submitting ? "Registering…" : "Register hospital")
                            </button>
                        }
                    </div>
                </div>
            </footer>
        </div>
    </section>
}

@code {
    private const string RegisterPath = "/admin/hospitals/register";

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IHospitalOnboardingStorage OnboardingStorage { get; set; } = default!;
    [Inject] private IWebAuthService WebAuth { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private const int _stepCount = 5;
    private int _step = 1;
    private bool _submitting;
    private bool _completed;
    private bool _authRetryRequired;
    private string? _submitError;
    private string? _resumeMessage;
    private RegisterClinicResult? _result;
    private readonly OnboardingDraft _draft = new();

    private string _signInReturnUrl =>
        $"/professional/signin?returnUrl={Uri.EscapeDataString(RegisterPath)}";

    private readonly (int Id, string Label)[] _steps =
    [
        (1, "Welcome"),
        (2, "Hospital"),
        (3, "Facility"),
        (4, RaphCareRoles.Administrator),
        (5, "Review")
    ];

    private readonly string[] _countries =
    [
        "South Africa", "Kenya", "Nigeria", "Ghana", "United Kingdom", "United States", "Other"
    ];

    private readonly string[] _timeZones =
    [
        "South Africa Standard Time",
        "UTC",
        "GMT Standard Time",
        "W. Europe Standard Time",
        "Eastern Standard Time",
        "Central European Standard Time"
    ];

    private int _progressPercent => (int)Math.Round(_step / (double)_stepCount * 100);

    private (string Title, string Subtitle) _stepMeta => _step switch
    {
        1 => ("Welcome to hospital onboarding", "A short setup to register a new healthcare organization on RaphCare."),
        2 => ("Hospital identity", "Legal name, registration number, and regional settings."),
        3 => ("Primary facility", "Optional first site — physical campus or virtual telehealth hub."),
        4 => ("Administrator contact", "Who will manage this hospital on the platform."),
        5 => ("Review and register", "Confirm details before creating the hospital tenant."),
        _ => ("", "")
    };

    private bool CanContinue => _step switch
    {
        2 => !string.IsNullOrWhiteSpace(_draft.Name)
             && !string.IsNullOrWhiteSpace(_draft.RegistrationNumber)
             && !string.IsNullOrWhiteSpace(_draft.Country)
             && !string.IsNullOrWhiteSpace(_draft.TimeZone),
        _ => true
    };

    protected override async Task OnInitializedAsync()
    {
        var saved = await OnboardingStorage.LoadAsync().ConfigureAwait(false);
        if (saved is null || !saved.HasHospitalDetails)
            return;

        ApplySavedDraft(saved);
        _resumeMessage = saved.Step >= _stepCount
            ? "We restored your saved hospital details. Review and tap Register hospital when you are ready."
            : $"We restored your saved progress from step {saved.Step}. You can continue where you left off.";
    }

    private void ApplySavedDraft(HospitalOnboardingDraft saved)
    {
        _step = Math.Clamp(saved.Step, 1, _stepCount);
        _draft.Name = saved.Name;
        _draft.RegistrationNumber = saved.RegistrationNumber;
        _draft.Country = string.IsNullOrWhiteSpace(saved.Country) ? "South Africa" : saved.Country;
        _draft.TimeZone = string.IsNullOrWhiteSpace(saved.TimeZone) ? "South Africa Standard Time" : saved.TimeZone;
        _draft.FacilityName = saved.FacilityName;
        _draft.FacilityAddress = saved.FacilityAddress;
        _draft.FacilityCity = saved.FacilityCity;
        _draft.IsVirtualFacility = saved.IsVirtualFacility;
        _draft.AdminFullName = saved.AdminFullName;
        _draft.AdminEmail = saved.AdminEmail;
    }

    private async Task PersistDraftAsync()
    {
        await OnboardingStorage.SaveAsync(new HospitalOnboardingDraft
        {
            Step = _step,
            Name = _draft.Name,
            RegistrationNumber = _draft.RegistrationNumber,
            Country = _draft.Country,
            TimeZone = _draft.TimeZone,
            FacilityName = _draft.FacilityName,
            FacilityAddress = _draft.FacilityAddress,
            FacilityCity = _draft.FacilityCity,
            IsVirtualFacility = _draft.IsVirtualFacility,
            AdminFullName = _draft.AdminFullName,
            AdminEmail = _draft.AdminEmail
        }).ConfigureAwait(false);
    }

    private async Task GoNextAsync()
    {
        if (_step < _stepCount)
            _step++;

        await PersistDraftAsync().ConfigureAwait(false);
    }

    private async Task GoBackAsync()
    {
        if (_step > 1)
            _step--;

        await PersistDraftAsync().ConfigureAwait(false);
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _submitError = null;
        _authRetryRequired = false;
        await WebAuth.EnsureHydratedAsync().ConfigureAwait(true);
        await PersistDraftAsync().ConfigureAwait(false);

        var request = new RegisterClinicRequest
        {
            Name = _draft.Name.Trim(),
            RegistrationNumber = _draft.RegistrationNumber.Trim(),
            Country = _draft.Country.Trim(),
            TimeZone = _draft.TimeZone.Trim(),
            FacilityName = string.IsNullOrWhiteSpace(_draft.FacilityName) ? null : _draft.FacilityName.Trim(),
            FacilityAddress = _draft.FacilityAddress?.Trim(),
            FacilityCity = _draft.FacilityCity?.Trim(),
            IsVirtualFacility = _draft.IsVirtualFacility
        };

        var response = await AdminClinicService.RegisterClinicAsync(request);
        _submitting = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _result = response.Data;
            _completed = true;
            _resumeMessage = null;
            await OnboardingStorage.ClearAsync().ConfigureAwait(false);
            await Js.InvokeVoidAsync("raphCareClinic.setPendingClinicId", _result.ClinicId.ToString()).ConfigureAwait(false);
            await ClinicContext.SetCurrentClinicAsync(_result.ClinicId, _result.Name).ConfigureAwait(false);
            return;
        }

        _submitError = response.ErrorMessage ?? "Registration failed.";
        _authRetryRequired = response.StatusCode is 401 or 403;
        await PersistDraftAsync().ConfigureAwait(false);
    }

    private async Task StartAnotherAsync()
    {
        _completed = false;
        _result = null;
        _step = 1;
        _resumeMessage = null;
        _submitError = null;
        _authRetryRequired = false;
        _draft.Reset();
        await OnboardingStorage.ClearAsync().ConfigureAwait(false);
    }

    private sealed class OnboardingDraft
    {
        public string Name { get; set; } = string.Empty;
        public string RegistrationNumber { get; set; } = string.Empty;
        public string Country { get; set; } = "South Africa";
        public string TimeZone { get; set; } = "South Africa Standard Time";
        public string FacilityName { get; set; } = string.Empty;
        public string FacilityAddress { get; set; } = string.Empty;
        public string FacilityCity { get; set; } = string.Empty;
        public bool IsVirtualFacility { get; set; }
        public string AdminFullName { get; set; } = string.Empty;
        public string AdminEmail { get; set; } = string.Empty;

        public void Reset()
        {
            Name = string.Empty;
            RegistrationNumber = string.Empty;
            Country = "South Africa";
            TimeZone = "South Africa Standard Time";
            FacilityName = string.Empty;
            FacilityAddress = string.Empty;
            FacilityCity = string.Empty;
            IsVirtualFacility = false;
            AdminFullName = string.Empty;
            AdminEmail = string.Empty;
        }
    }
}
