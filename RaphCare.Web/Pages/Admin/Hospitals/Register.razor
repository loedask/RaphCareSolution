@page "/admin/hospitals/register"
@layout AdminLayout
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("HospitalsRegister_PageTitle")</PageTitle>

@if (_completed && _result is not null)
{
    <section class="admin-page onboarding-success">
        <div class="success-card">
            <div class="success-icon" aria-hidden="true">✓</div>
            <h1>@AppResources.Format("Common_HospitalRegisteredTitle", _result.Name)</h1>
            <p class="text-muted">@AppResources.T("Common_HospitalRegisteredLead")</p>

            <div class="review-grid">
                <div class="review-item">
                    <span class="review-label">@AppResources.T("Common_HospitalId")</span>
                    <span class="review-value"><code>@_result.ClinicId</code></span>
                </div>
                @if (_result.PrimaryFacilityName is not null)
                {
                    <div class="review-item">
                        <span class="review-label">@AppResources.T("Common_PrimaryFacility")</span>
                        <span class="review-value">@_result.PrimaryFacilityName</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_draft.AdminEmail))
                {
                    <div class="review-item">
                        <span class="review-label">@AppResources.T("Common_AdminContactPending")</span>
                        <span class="review-value">@_draft.AdminFullName — @_draft.AdminEmail</span>
                    </div>
                }
            </div>

            <div class="admin-page-actions">
                <a class="btn btn-primary" href="/admin/hospitals/@_result.ClinicId">@AppResources.T("Common_OpenHospital")</a>
                <a class="btn btn-secondary" href="/admin/hospitals">@AppResources.T("Common_ViewAllHospitals")</a>
                <button type="button" class="btn btn-secondary" @onclick="StartAnotherAsync">@AppResources.T("Common_RegisterAnother")</button>
            </div>
        </div>
    </section>
}
else
{
    <section class="admin-page onboarding-page">
        <div class="lifecycle-stepper" aria-label="@AppResources.T("Common_OnboardingProgressAria")">
            @foreach (var s in Steps)
            {
                var done = s.Id < _step;
                var active = s.Id == _step;
                var stateClass = active ? "active" : done ? "done" : "pending";
                <div class="lifecycle-step @stateClass">
                    <div class="lifecycle-step-marker">
                        @if (done)
                        {
                            <span aria-hidden="true">✓</span>
                        }
                        else
                        {
                            <span>@s.Id</span>
                        }
                    </div>
                    <span class="lifecycle-step-label">@s.Label</span>
                </div>
                @if (s.Id < _stepCount)
                {
                    <div class="lifecycle-connector @(s.Id < _step ? "done" : "")"></div>
                }
            }
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.Format("Common_HospitalOnboardingEyebrow", _step, _stepCount)</p>
                    <h1>@StepMeta.Title</h1>
                    @if (!string.IsNullOrEmpty(StepMeta.Subtitle))
                    {
                        <p class="admin-page-lead">@StepMeta.Subtitle</p>
                    }
                </div>
                <div class="admin-page-head-meta">
                    <span class="admin-progress-pill">@AppResources.Format("Common_PercentComplete", _progressPercent)</span>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(_resumeMessage))
            {
                <div class="alert alert-info admin-page-alert">@_resumeMessage</div>
            }

            @if (!string.IsNullOrEmpty(_submitError))
            {
                <div class="alert alert-error admin-page-alert">
                    <p class="admin-alert-text">@_submitError</p>
                    @if (_authRetryRequired)
                    {
                        <p class="admin-alert-hint">@AppResources.T("Common_AuthRetryHint")</p>
                        <a class="btn btn-secondary btn-sm" href="@_signInReturnUrl">@AppResources.T("Common_SignInAndContinue")</a>
                    }
                </div>
            }

            <div class="admin-page-card-body">
                @switch (_step)
                {
                    case 1:
                        <p class="onboarding-intro">@AppResources.T("HospitalsRegister_Intro")</p>
                        <div class="feature-card-grid">
                            <div class="feature-card">
                                <div class="feature-card-icon hospital">⌂</div>
                                <h3>@AppResources.T("HospitalsRegister_FeatureTenantTitle")</h3>
                                <p>@AppResources.T("HospitalsRegister_FeatureTenantDesc")</p>
                            </div>
                            <div class="feature-card">
                                <div class="feature-card-icon facility">◎</div>
                                <h3>@AppResources.T("HospitalsRegister_FeatureFacilityTitle")</h3>
                                <p>@AppResources.T("HospitalsRegister_FeatureFacilityDesc")</p>
                            </div>
                            <div class="feature-card">
                                <div class="feature-card-icon admin">👤</div>
                                <h3>@AppResources.T("HospitalsRegister_FeatureAdminTitle")</h3>
                                <p>@AppResources.T("HospitalsRegister_FeatureAdminDesc")</p>
                            </div>
                        </div>
                        break;

                    case 2:
                        <div class="form-grid">
                            <div class="form-field span-2">
                                <label for="name">@AppResources.T("HospitalsRegister_HospitalNameLabel")</label>
                                <InputText id="name" class="form-control" @bind-Value="_draft.Name" placeholder="@AppResources.T("HospitalsRegister_HospitalNamePlaceholder")" />
                            </div>
                            <div class="form-field">
                                <label for="reg">@AppResources.T("HospitalsRegister_RegNumberLabel")</label>
                                <InputText id="reg" class="form-control" @bind-Value="_draft.RegistrationNumber" placeholder="@AppResources.T("HospitalsRegister_RegNumberPlaceholder")" />
                            </div>
                            <div class="form-field">
                                <label for="country">@AppResources.T("HospitalsRegister_CountryLabel")</label>
                                <InputSelect id="country" class="form-control" @bind-Value="_draft.Country">
                                    @foreach (var c in CountryOptions)
                                    {
                                        <option value="@c.Value">@AppResources.T(c.ResourceKey)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-field span-2">
                                <label for="tz">@AppResources.T("HospitalsRegister_TimeZoneLabel")</label>
                                <InputSelect id="tz" class="form-control" @bind-Value="_draft.TimeZone">
                                    @foreach (var tz in TimeZoneOptions)
                                    {
                                        <option value="@tz.Value">@AppResources.T(tz.ResourceKey)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        break;

                    case 3:
                        <div class="form-grid">
                            <div class="form-field span-2">
                                <label for="facName">@AppResources.T("HospitalsRegister_FacilityNameLabel")</label>
                                <InputText id="facName" class="form-control" @bind-Value="_draft.FacilityName" placeholder="@AppResources.T("HospitalsRegister_FacilityNamePlaceholder")" />
                            </div>
                            <div class="form-field span-2">
                                <label for="address">@AppResources.T("HospitalsRegister_StreetAddressLabel")</label>
                                <InputText id="address" class="form-control" @bind-Value="_draft.FacilityAddress" />
                            </div>
                            <div class="form-field">
                                <label for="city">@AppResources.T("HospitalsRegister_CityLabel")</label>
                                <InputText id="city" class="form-control" @bind-Value="_draft.FacilityCity" />
                            </div>
                            <div class="form-field checkbox-field">
                                <label>
                                    <InputCheckbox @bind-Value="_draft.IsVirtualFacility" />
                                    @AppResources.T("HospitalsRegister_VirtualFacilityCheckbox")
                                </label>
                            </div>
                        </div>
                        break;

                    case 4:
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="adminName">@AppResources.T("HospitalsRegister_AdminNameLabel")</label>
                                <InputText id="adminName" class="form-control" @bind-Value="_draft.AdminFullName" placeholder="@AppResources.T("HospitalsRegister_AdminNamePlaceholder")" />
                            </div>
                            <div class="form-field">
                                <label for="adminEmail">@AppResources.T("HospitalsRegister_AdminEmailLabel")</label>
                                <InputText id="adminEmail" class="form-control" @bind-Value="_draft.AdminEmail" type="email" placeholder="@AppResources.T("HospitalsRegister_AdminEmailPlaceholder")" />
                            </div>
                        </div>
                        <p class="hint">@AppResources.T("HospitalsRegister_AdminHint")</p>
                        break;

                    case 5:
                        <div class="review-grid">
                            <div class="review-item">
                                <span class="review-label">@AppResources.T("HospitalsRegister_ReviewHospital")</span>
                                <span class="review-value">@_draft.Name</span>
                            </div>
                            <div class="review-item">
                                <span class="review-label">@AppResources.T("Common_RegistrationNumberShort")</span>
                                <span class="review-value">@_draft.RegistrationNumber</span>
                            </div>
                            <div class="review-item">
                                <span class="review-label">@AppResources.T("Common_Country")</span>
                                <span class="review-value">@LocalizeCountry(_draft.Country)</span>
                            </div>
                            <div class="review-item">
                                <span class="review-label">@AppResources.T("Common_TimeZone")</span>
                                <span class="review-value">@LocalizeTimeZone(_draft.TimeZone)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_draft.FacilityName))
                            {
                                <div class="review-item">
                                    <span class="review-label">@AppResources.T("Common_PrimaryFacility")</span>
                                    <span class="review-value">@_draft.FacilityName @(_draft.IsVirtualFacility ? AppResources.T("Common_VirtualSuffix") : "")</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_draft.AdminEmail))
                            {
                                <div class="review-item">
                                    <span class="review-label">@AppResources.T("Common_Administrator")</span>
                                    <span class="review-value">@_draft.AdminFullName — @_draft.AdminEmail</span>
                                </div>
                            }
                        </div>
                        break;
                }
            </div>

            <footer class="admin-page-card-foot">
                <div class="admin-page-actions">
                    @if (_step > 1)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="GoBackAsync" disabled="@_submitting">@AppResources.T("Common_BackButton")</button>
                    }
                    else
                    {
                        <a class="btn btn-ghost" href="/admin/hospitals">@AppResources.T("Common_Cancel")</a>
                    }

                    <div class="admin-page-actions-right">
                        @if (_step < _stepCount)
                        {
                            <button type="button" class="btn btn-ghost" @onclick="GoNextAsync">@AppResources.T("Common_SkipStep")</button>
                            <button type="button" class="btn btn-primary" @onclick="GoNextAsync" disabled="@(!CanContinue)">@AppResources.T("Common_ContinueArrow")</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" @onclick="SubmitAsync" disabled="@(_submitting || !CanContinue)">
                                @(_submitting ? AppResources.T("Common_Registering") : AppResources.T("Common_RegisterHospital"))
                            </button>
                        }
                    </div>
                </div>
            </footer>
        </div>
    </section>
}

@code {
    private const string RegisterPath = "/admin/hospitals/register";
    private const string DefaultCountry = "South Africa";
    private const string DefaultTimeZone = "South Africa Standard Time";

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IHospitalOnboardingStorage OnboardingStorage { get; set; } = default!;
    [Inject] private IWebAuthService WebAuth { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private const int _stepCount = 5;
    private int _step = 1;
    private bool _submitting;
    private bool _completed;
    private bool _authRetryRequired;
    private string? _submitError;
    private string? _resumeMessage;
    private RegisterClinicResult? _result;
    private readonly OnboardingDraft _draft = new();

    private string _signInReturnUrl =>
        $"/professional/signin?returnUrl={Uri.EscapeDataString(RegisterPath)}";

    private static readonly (string Value, string ResourceKey)[] CountryOptions =
    [
        ("South Africa", "HospitalsRegister_Country_SouthAfrica"),
        ("Kenya", "HospitalsRegister_Country_Kenya"),
        ("Nigeria", "HospitalsRegister_Country_Nigeria"),
        ("Ghana", "HospitalsRegister_Country_Ghana"),
        ("United Kingdom", "HospitalsRegister_Country_UnitedKingdom"),
        ("United States", "HospitalsRegister_Country_UnitedStates"),
        ("Other", "HospitalsRegister_Country_Other")
    ];

    private static readonly (string Value, string ResourceKey)[] TimeZoneOptions =
    [
        ("South Africa Standard Time", "HospitalsRegister_TimeZone_SAST"),
        ("UTC", "HospitalsRegister_TimeZone_UTC"),
        ("GMT Standard Time", "HospitalsRegister_TimeZone_GMT"),
        ("W. Europe Standard Time", "HospitalsRegister_TimeZone_WEurope"),
        ("Eastern Standard Time", "HospitalsRegister_TimeZone_Eastern"),
        ("Central European Standard Time", "HospitalsRegister_TimeZone_CentralEurope")
    ];

    private (int Id, string Label)[] Steps =>
    [
        (1, AppResources.T("HospitalsRegister_StepWelcome")),
        (2, AppResources.T("HospitalsRegister_StepHospital")),
        (3, AppResources.T("HospitalsRegister_StepFacility")),
        (4, AppResources.T("HospitalsRegister_StepAdministrator")),
        (5, AppResources.T("HospitalsRegister_StepReview"))
    ];

    private int _progressPercent => (int)Math.Round(_step / (double)_stepCount * 100);

    private (string Title, string Subtitle) StepMeta => _step switch
    {
        1 => (AppResources.T("HospitalsRegister_Step1Title"), AppResources.T("HospitalsRegister_Step1Subtitle")),
        2 => (AppResources.T("HospitalsRegister_Step2Title"), AppResources.T("HospitalsRegister_Step2Subtitle")),
        3 => (AppResources.T("HospitalsRegister_Step3Title"), AppResources.T("HospitalsRegister_Step3Subtitle")),
        4 => (AppResources.T("HospitalsRegister_Step4Title"), AppResources.T("HospitalsRegister_Step4Subtitle")),
        5 => (AppResources.T("HospitalsRegister_Step5Title"), AppResources.T("HospitalsRegister_Step5Subtitle")),
        _ => ("", "")
    };

    private bool CanContinue => _step switch
    {
        2 => !string.IsNullOrWhiteSpace(_draft.Name)
             && !string.IsNullOrWhiteSpace(_draft.RegistrationNumber)
             && !string.IsNullOrWhiteSpace(_draft.Country)
             && !string.IsNullOrWhiteSpace(_draft.TimeZone),
        _ => true
    };

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;

        var saved = await OnboardingStorage.LoadAsync().ConfigureAwait(false);
        if (saved is null || !saved.HasHospitalDetails)
            return;

        ApplySavedDraft(saved);
        _resumeMessage = saved.Step >= _stepCount
            ? AppResources.T("Common_ResumeReadyReview")
            : AppResources.Format("Common_ResumeFromStep", saved.Step);
    }

    private void ApplySavedDraft(HospitalOnboardingDraft saved)
    {
        _step = Math.Clamp(saved.Step, 1, _stepCount);
        _draft.Name = saved.Name;
        _draft.RegistrationNumber = saved.RegistrationNumber;
        _draft.Country = string.IsNullOrWhiteSpace(saved.Country) ? DefaultCountry : saved.Country;
        _draft.TimeZone = string.IsNullOrWhiteSpace(saved.TimeZone) ? DefaultTimeZone : saved.TimeZone;
        _draft.FacilityName = saved.FacilityName;
        _draft.FacilityAddress = saved.FacilityAddress;
        _draft.FacilityCity = saved.FacilityCity;
        _draft.IsVirtualFacility = saved.IsVirtualFacility;
        _draft.AdminFullName = saved.AdminFullName;
        _draft.AdminEmail = saved.AdminEmail;
    }

    private static string LocalizeCountry(string value)
    {
        foreach (var (optionValue, key) in CountryOptions)
        {
            if (string.Equals(optionValue, value, StringComparison.Ordinal))
                return AppResources.T(key);
        }

        return value;
    }

    private static string LocalizeTimeZone(string value)
    {
        foreach (var (optionValue, key) in TimeZoneOptions)
        {
            if (string.Equals(optionValue, value, StringComparison.Ordinal))
                return AppResources.T(key);
        }

        return value;
    }

    private async Task PersistDraftAsync()
    {
        await OnboardingStorage.SaveAsync(new HospitalOnboardingDraft
        {
            Step = _step,
            Name = _draft.Name,
            RegistrationNumber = _draft.RegistrationNumber,
            Country = _draft.Country,
            TimeZone = _draft.TimeZone,
            FacilityName = _draft.FacilityName,
            FacilityAddress = _draft.FacilityAddress,
            FacilityCity = _draft.FacilityCity,
            IsVirtualFacility = _draft.IsVirtualFacility,
            AdminFullName = _draft.AdminFullName,
            AdminEmail = _draft.AdminEmail
        }).ConfigureAwait(false);
    }

    private async Task GoNextAsync()
    {
        if (_step < _stepCount)
            _step++;

        await PersistDraftAsync().ConfigureAwait(false);
    }

    private async Task GoBackAsync()
    {
        if (_step > 1)
            _step--;

        await PersistDraftAsync().ConfigureAwait(false);
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _submitError = null;
        _authRetryRequired = false;
        await WebAuth.EnsureHydratedAsync().ConfigureAwait(true);
        await PersistDraftAsync().ConfigureAwait(false);

        var request = new RegisterClinicRequest
        {
            Name = _draft.Name.Trim(),
            RegistrationNumber = _draft.RegistrationNumber.Trim(),
            Country = _draft.Country.Trim(),
            TimeZone = _draft.TimeZone.Trim(),
            FacilityName = string.IsNullOrWhiteSpace(_draft.FacilityName) ? null : _draft.FacilityName.Trim(),
            FacilityAddress = _draft.FacilityAddress?.Trim(),
            FacilityCity = _draft.FacilityCity?.Trim(),
            IsVirtualFacility = _draft.IsVirtualFacility
        };

        var response = await AdminClinicService.RegisterClinicAsync(request);
        _submitting = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _result = response.Data;
            _completed = true;
            _resumeMessage = null;
            await OnboardingStorage.ClearAsync().ConfigureAwait(false);
            await Js.InvokeVoidAsync("raphCareClinic.setPendingClinicId", _result.ClinicId.ToString()).ConfigureAwait(false);
            await ClinicContext.SetCurrentClinicAsync(_result.ClinicId, _result.Name).ConfigureAwait(false);
            return;
        }

        _submitError = response.ErrorMessage ?? AppResources.T("Common_RegistrationFailed");
        _authRetryRequired = response.StatusCode is 401 or 403;
        await PersistDraftAsync().ConfigureAwait(false);
    }

    private async Task StartAnotherAsync()
    {
        _completed = false;
        _result = null;
        _step = 1;
        _resumeMessage = null;
        _submitError = null;
        _authRetryRequired = false;
        _draft.Reset();
        await OnboardingStorage.ClearAsync().ConfigureAwait(false);
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private sealed class OnboardingDraft
    {
        public string Name { get; set; } = string.Empty;
        public string RegistrationNumber { get; set; } = string.Empty;
        public string Country { get; set; } = DefaultCountry;
        public string TimeZone { get; set; } = DefaultTimeZone;
        public string FacilityName { get; set; } = string.Empty;
        public string FacilityAddress { get; set; } = string.Empty;
        public string FacilityCity { get; set; } = string.Empty;
        public bool IsVirtualFacility { get; set; }
        public string AdminFullName { get; set; } = string.Empty;
        public string AdminEmail { get; set; } = string.Empty;

        public void Reset()
        {
            Name = string.Empty;
            RegistrationNumber = string.Empty;
            Country = DefaultCountry;
            TimeZone = DefaultTimeZone;
            FacilityName = string.Empty;
            FacilityAddress = string.Empty;
            FacilityCity = string.Empty;
            IsVirtualFacility = false;
            AdminFullName = string.Empty;
            AdminEmail = string.Empty;
        }
    }
}
