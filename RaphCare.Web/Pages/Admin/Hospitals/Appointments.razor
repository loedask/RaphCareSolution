@page "/admin/hospitals/{ClinicId:guid}/appointments"
@layout AdminLayout
@using RaphCare.Domain.Common
@inject NavigationManager Navigation

<PageTitle>Appointments — RaphCare Admin</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <h1>Appointments</h1>
            <p class="admin-page-lead">Scheduled visits for @_clinicName. Times shown in @_timeZoneLabel.</p>
        </div>
        <span class="admin-progress-pill">@_totalCount appointment@(_totalCount == 1 ? "" : "s")</span>
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert alert-success">@_success</div>
    }

    @if (_isAdministrator)
    {
        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">Scheduling</p>
                    <h2>Book appointment</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                <div class="form-grid">
                    <label>
                        Patient
                        <select class="form-control" @bind="_bookPatientId">
                            <option value="">Select patient…</option>
                            @foreach (var patient in _patients)
                            {
                                <option value="@patient.PatientId">@patient.FirstName @patient.LastName</option>
                            }
                        </select>
                    </label>
                    <label>
                        Provider
                        <select class="form-control" @bind="_bookProviderId">
                            <option value="">Select provider…</option>
                            @foreach (var provider in _providers)
                            {
                                <option value="@provider.ProviderId">@provider.DisplayName</option>
                            }
                        </select>
                    </label>
                    <label>
                        Type
                        <select class="form-control" @bind="_bookType">
                            <option value="InPerson">In person</option>
                            <option value="Telemedicine">Telemedicine</option>
                        </select>
                    </label>
                    <label>
                        Start (@_timeZoneLabel)
                        <input class="form-control" type="datetime-local" @bind="_scheduledStart" @bind:format="yyyy-MM-ddTHH:mm" />
                    </label>
                    <label>
                        End (@_timeZoneLabel)
                        <input class="form-control" type="datetime-local" @bind="_scheduledEnd" @bind:format="yyyy-MM-ddTHH:mm" />
                    </label>
                    <label>
                        Reason
                        <input class="form-control" @bind="_bookReason" placeholder="Optional" />
                    </label>
                </div>
                <div class="admin-page-actions">
                    <button type="button" class="btn btn-primary" disabled="@_booking" @onclick="BookAppointmentAsync">
                        @(_booking ? "Booking…" : "Book appointment")
                    </button>
                </div>
            </div>
        </div>

        @if (_rescheduleId is Guid rescheduleId)
        {
            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Scheduling</p>
                        <h2>Reschedule appointment</h2>
                    </div>
                </header>
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            Provider
                            <select class="form-control" @bind="_rescheduleProviderId">
                                @foreach (var provider in _providers)
                                {
                                    <option value="@provider.ProviderId">@provider.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Start (@_timeZoneLabel)
                            <input class="form-control" type="datetime-local" @bind="_rescheduleStart" @bind:format="yyyy-MM-ddTHH:mm" />
                        </label>
                        <label>
                            End (@_timeZoneLabel)
                            <input class="form-control" type="datetime-local" @bind="_rescheduleEnd" @bind:format="yyyy-MM-ddTHH:mm" />
                        </label>
                        <label>
                            Reason
                            <input class="form-control" @bind="_rescheduleReason" placeholder="Optional" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-primary" disabled="@_rescheduling" @onclick="ConfirmRescheduleAsync">
                            @(_rescheduling ? "Saving…" : "Save changes")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelRescheduleForm">Cancel</button>
                    </div>
                </div>
            </div>
        }
    }

    <div class="admin-page-card">
        <div class="admin-page-card-body">
            <div class="admin-table-toolbar">
                <div class="claim-form-row">
                    <select class="form-control" @bind="_rangeFilter">
                        <option value="upcoming">Upcoming (30 days)</option>
                        <option value="today">Today</option>
                        <option value="all">All</option>
                    </select>
                    <button type="button" class="btn btn-secondary" @onclick="LoadAppointmentsAsync">Apply</button>
                </div>
            </div>

            @if (_loading)
            {
                <p class="text-muted">Loading appointments…</p>
            }
            else if (_appointments.Count == 0)
            {
                <p class="text-muted">No appointments match this filter.</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date & time</th>
                                <th>Patient</th>
                                <th>Provider</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Reason</th>
                                @if (_isAdministrator)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in _appointments)
                            {
                                <tr>
                                    <td>@FormatLocal(appt.ScheduledStart)</td>
                                    <td>
                                        <a href="/admin/hospitals/@ClinicId/patients/@appt.PatientId">@appt.PatientName</a>
                                    </td>
                                    <td>@appt.ProviderName</td>
                                    <td>@appt.Type</td>
                                    <td>@appt.Status</td>
                                    <td>@(string.IsNullOrWhiteSpace(appt.Reason) ? "—" : appt.Reason)</td>
                                    @if (_isAdministrator && appt.Status != "Cancelled")
                                    {
                                        <td class="admin-table-actions">
                                            @if (string.Equals(appt.Type, "Telemedicine", StringComparison.OrdinalIgnoreCase) && appt.Status != "Completed")
                                            {
                                                <a class="btn btn-ghost btn-sm" href="/admin/hospitals/@ClinicId/appointments/@appt.Id/tele">Join telehealth</a>
                                            }
                                            @if (appt.ActiveVisitId is Guid visitId)
                                            {
                                                <a class="btn btn-ghost btn-sm" href="/admin/hospitals/@ClinicId/visits/@visitId">Open visit</a>
                                            }
                                            else if (appt.Status != "Completed")
                                            {
                                                <button type="button" class="btn btn-ghost btn-sm" disabled="@(_startingVisitId == appt.Id)" @onclick="() => StartVisitAsync(appt.Id)">
                                                    @(_startingVisitId == appt.Id ? "…" : "Start visit")
                                                </button>
                                            }
                                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartReschedule(appt)">Reschedule</button>
                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@(_cancellingId == appt.Id)" @onclick="() => CancelAppointmentAsync(appt.Id)">
                                                @(_cancellingId == appt.Id ? "…" : "Cancel")
                                            </button>
                                        </td>
                                    }
                                    else if (_isAdministrator)
                                    {
                                        <td></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="admin-pagination">
                    <span class="admin-pagination-meta">
                        Page @_pageNumber of @_pageCount · @_totalCount appointment@(_totalCount == 1 ? "" : "s")
                    </span>
                    <div class="admin-pagination-actions">
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_pageNumber <= 1 || _loading)" @onclick="PreviousPageAsync">Previous</button>
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_pageNumber >= _pageCount || _loading)" @onclick="NextPageAsync">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="admin-page-actions">
        <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId?tab=appointments">← Back to hospital</a>
    </div>
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _booking;
    private bool _rescheduling;
    private bool _isAdministrator;
    private string? _error;
    private string? _success;
    private string _clinicName = "this hospital";
    private string _clinicTimeZone = "UTC";
    private string _timeZoneLabel = "hospital time";
    private string _rangeFilter = "upcoming";
    private string _bookPatientId = string.Empty;
    private string _bookProviderId = string.Empty;
    private string _bookType = "InPerson";
    private string _bookReason = string.Empty;
    private DateTime _scheduledStart;
    private DateTime _scheduledEnd;
    private Guid? _rescheduleId;
    private Guid? _cancellingId;
    private Guid? _startingVisitId;
    private string _rescheduleProviderId = string.Empty;
    private string _rescheduleReason = string.Empty;
    private DateTime _rescheduleStart;
    private DateTime _rescheduleEnd;
    private int _pageNumber = 1;
    private const int PageSize = 20;
    private int _pageCount = 1;
    private int _totalCount;
    private IReadOnlyList<ClinicAppointmentListItem> _appointments = Array.Empty<ClinicAppointmentListItem>();
    private IReadOnlyList<ClinicPatientListItem> _patients = Array.Empty<ClinicPatientListItem>();
    private IReadOnlyList<ClinicProviderListItem> _providers = Array.Empty<ClinicProviderListItem>();

    protected override async Task OnInitializedAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            _timeZoneLabel = string.IsNullOrWhiteSpace(_clinicTimeZone) ? "hospital time" : _clinicTimeZone;
            SetDefaultBookingTimes();
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        if (_isAdministrator)
            await LoadBookFormDataAsync();

        await LoadAppointmentsAsync();
    }

    private void SetDefaultBookingTimes()
    {
        var localNow = ClinicTimeZoneHelper.ToClinicLocal(DateTime.UtcNow, _clinicTimeZone);
        _scheduledStart = localNow.Date.AddHours(9);
        _scheduledEnd = localNow.Date.AddHours(9).AddMinutes(30);
    }

    private string FormatLocal(DateTime utc) =>
        ClinicTimeZoneHelper.FormatClinicLocal(utc, _clinicTimeZone);

    private DateTime ToUtc(DateTime clinicLocal) =>
        ClinicTimeZoneHelper.ToUtcFromClinicLocal(clinicLocal, _clinicTimeZone);

    private async Task LoadBookFormDataAsync()
    {
        var patientsTask = AdminClinicService.GetPatientsAsync(ClinicId, 1, 100);
        var providersTask = AdminClinicService.GetProvidersAsync(ClinicId);
        await Task.WhenAll(patientsTask, providersTask).ConfigureAwait(false);

        if (patientsTask.Result.IsSuccess && patientsTask.Result.Data is not null)
            _patients = patientsTask.Result.Data.Items;

        if (providersTask.Result.IsSuccess && providersTask.Result.Data is not null)
            _providers = providersTask.Result.Data.Where(p => p.IsActive).ToList();
    }

    private async Task BookAppointmentAsync()
    {
        if (!Guid.TryParse(_bookPatientId, out var patientId) || !Guid.TryParse(_bookProviderId, out var providerId))
        {
            _error = "Select a patient and provider.";
            return;
        }

        if (_scheduledEnd <= _scheduledStart)
        {
            _error = "End time must be after start time.";
            return;
        }

        _booking = true;
        _error = null;
        _success = null;
        var response = await AdminClinicService.BookAppointmentAsync(ClinicId, new BookClinicAppointmentRequest
        {
            PatientId = patientId,
            ProviderId = providerId,
            ScheduledStart = ToUtc(_scheduledStart),
            ScheduledEnd = ToUtc(_scheduledEnd),
            Type = _bookType,
            Reason = string.IsNullOrWhiteSpace(_bookReason) ? null : _bookReason.Trim()
        });
        _booking = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? "Could not book appointment.";
            return;
        }

        _success = "Appointment booked.";
        _bookReason = string.Empty;
        _pageNumber = 1;
        _rangeFilter = "upcoming";
        await LoadAppointmentsAsync();
    }

    private void StartReschedule(ClinicAppointmentListItem appt)
    {
        _rescheduleId = appt.Id;
        _rescheduleProviderId = appt.ProviderId.ToString();
        _rescheduleReason = appt.Reason ?? string.Empty;
        _rescheduleStart = ClinicTimeZoneHelper.ToClinicLocal(appt.ScheduledStart, _clinicTimeZone);
        _rescheduleEnd = ClinicTimeZoneHelper.ToClinicLocal(appt.ScheduledEnd, _clinicTimeZone);
        _error = null;
        _success = null;
    }

    private void CancelRescheduleForm() => _rescheduleId = null;

    private async Task ConfirmRescheduleAsync()
    {
        if (_rescheduleId is not Guid appointmentId || !Guid.TryParse(_rescheduleProviderId, out var providerId))
            return;

        if (_rescheduleEnd <= _rescheduleStart)
        {
            _error = "End time must be after start time.";
            return;
        }

        _rescheduling = true;
        _error = null;
        _success = null;
        var response = await AdminClinicService.RescheduleAppointmentAsync(ClinicId, appointmentId, new RescheduleClinicAppointmentRequest
        {
            ProviderId = providerId,
            ScheduledStart = ToUtc(_rescheduleStart),
            ScheduledEnd = ToUtc(_rescheduleEnd),
            Reason = _rescheduleReason
        });
        _rescheduling = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? "Could not reschedule appointment.";
            return;
        }

        _success = "Appointment rescheduled.";
        _rescheduleId = null;
        await LoadAppointmentsAsync();
    }

    private async Task StartVisitAsync(Guid appointmentId)
    {
        _startingVisitId = appointmentId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.StartVisitAsync(ClinicId, appointmentId);
        _startingVisitId = null;

        if (!response.IsSuccess || response.Data is null)
        {
            _error = response.ErrorMessage ?? "Could not start visit.";
            return;
        }

        Navigation.NavigateTo($"/admin/hospitals/{ClinicId}/visits/{response.Data.Id}");
    }

    private async Task CancelAppointmentAsync(Guid appointmentId)
    {
        _cancellingId = appointmentId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CancelAppointmentAsync(ClinicId, appointmentId);
        _cancellingId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? "Could not cancel appointment.";
            return;
        }

        _success = "Appointment cancelled.";
        if (_rescheduleId == appointmentId)
            _rescheduleId = null;
        await LoadAppointmentsAsync();
    }

    private async Task LoadAppointmentsAsync()
    {
        _loading = true;
        _error = null;

        DateTime? from = null;
        DateTime? to = null;
        var nowUtc = DateTime.UtcNow;

        switch (_rangeFilter)
        {
            case "today":
                (from, to) = ClinicTimeZoneHelper.GetClinicDayUtcRange(nowUtc, _clinicTimeZone);
                break;
            case "upcoming":
                from = nowUtc.Date;
                to = nowUtc.Date.AddDays(30);
                break;
        }

        var response = await AdminClinicService.GetAppointmentsAsync(ClinicId, _pageNumber, PageSize, from, to);
        _loading = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _error = response.ErrorMessage ?? "Could not load appointments.";
            return;
        }

        _appointments = response.Data.Items;
        _totalCount = response.Data.TotalCount;
        _pageCount = Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    }

    private async Task PreviousPageAsync()
    {
        if (_pageNumber <= 1) return;
        _pageNumber--;
        await LoadAppointmentsAsync();
    }

    private async Task NextPageAsync()
    {
        if (_pageNumber >= _pageCount) return;
        _pageNumber++;
        await LoadAppointmentsAsync();
    }
}
