    private async Task SaveWardAsync()
    {
        if (_editWardId is not Guid wardId || string.IsNullOrWhiteSpace(_editWardName))
        {
            _error = "Ward name is required.";
            return;
        }

        var ward = _board?.Wards.FirstOrDefault(w => w.Id == wardId);
        if (ward is null) return;

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.UpdateWardAsync(ClinicId, wardId, new UpdateWardRequest
        {
            Name = _editWardName.Trim(),
            Code = string.IsNullOrWhiteSpace(_editWardCode) ? null : _editWardCode.Trim(),
            IsActive = ward.IsActive
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? "Could not update ward.";
            return;
        }

        _success = "Ward updated.";
        _editWardId = null;
        await LoadBoardAsync();
    }

