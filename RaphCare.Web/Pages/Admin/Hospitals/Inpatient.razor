@page "/admin/hospitals/{ClinicId:guid}/inpatient"
@layout AdminLayout
@using RaphCare.Domain.Common

<PageTitle>Inpatient — RaphCare Admin</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <h1>Inpatient</h1>
            <p class="admin-page-lead">Wards, rooms, beds, and admissions for @_clinicName.</p>
        </div>
        @if (_board is not null)
        {
            <span class="admin-progress-pill">@_board.OccupiedBeds / @_board.TotalBeds occupied</span>
        }
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert alert-success">@_success</div>
    }

    @if (_loading)
    {
        <p class="text-muted">Loading inpatient board…</p>
    }
    else if (_board is not null)
    {
        <div class="stat-grid" style="margin-bottom: 1.25rem;">
            <div class="stat-card stat-card-blue">
                <div class="stat-card-top"><span class="stat-label">Beds</span></div>
                <div class="stat-value">@_board.TotalBeds</div>
            </div>
            <div class="stat-card stat-card-green">
                <div class="stat-card-top"><span class="stat-label">Available</span></div>
                <div class="stat-value">@_board.AvailableBeds</div>
            </div>
            <div class="stat-card stat-card-violet">
                <div class="stat-card-top"><span class="stat-label">Occupied</span></div>
                <div class="stat-value">@_board.OccupiedBeds</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-top"><span class="stat-label">Maintenance</span></div>
                <div class="stat-value">@_board.MaintenanceBeds</div>
            </div>
        </div>

        @if (_isAdministrator)
        {
            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Setup</p>
                        <h2>Add capacity</h2>
                    </div>
                </header>
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            Facility (ward)
                            <select class="form-control" @bind="_wardFacilityId">
                                <option value="">Select facility…</option>
                                @foreach (var f in _physicalFacilities)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            Ward name
                            <input class="form-control" @bind="_wardName" placeholder="e.g. Medical Ward A" />
                        </label>
                        <label>
                            Code
                            <input class="form-control" @bind="_wardCode" placeholder="Optional" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateWardAsync">Add ward</button>
                    </div>

                    <div class="form-grid" style="margin-top: 1.25rem;">
                        <label>
                            Ward (room)
                            <select class="form-control" @bind="_roomWardId">
                                <option value="">Select ward…</option>
                                @foreach (var w in _board.Wards.Where(x => x.IsActive))
                                {
                                    <option value="@w.Id">@w.Name (@w.FacilityName)</option>
                                }
                            </select>
                        </label>
                        <label>
                            Room name
                            <input class="form-control" @bind="_roomName" placeholder="e.g. 101" />
                        </label>
                        <label>
                            Room type
                            <input class="form-control" @bind="_roomType" placeholder="Optional" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateRoomAsync">Add room</button>
                    </div>

                    <div class="form-grid" style="margin-top: 1.25rem;">
                        <label>
                            Room (bed)
                            <select class="form-control" @bind="_bedRoomId">
                                <option value="">Select room…</option>
                                @foreach (var room in _allRooms.Where(r => r.IsActive))
                                {
                                    <option value="@room.Id">@room.WardName — @room.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            Bed label
                            <input class="form-control" @bind="_bedLabel" placeholder="e.g. A" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateBedAsync">Add bed</button>
                    </div>
                </div>
            </div>

            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Care</p>
                        <h2>Admit patient</h2>
                    </div>
                </header>
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            Find patient
                            <div class="inpatient-search-row">
                                <input class="form-control" @bind="_patientSearch" @bind:event="oninput" placeholder="Name or phone…" />
                                <button type="button" class="btn btn-secondary" disabled="@_searchingPatients" @onclick="SearchPatientsAsync">
                                    @(_searchingPatients ? "…" : "Search")
                                </button>
                            </div>
                        </label>
                        <label>
                            Patient
                            <select class="form-control" @bind="_admitPatientId">
                                <option value="">Select patient…</option>
                                @foreach (var p in _patients)
                                {
                                    <option value="@p.PatientId">@p.FirstName @p.LastName</option>
                                }
                            </select>
                        </label>
                        <label>
                            Available bed
                            <select class="form-control" @bind="_admitBedId">
                                <option value="">Select bed…</option>
                                @foreach (var bed in _availableBeds)
                                {
                                    <option value="@bed.Id">@bed.Display</option>
                                }
                            </select>
                        </label>
                        <label>
                            Reason
                            <input class="form-control" @bind="_admitReason" placeholder="Optional" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="AdmitAsync">Admit</button>
                    </div>
                </div>
            </div>
        }

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">Board</p>
                    <h2>Active admissions</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                @if (_board.ActiveAdmissionsList.Count == 0)
                {
                    <p class="text-muted">No patients currently admitted.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Location</th>
                                    <th>Admitted</th>
                                    <th>Reason</th>
                                    @if (_isAdministrator)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var adm in _board.ActiveAdmissionsList)
                                {
                                    <tr>
                                        <td>
                                            <a href="/admin/hospitals/@ClinicId/patients/@adm.PatientId">@adm.PatientName</a>
                                        </td>
                                        <td>@adm.FacilityName · @adm.WardName · @adm.RoomName · Bed @adm.BedLabel</td>
                                        <td>@ClinicTimeZoneHelper.FormatClinicLocal(adm.AdmittedAt, _clinicTimeZone)</td>
                                        <td>@(string.IsNullOrWhiteSpace(adm.Reason) ? "—" : adm.Reason)</td>
                                        @if (_isAdministrator)
                                        {
                                            <td class="inpatient-actions">
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginTransfer(adm.Id)">Transfer</button>
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginDischarge(adm.Id)">Discharge</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_isAdministrator && _dischargeAdmissionId is Guid dischargeId)
                {
                    <div class="inpatient-action-panel">
                        <h3>Discharge</h3>
                        <label>
                            Notes (optional)
                            <textarea class="form-control" rows="2" @bind="_dischargeNotes" placeholder="Discharge summary…"></textarea>
                        </label>
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-primary" disabled="@(_dischargingId == dischargeId)" @onclick="ConfirmDischargeAsync">
                                @(_dischargingId == dischargeId ? "…" : "Confirm discharge")
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="CancelDischarge">Cancel</button>
                        </div>
                    </div>
                }

                @if (_isAdministrator && _transferAdmissionId is Guid transferId)
                {
                    <div class="inpatient-action-panel">
                        <h3>Transfer bed</h3>
                        <div class="form-grid">
                            <label>
                                Target bed
                                <select class="form-control" @bind="_transferBedId">
                                    <option value="">Select available bed…</option>
                                    @foreach (var bed in _availableBeds)
                                    {
                                        <option value="@bed.Id">@bed.Display</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Notes (optional)
                                <input class="form-control" @bind="_transferNotes" placeholder="Transfer reason…" />
                            </label>
                        </div>
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-primary" disabled="@(_transferringId == transferId)" @onclick="ConfirmTransferAsync">
                                @(_transferringId == transferId ? "…" : "Confirm transfer")
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="CancelTransfer">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">Map</p>
                    <h2>Beds by ward</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                @if (_board.Wards.Count == 0)
                {
                    <p class="text-muted">No wards yet. Add a physical facility, then create a ward, rooms, and beds.</p>
                }
                else
                {
                    @foreach (var ward in _board.Wards)
                    {
                        <div class="inpatient-ward" style="margin-bottom: 1.25rem;">
                            <div class="inpatient-ward-head">
                                <h3>
                                    @ward.Name
                                    <span class="text-muted">· @ward.FacilityName</span>
                                    @if (!ward.IsActive)
                                    {
                                        <span class="admin-progress-pill">Inactive</span>
                                    }
                                </h3>
                                @if (_isAdministrator)
                                {
                                    <div class="inpatient-actions">
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditWard(ward)">Edit</button>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => ToggleWardActiveAsync(ward)">
                                            @(ward.IsActive ? "Deactivate" : "Reactivate")
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => DeleteWardAsync(ward.Id)">Delete</button>
                                    </div>
                                }
                            </div>

                            @if (_editWardId == ward.Id)
                            {
                                <div class="inpatient-action-panel">
                                    <div class="form-grid">
                                        <label>
                                            Ward name
                                            <input class="form-control" @bind="_editWardName" />
                                        </label>
                                        <label>
                                            Code
                                            <input class="form-control" @bind="_editWardCode" />
                                        </label>
                                    </div>
                                    <div class="admin-page-actions">
                                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="SaveWardAsync">Save</button>
                                        <button type="button" class="btn btn-ghost" @onclick="CancelEditWard">Cancel</button>
                                    </div>
                                </div>
                            }

                            @if (ward.Rooms.Count == 0)
                            {
                                <p class="text-muted">No rooms in this ward.</p>
                            }
                            else
                            {
                                @foreach (var room in ward.Rooms)
                                {
                                    <div style="margin: 0.75rem 0;">
                                        <div class="inpatient-ward-head">
                                            <strong>
                                                Room @room.Name
                                                @(string.IsNullOrWhiteSpace(room.RoomType) ? "" : $" ({room.RoomType})")
                                                @if (!room.IsActive)
                                                {
                                                    <span class="text-muted">· inactive</span>
                                                }
                                            </strong>
                                            @if (_isAdministrator)
                                            {
                                                <div class="inpatient-actions">
                                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditRoom(room)">Edit</button>
                                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => ToggleRoomActiveAsync(room)">
                                                        @(room.IsActive ? "Deactivate" : "Reactivate")
                                                    </button>
                                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => DeleteRoomAsync(room.Id)">Delete</button>
                                                </div>
                                            }
                                        </div>

                                        @if (_editRoomId == room.Id)
                                        {
                                            <div class="inpatient-action-panel">
                                                <div class="form-grid">
                                                    <label>
                                                        Room name
                                                        <input class="form-control" @bind="_editRoomName" />
                                                    </label>
                                                    <label>
                                                        Room type
                                                        <input class="form-control" @bind="_editRoomType" />
                                                    </label>
                                                </div>
                                                <div class="admin-page-actions">
                                                    <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="SaveRoomAsync">Save</button>
                                                    <button type="button" class="btn btn-ghost" @onclick="CancelEditRoom">Cancel</button>
                                                </div>
                                            </div>
                                        }

                                        <div class="bed-chip-row">
                                            @foreach (var bed in room.Beds)
                                            {
                                                var chipClass = !bed.IsActive
                                                    ? "bed-chip-other"
                                                    : bed.Status == "Occupied"
                                                        ? "bed-chip-occupied"
                                                        : bed.Status == "Available"
                                                            ? "bed-chip-free"
                                                            : bed.Status == "Maintenance"
                                                                ? "bed-chip-maintenance"
                                                                : "bed-chip-other";
                                                <div class="bed-chip-wrap">
                                                    <span class="bed-chip @chipClass"
                                                          title="@(bed.CurrentPatientName ?? bed.Status)@(bed.IsActive ? "" : " (inactive)")">
                                                        @bed.Label
                                                        @if (!string.IsNullOrWhiteSpace(bed.CurrentPatientName))
                                                        {
                                                            <small>@bed.CurrentPatientName</small>
                                                        }
                                                        else
                                                        {
                                                            <small>@bed.Status</small>
                                                        }
                                                    </span>
                                                    @if (_isAdministrator)
                                                    {
                                                        <div class="inpatient-actions bed-chip-actions">
                                                            @if (bed.Status == "Available" && bed.IsActive)
                                                            {
                                                                <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => SetBedStatusAsync(bed.Id, "Maintenance")">Maintenance</button>
                                                            }
                                                            else if (bed.Status == "Maintenance" && bed.IsActive)
                                                            {
                                                                <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => SetBedStatusAsync(bed.Id, "Available")">Clear</button>
                                                            }
                                                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditBed(bed)">Edit</button>
                                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => DeleteBedAsync(bed.Id)">Delete</button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @if (_editBedId is Guid editingBedId && room.Beds.Any(b => b.Id == editingBedId))
                                        {
                                            <div class="inpatient-action-panel">
                                                <div class="form-grid">
                                                    <label>
                                                        Bed label
                                                        <input class="form-control" @bind="_editBedLabel" />
                                                    </label>
                                                    <label class="inpatient-checkbox">
                                                        <input type="checkbox" @bind="_editBedActive" />
                                                        Active
                                                    </label>
                                                </div>
                                                <div class="admin-page-actions">
                                                    <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="SaveBedAsync">Save</button>
                                                    <button type="button" class="btn btn-ghost" @onclick="CancelEditBed">Cancel</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">History</p>
                    <h2>Admission history</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                <div class="form-grid" style="margin-bottom: 1rem;">
                    <label>
                        Status filter
                        <select class="form-control" @bind="_historyStatus">
                            <option value="">All</option>
                            <option value="Admitted">Admitted</option>
                            <option value="Discharged">Discharged</option>
                        </select>
                    </label>
                    <div class="admin-page-actions" style="align-self: end;">
                        <button type="button" class="btn btn-secondary" disabled="@_loadingHistory" @onclick="LoadHistoryAsync">
                            @(_loadingHistory ? "…" : "Apply")
                        </button>
                    </div>
                </div>

                @if (_history.Count == 0 && !_loadingHistory)
                {
                    <p class="text-muted">No admissions match this filter.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Location</th>
                                    <th>Admitted</th>
                                    <th>Discharged</th>
                                    <th>Status</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var adm in _history)
                                {
                                    <tr>
                                        <td>
                                            <a href="/admin/hospitals/@ClinicId/patients/@adm.PatientId">@adm.PatientName</a>
                                        </td>
                                        <td>@adm.FacilityName · @adm.WardName · @adm.RoomName · Bed @adm.BedLabel</td>
                                        <td>@ClinicTimeZoneHelper.FormatClinicLocal(adm.AdmittedAt, _clinicTimeZone)</td>
                                        <td>@(adm.DischargedAt is null ? "—" : ClinicTimeZoneHelper.FormatClinicLocal(adm.DischargedAt.Value, _clinicTimeZone))</td>
                                        <td>@adm.Status</td>
                                        <td>@(string.IsNullOrWhiteSpace(adm.Notes) ? "—" : adm.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_historyTotal > _history.Count)
                    {
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-secondary" disabled="@_loadingHistory" @onclick="LoadMoreHistoryAsync">
                                Load more (@_history.Count of @_historyTotal)
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div class="admin-page-actions">
        <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId">← Back to hospital</a>
    </div>
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;
    private bool _searchingPatients;
    private bool _loadingHistory;
    private bool _isAdministrator;
    private Guid? _dischargingId;
    private Guid? _transferringId;
    private Guid? _dischargeAdmissionId;
    private Guid? _transferAdmissionId;
    private Guid? _editWardId;
    private Guid? _editRoomId;
    private Guid? _editBedId;
    private string? _error;
    private string? _success;
    private string _clinicName = "this hospital";
    private string _clinicTimeZone = "UTC";
    private ClinicInpatientBoard? _board;
    private IReadOnlyList<FacilityListItem> _physicalFacilities = Array.Empty<FacilityListItem>();
    private IReadOnlyList<ClinicPatientListItem> _patients = Array.Empty<ClinicPatientListItem>();
    private List<ClinicAdmission> _history = [];
    private int _historyTotal;
    private int _historyPage = 1;
    private const int HistoryPageSize = 20;

    private string _wardFacilityId = string.Empty;
    private string _wardName = string.Empty;
    private string _wardCode = string.Empty;
    private string _roomWardId = string.Empty;
    private string _roomName = string.Empty;
    private string _roomType = string.Empty;
    private string _bedRoomId = string.Empty;
    private string _bedLabel = string.Empty;
    private string _patientSearch = string.Empty;
    private string _admitPatientId = string.Empty;
    private string _admitBedId = string.Empty;
    private string _admitReason = string.Empty;
    private string _dischargeNotes = string.Empty;
    private string _transferBedId = string.Empty;
    private string _transferNotes = string.Empty;
    private string _historyStatus = string.Empty;
    private string _editWardName = string.Empty;
    private string _editWardCode = string.Empty;
    private string _editRoomName = string.Empty;
    private string _editRoomType = string.Empty;
    private string _editBedLabel = string.Empty;
    private bool _editBedActive = true;

    private sealed record RoomOption(Guid Id, string WardName, string Name, bool IsActive);
    private sealed record BedOption(Guid Id, string Display);

    private IEnumerable<RoomOption> _allRooms =>
        _board?.Wards.SelectMany(w => w.Rooms.Select(r => new RoomOption(r.Id, w.Name, r.Name, r.IsActive && w.IsActive)))
        ?? Enumerable.Empty<RoomOption>();

    private IEnumerable<BedOption> _availableBeds =>
        _board?.Wards
            .Where(w => w.IsActive)
            .SelectMany(w => w.Rooms.Where(r => r.IsActive).SelectMany(r => r.Beds
                .Where(b => b.IsActive && b.Status == "Available")
                .Select(b => new BedOption(b.Id, $"{w.Name} · {r.Name} · Bed {b.Label}"))))
        ?? Enumerable.Empty<BedOption>();

    protected override async Task OnInitializedAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            _physicalFacilities = clinicResponse.Data.Facilities.Where(f => !f.IsVirtual).ToList();
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        if (_isAdministrator)
            await SearchPatientsAsync();

        await LoadBoardAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadBoardAsync()
    {
        _loading = true;
        _error = null;
        var response = await AdminClinicService.GetInpatientBoardAsync(ClinicId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
            _board = response.Data;
        else
            _error = response.ErrorMessage ?? "Could not load inpatient board.";
    }

    private async Task SearchPatientsAsync()
    {
        _searchingPatients = true;
        var patients = await AdminClinicService.GetPatientsAsync(
            ClinicId, 1, 50, string.IsNullOrWhiteSpace(_patientSearch) ? null : _patientSearch.Trim());
        _searchingPatients = false;

        if (patients.IsSuccess && patients.Data is not null)
            _patients = patients.Data.Items;
        else
            _error = patients.ErrorMessage ?? "Could not load patients.";
    }

    private async Task LoadHistoryAsync()
    {
        _historyPage = 1;
        _loadingHistory = true;
        var response = await AdminClinicService.GetAdmissionsAsync(
            ClinicId, _historyPage, HistoryPageSize, string.IsNullOrWhiteSpace(_historyStatus) ? null : _historyStatus);
        _loadingHistory = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _history = response.Data.Items.ToList();
            _historyTotal = response.Data.TotalCount;
        }
        else
            _error = response.ErrorMessage ?? "Could not load admission history.";
    }

    private async Task LoadMoreHistoryAsync()
    {
        _historyPage++;
        _loadingHistory = true;
        var response = await AdminClinicService.GetAdmissionsAsync(
            ClinicId, _historyPage, HistoryPageSize, string.IsNullOrWhiteSpace(_historyStatus) ? null : _historyStatus);
        _loadingHistory = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _history.AddRange(response.Data.Items);
            _historyTotal = response.Data.TotalCount;
        }
        else
            _error = response.ErrorMessage ?? "Could not load more admissions.";
    }

