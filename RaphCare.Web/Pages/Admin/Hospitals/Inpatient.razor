@page "/admin/hospitals/{ClinicId:guid}/inpatient"
@layout AdminLayout
@using RaphCare.Domain.Common
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("Inpatient_PageTitle")</PageTitle>

<section class="admin-page">
    <AdminPageHeader Title="@AppResources.T("Common_Inpatient")"
                     Lead="@AppResources.Format("Inpatient_Lead", _clinicName)">
        <div class="admin-page-actions">
            @if (_board is not null)
            {
                <span class="admin-progress-pill">@AppResources.Format("Inpatient_OccupiedPill", _board.OccupiedBeds, _board.TotalBeds)</span>
            }
            <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId">@AppResources.T("Common_BackToHospital")</a>
        </div>
    </AdminPageHeader>

    <AdminAlert Message="@_error" />
    <AdminAlert Tone="success" Message="@_success" />

    @if (_loading)
    {
        <p class="text-muted">@AppResources.T("Inpatient_LoadingBoard")</p>
    }
    else if (_board is not null)
    {
        <AdminStatGrid>
            <AdminStatCard Label="@AppResources.T("Common_Beds")" Value="@_board.TotalBeds" Accent="accent" />
            <AdminStatCard Label="@AppResources.T("Common_Available")" Value="@_board.AvailableBeds" Accent="success" />
            <AdminStatCard Label="@AppResources.T("Common_Occupied")" Value="@_board.OccupiedBeds" Accent="violet" />
            <AdminStatCard Label="@AppResources.T("Common_Maintenance")" Value="@_board.MaintenanceBeds" />
        </AdminStatGrid>

        <div class="inpatient-layout">
            <nav class="inpatient-tabs" aria-label="@AppResources.T("Inpatient_SectionsAria")">
                @if (_isAdministrator)
                {
                    <button type="button" class="inpatient-tab @(_tab == "capacity" ? "active" : "")" @onclick='() => SetTab("capacity")'>
                        <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
                        @AppResources.T("Inpatient_AddCapacity")
                    </button>
                    <button type="button" class="inpatient-tab @(_tab == "admit" ? "active" : "")" @onclick='() => SetTab("admit")'>
                        <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3.1-6 7-6"/><path d="M16 11v6M13 14h6"/></svg>
                        @AppResources.T("Inpatient_AdmitPatientTitle")
                    </button>
                }
                <button type="button" class="inpatient-tab @(_tab == "admissions" ? "active" : "")" @onclick='() => SetTab("admissions")'>
                    <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    <span>@AppResources.T("Inpatient_ActiveAdmissionsTitle")</span>
                    <span class="inpatient-tab-count">@_board.ActiveAdmissionsList.Count</span>
                </button>
                <button type="button" class="inpatient-tab @(_tab == "beds" ? "active" : "")" @onclick='() => SetTab("beds")'>
                    <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v12H3z"/><path d="M3 11h18"/><path d="M8 7V5h8v2"/></svg>
                    @AppResources.T("Inpatient_BedsByWardTitle")
                </button>
                <button type="button" class="inpatient-tab @(_tab == "history" ? "active" : "")" @onclick='() => SetTab("history")'>
                    <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    @AppResources.T("Inpatient_AdmissionHistoryTitle")
                </button>
            </nav>
            <div class="inpatient-tab-panel">
        @if (_isAdministrator && _tab == "capacity")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Inpatient_SetupEyebrow")"
                           Title="@AppResources.T("Inpatient_AddCapacity")"
                           Lead="@AppResources.T("Inpatient_AddCapacityLead")">
                <div class="admin-page-card-body">
                    <div class="inpatient-capacity-steps">
                        <section class="inpatient-capacity-step" aria-labelledby="capacity-step-ward">
                            <div class="inpatient-capacity-step-head">
                                <span class="inpatient-capacity-step-num" aria-hidden="true">1</span>
                                <h3 id="capacity-step-ward">@AppResources.T("Inpatient_AddWard")</h3>
                            </div>
                            <div class="inpatient-capacity-grid">
                                <label>
                                    @AppResources.T("Common_Facility")
                                    <SearchableSelect @ref="_facilitySelect"
                                                      TValue="string"
                                                      @bind-Value="_wardFacilityId"
                                                      Placeholder="@AppResources.T("Inpatient_SelectFacility")"
                                                      Options="FacilitySelectOptions">
                                        <Footer>
                                            <button type="button" class="searchable-select-footer-btn" @onclick="BeginAddFacility">
                                                @AppResources.T("Common_AddFacility")
                                            </button>
                                        </Footer>
                                    </SearchableSelect>
                                </label>
                                <label>
                                    @AppResources.T("Inpatient_WardNameLabel")
                                    <input class="form-control" @bind="_wardName" placeholder="@AppResources.T("Inpatient_WardNamePlaceholder")" />
                                </label>
                                <label>
                                    @AppResources.T("Inpatient_CodeLabel")
                                    <input class="form-control" @bind="_wardCode" placeholder="@AppResources.T("Common_Optional")" />
                                </label>
                            </div>
                            @if (_showFacilityForm)
                            {
                                <div class="inpatient-action-panel">
                                    <h3>@AppResources.T("Common_AddFacility")</h3>
                                    @if (_physicalFacilities.Count == 0)
                                    {
                                        <p class="text-muted">@AppResources.T("Inpatient_NoFacilitiesHint")</p>
                                    }
                                    <div class="form-grid">
                                        <label>
                                            @AppResources.T("Common_Name")
                                            <input class="form-control" @bind="_facilityName" placeholder="@AppResources.T("Common_MainCampusPlaceholder")" />
                                        </label>
                                        <label>
                                            @AppResources.T("Common_City")
                                            <input class="form-control" @bind="_facilityCity" placeholder="@AppResources.T("Common_JohannesburgPlaceholder")" />
                                        </label>
                                        <label>
                                            @AppResources.T("Common_Address")
                                            <input class="form-control" @bind="_facilityAddress" placeholder="@AppResources.T("Common_StreetAddress")" />
                                        </label>
                                        <label>
                                            @AppResources.T("Common_Country")
                                            <input class="form-control" @bind="_facilityCountry" placeholder="@_clinicCountry" />
                                        </label>
                                    </div>
                                    <div class="admin-page-actions" style="margin-top: 0.75rem;">
                                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateFacilityAsync">
                                            @AppResources.T("Common_AddFacilityButton")
                                        </button>
                                        @if (_physicalFacilities.Count > 0)
                                        {
                                            <button type="button" class="btn btn-ghost" @onclick="CancelAddFacility">@AppResources.T("Common_Cancel")</button>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="admin-page-actions">
                                <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateWardAsync">@AppResources.T("Inpatient_AddWard")</button>
                            </div>
                        </section>

                        <section class="inpatient-capacity-step" aria-labelledby="capacity-step-room">
                            <div class="inpatient-capacity-step-head">
                                <span class="inpatient-capacity-step-num" aria-hidden="true">2</span>
                                <h3 id="capacity-step-room">@AppResources.T("Inpatient_AddRoom")</h3>
                            </div>
                            <div class="inpatient-capacity-grid">
                                <label>
                                    @AppResources.T("Inpatient_WardLabel")
                                    <SearchableSelect TValue="string"
                                                      @bind-Value="_roomWardId"
                                                      Placeholder="@AppResources.T("Inpatient_SelectWard")"
                                                      Options="WardSelectOptions" />
                                </label>
                                <label>
                                    @AppResources.T("Inpatient_RoomNameLabel")
                                    <input class="form-control" @bind="_roomName" placeholder="@AppResources.T("Inpatient_RoomNamePlaceholder")" />
                                </label>
                                <label>
                                    @AppResources.T("Inpatient_RoomTypeLabel")
                                    <input class="form-control" @bind="_roomType" placeholder="@AppResources.T("Common_Optional")" />
                                </label>
                            </div>
                            <div class="admin-page-actions">
                                <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateRoomAsync">@AppResources.T("Inpatient_AddRoom")</button>
                            </div>
                        </section>

                        <section class="inpatient-capacity-step" aria-labelledby="capacity-step-bed">
                            <div class="inpatient-capacity-step-head">
                                <span class="inpatient-capacity-step-num" aria-hidden="true">3</span>
                                <h3 id="capacity-step-bed">@AppResources.T("Inpatient_AddBed")</h3>
                            </div>
                            <div class="inpatient-capacity-grid inpatient-capacity-grid-bed">
                                <label>
                                    @AppResources.T("Common_Room")
                                    <SearchableSelect TValue="string"
                                                      @bind-Value="_bedRoomId"
                                                      Placeholder="@AppResources.T("Inpatient_SelectRoom")"
                                                      Options="RoomSelectOptions" />
                                </label>
                                <label>
                                    @AppResources.T("Common_BedLabel")
                                    <input class="form-control" @bind="_bedLabel" placeholder="@AppResources.T("Inpatient_BedLabelPlaceholder")" />
                                </label>
                            </div>
                            <div class="admin-page-actions">
                                <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="CreateBedAsync">@AppResources.T("Inpatient_AddBed")</button>
                            </div>
                        </section>
                    </div>
                </div>
            </AdminPageCard>
        }

        @if (_isAdministrator && _tab == "admit")
        {
            <AdminPageCard Eyebrow="@AppResources.T("Inpatient_CareEyebrow")" Title="@AppResources.T("Inpatient_AdmitPatientTitle")">
                <div class="admin-page-card-body">
                    <div class="form-grid">
                        <label>
                            @AppResources.T("Inpatient_FindPatientLabel")
                            <div class="inpatient-search-row">
                                <input class="form-control" @bind="_patientSearch" @bind:event="oninput" placeholder="@AppResources.T("Inpatient_NameOrPhonePlaceholder")" />
                                <button type="button" class="btn btn-secondary" disabled="@_searchingPatients" @onclick="SearchPatientsAsync">
                                    @(_searchingPatients ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_Search"))
                                </button>
                            </div>
                        </label>
                        <label>
                            @AppResources.T("Common_Patient")
                            <SearchableSelect TValue="string"
                                              @bind-Value="_admitPatientId"
                                              Placeholder="@AppResources.T("Inpatient_SelectPatient")"
                                              Options="AdmitPatientOptions" />
                        </label>
                        <label>
                            @AppResources.T("Inpatient_AvailableBedLabel")
                            <SearchableSelect TValue="string"
                                              @bind-Value="_admitBedId"
                                              Placeholder="@AppResources.T("Inpatient_SelectBed")"
                                              Options="AvailableBedOptions" />
                        </label>
                        <label>
                            @AppResources.T("Common_Reason")
                            <input class="form-control" @bind="_admitReason" placeholder="@AppResources.T("Common_Optional")" />
                        </label>
                    </div>
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="AdmitAsync">@AppResources.T("Common_Admit")</button>
                    </div>
                </div>
            </AdminPageCard>
        }

        @if (_tab == "admissions")
        {
        <AdminPageCard Eyebrow="@AppResources.T("Inpatient_BoardEyebrow")" Title="@AppResources.T("Inpatient_ActiveAdmissionsTitle")">
            <div class="admin-page-card-body">
                @if (_board.ActiveAdmissionsList.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Inpatient_NoPatientsAdmitted")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Patient")</th>
                                    <th>@AppResources.T("Inpatient_LocationColumn")</th>
                                    <th>@AppResources.T("Inpatient_AdmittedColumn")</th>
                                    <th>@AppResources.T("Common_Reason")</th>
                                    @if (_isAdministrator)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var adm in _board.ActiveAdmissionsList)
                                {
                                    <tr>
                                        <td>
                                            <a href="/admin/hospitals/@ClinicId/patients/@adm.PatientId">@adm.PatientName</a>
                                        </td>
                                        <td>@AppResources.Format("Inpatient_LocationFormat", adm.FacilityName, adm.WardName, adm.RoomName, adm.BedLabel)</td>
                                        <td>@ClinicTimeZoneHelper.FormatClinicLocal(adm.AdmittedAt, _clinicTimeZone)</td>
                                        <td>@(string.IsNullOrWhiteSpace(adm.Reason) ? "—" : adm.Reason)</td>
                                        @if (_isAdministrator)
                                        {
                                            <td class="inpatient-actions">
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginTransfer(adm.Id)">@AppResources.T("Common_Transfer")</button>
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginDischarge(adm.Id)">@AppResources.T("Common_Discharge")</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_isAdministrator && _dischargeAdmissionId is Guid dischargeId)
                {
                    <div class="inpatient-action-panel">
                        <h3>@AppResources.T("Inpatient_DischargeTitle")</h3>
                        <label>
                            @AppResources.T("Inpatient_DischargeNotesLabel")
                            <textarea class="form-control" rows="2" @bind="_dischargeNotes" placeholder="@AppResources.T("Inpatient_DischargeNotesPlaceholder")"></textarea>
                        </label>
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-primary" disabled="@(_dischargingId == dischargeId)" @onclick="ConfirmDischargeAsync">
                                @(_dischargingId == dischargeId ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_ConfirmDischarge"))
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="CancelDischarge">@AppResources.T("Common_Cancel")</button>
                        </div>
                    </div>
                }

                @if (_isAdministrator && _transferAdmissionId is Guid transferId)
                {
                    <div class="inpatient-action-panel">
                        <h3>@AppResources.T("Inpatient_TransferBedTitle")</h3>
                        <div class="form-grid">
                            <label>
                                @AppResources.T("Inpatient_TargetBedLabel")
                                <SearchableSelect TValue="string"
                                                  @bind-Value="_transferBedId"
                                                  Placeholder="@AppResources.T("Inpatient_SelectAvailableBed")"
                                                  Options="AvailableBedOptions" />
                            </label>
                            <label>
                                @AppResources.T("Inpatient_DischargeNotesLabel")
                                <input class="form-control" @bind="_transferNotes" placeholder="@AppResources.T("Inpatient_TransferNotesPlaceholder")" />
                            </label>
                        </div>
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-primary" disabled="@(_transferringId == transferId)" @onclick="ConfirmTransferAsync">
                                @(_transferringId == transferId ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_ConfirmTransfer"))
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="CancelTransfer">@AppResources.T("Common_Cancel")</button>
                        </div>
                    </div>
                }
            </div>
        </AdminPageCard>
        }

        @if (_tab == "beds")
        {
        <AdminPageCard Eyebrow="@AppResources.T("Inpatient_MapEyebrow")" Title="@AppResources.T("Inpatient_BedsByWardTitle")">
            <div class="admin-page-card-body">
                @if (_board.Wards.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Inpatient_NoWardsYet")</p>
                }
                else
                {
                    @foreach (var ward in _board.Wards)
                    {
                        <div class="inpatient-ward" style="margin-bottom: 1.25rem;">
                            <div class="inpatient-ward-head">
                                <h3>
                                    @ward.Name
                                    <span class="text-muted">· @ward.FacilityName</span>
                                    @if (!ward.IsActive)
                                    {
                                        <span class="admin-progress-pill">@AppResources.T("Common_Inactive")</span>
                                    }
                                </h3>
                                @if (_isAdministrator)
                                {
                                    <div class="inpatient-actions">
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditWard(ward)">@AppResources.T("Common_Edit")</button>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => ToggleWardActiveAsync(ward)">
                                            @(ward.IsActive ? AppResources.T("Common_Deactivate") : AppResources.T("Common_Reactivate"))
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => DeleteWardAsync(ward.Id)">@AppResources.T("Common_Delete")</button>
                                    </div>
                                }
                            </div>

                            @if (_editWardId == ward.Id)
                            {
                                <div class="inpatient-action-panel">
                                    <div class="form-grid">
                                        <label>
                                            @AppResources.T("Inpatient_WardNameLabel")
                                            <input class="form-control" @bind="_editWardName" />
                                        </label>
                                        <label>
                                            @AppResources.T("Inpatient_CodeLabel")
                                            <input class="form-control" @bind="_editWardCode" />
                                        </label>
                                    </div>
                                    <div class="admin-page-actions">
                                        <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="SaveWardAsync">@AppResources.T("Common_Save")</button>
                                        <button type="button" class="btn btn-ghost" @onclick="CancelEditWard">@AppResources.T("Common_Cancel")</button>
                                    </div>
                                </div>
                            }

                            @if (ward.Rooms.Count == 0)
                            {
                                <p class="text-muted">@AppResources.T("Inpatient_NoRoomsInWard")</p>
                            }
                            else
                            {
                                @foreach (var room in ward.Rooms)
                                {
                                    <div style="margin: 0.75rem 0;">
                                        <div class="inpatient-ward-head">
                                            <strong>
                                                @AppResources.Format("Common_RoomLabel", room.Name)
                                                @(string.IsNullOrWhiteSpace(room.RoomType) ? "" : AppResources.Format("Inpatient_RoomTypeParen", room.RoomType))
                                                @if (!room.IsActive)
                                                {
                                                    <span class="text-muted">· @AppResources.T("Common_InactiveLower")</span>
                                                }
                                            </strong>
                                            @if (_isAdministrator)
                                            {
                                                <div class="inpatient-actions">
                                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditRoom(room)">@AppResources.T("Common_Edit")</button>
                                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => ToggleRoomActiveAsync(room)">
                                                        @(room.IsActive ? AppResources.T("Common_Deactivate") : AppResources.T("Common_Reactivate"))
                                                    </button>
                                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => DeleteRoomAsync(room.Id)">@AppResources.T("Common_Delete")</button>
                                                </div>
                                            }
                                        </div>

                                        @if (_editRoomId == room.Id)
                                        {
                                            <div class="inpatient-action-panel">
                                                <div class="form-grid">
                                                    <label>
                                                        @AppResources.T("Inpatient_RoomNameLabel")
                                                        <input class="form-control" @bind="_editRoomName" />
                                                    </label>
                                                    <label>
                                                        @AppResources.T("Inpatient_RoomTypeLabel")
                                                        <input class="form-control" @bind="_editRoomType" />
                                                    </label>
                                                </div>
                                                <div class="admin-page-actions">
                                                    <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="SaveRoomAsync">@AppResources.T("Common_Save")</button>
                                                    <button type="button" class="btn btn-ghost" @onclick="CancelEditRoom">@AppResources.T("Common_Cancel")</button>
                                                </div>
                                            </div>
                                        }

                                        <div class="bed-chip-row">
                                            @foreach (var bed in room.Beds)
                                            {
                                                var chipClass = !bed.IsActive
                                                    ? "bed-chip-other"
                                                    : bed.Status == "Occupied"
                                                        ? "bed-chip-occupied"
                                                        : bed.Status == "Available"
                                                            ? "bed-chip-free"
                                                            : bed.Status == "Maintenance"
                                                                ? "bed-chip-maintenance"
                                                                : "bed-chip-other";
                                                <div class="bed-chip-wrap">
                                                    <span class="bed-chip @chipClass" title="@BedTitle(bed)">
                                                        @bed.Label
                                                        @if (!string.IsNullOrWhiteSpace(bed.CurrentPatientName))
                                                        {
                                                            <small>@bed.CurrentPatientName</small>
                                                        }
                                                        else
                                                        {
                                                            <small>@bed.Status</small>
                                                        }
                                                    </span>
                                                    @if (_isAdministrator)
                                                    {
                                                        <div class="inpatient-actions bed-chip-actions">
                                                            @if (bed.Status == "Available" && bed.IsActive)
                                                            {
                                                                <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="@(() => SetBedStatusAsync(bed.Id, MaintenanceStatus))">@AppResources.T("Common_Maintenance")</button>
                                                            }
                                                            else if (bed.Status == "Maintenance" && bed.IsActive)
                                                            {
                                                                <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="@(() => SetBedStatusAsync(bed.Id, AvailableStatus))">@AppResources.T("Common_Clear")</button>
                                                            }
                                                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditBed(bed)">@AppResources.T("Common_Edit")</button>
                                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_saving" @onclick="() => DeleteBedAsync(bed.Id)">@AppResources.T("Common_Delete")</button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @if (_editBedId is Guid editingBedId && room.Beds.Any(b => b.Id == editingBedId))
                                        {
                                            <div class="inpatient-action-panel">
                                                <div class="form-grid">
                                                    <label>
                                                        @AppResources.T("Common_BedLabel")
                                                        <input class="form-control" @bind="_editBedLabel" />
                                                    </label>
                                                    <label class="inpatient-checkbox">
                                                        <input type="checkbox" @bind="_editBedActive" />
                                                        @AppResources.T("Inpatient_ActiveCheckbox")
                                                    </label>
                                                </div>
                                                <div class="admin-page-actions">
                                                    <button type="button" class="btn btn-secondary" disabled="@_saving" @onclick="SaveBedAsync">@AppResources.T("Common_Save")</button>
                                                    <button type="button" class="btn btn-ghost" @onclick="CancelEditBed">@AppResources.T("Common_Cancel")</button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </AdminPageCard>
        }

        @if (_tab == "history")
        {
        <AdminPageCard Eyebrow="@AppResources.T("Inpatient_HistoryEyebrow")" Title="@AppResources.T("Inpatient_AdmissionHistoryTitle")">
            <div class="admin-page-card-body">
                <div class="form-grid" style="margin-bottom: 1rem;">
                    <label>
                        @AppResources.T("Inpatient_StatusFilterLabel")
                        <SearchableSelect TValue="string"
                                          @bind-Value="_historyStatus"
                                          Placeholder="@AppResources.T("Common_All")"
                                          Options="HistoryStatusOptions" />
                    </label>
                    <div class="admin-page-actions" style="align-self: end;">
                        <button type="button" class="btn btn-secondary" disabled="@_loadingHistory" @onclick="LoadHistoryAsync">
                            @(_loadingHistory ? AppResources.T("Common_PleaseWait") : AppResources.T("Common_Apply"))
                        </button>
                    </div>
                </div>

                @if (_history.Count == 0 && !_loadingHistory)
                {
                    <p class="text-muted">@AppResources.T("Inpatient_NoAdmissionsMatch")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Patient")</th>
                                    <th>@AppResources.T("Inpatient_LocationColumn")</th>
                                    <th>@AppResources.T("Inpatient_AdmittedColumn")</th>
                                    <th>@AppResources.T("Inpatient_DischargedColumn")</th>
                                    <th>@AppResources.T("Common_Status")</th>
                                    <th>@AppResources.T("Common_Notes")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var adm in _history)
                                {
                                    <tr>
                                        <td>
                                            <a href="/admin/hospitals/@ClinicId/patients/@adm.PatientId">@adm.PatientName</a>
                                        </td>
                                        <td>@AppResources.Format("Inpatient_LocationFormat", adm.FacilityName, adm.WardName, adm.RoomName, adm.BedLabel)</td>
                                        <td>@ClinicTimeZoneHelper.FormatClinicLocal(adm.AdmittedAt, _clinicTimeZone)</td>
                                        <td>@(adm.DischargedAt is null ? "—" : ClinicTimeZoneHelper.FormatClinicLocal(adm.DischargedAt.Value, _clinicTimeZone))</td>
                                        <td>@adm.Status</td>
                                        <td>@(string.IsNullOrWhiteSpace(adm.Notes) ? "—" : adm.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_historyTotal > _history.Count)
                    {
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-secondary" disabled="@_loadingHistory" @onclick="LoadMoreHistoryAsync">
                                @AppResources.Format("Common_LoadMore", _history.Count, _historyTotal)
                            </button>
                        </div>
                    }
                }
            </div>
        </AdminPageCard>
        }
            </div>
        </div>
    }

    <div class="admin-page-actions">
        <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId">@AppResources.T("Common_BackToHospital")</a>
    </div>
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _saving;
    private bool _searchingPatients;
    private bool _loadingHistory;
    private bool _isAdministrator;
    private string _tab = "admissions";
    private Guid? _dischargingId;
    private Guid? _transferringId;
    private Guid? _dischargeAdmissionId;
    private Guid? _transferAdmissionId;
    private Guid? _editWardId;
    private Guid? _editRoomId;
    private Guid? _editBedId;
    private string? _error;
    private string? _success;
    private string _clinicName = AppResources.T("Common_ThisHospital");
    private string _clinicTimeZone = "UTC";
    private ClinicInpatientBoard? _board;
    private IReadOnlyList<FacilityListItem> _physicalFacilities = Array.Empty<FacilityListItem>();
    private IReadOnlyList<ClinicPatientListItem> _patients = Array.Empty<ClinicPatientListItem>();
    private List<ClinicAdmission> _history = [];
    private int _historyTotal;
    private int _historyPage = 1;
    private const int HistoryPageSize = 20;

    private SearchableSelect<string>? _facilitySelect;
    private bool _showFacilityForm;
    private string _clinicCountry = string.Empty;
    private string _facilityName = string.Empty;
    private string _facilityCity = string.Empty;
    private string _facilityAddress = string.Empty;
    private string _facilityCountry = string.Empty;
    private string _wardFacilityId = string.Empty;
    private string _wardName = string.Empty;
    private string _wardCode = string.Empty;
    private string _roomWardId = string.Empty;
    private string _roomName = string.Empty;
    private string _roomType = string.Empty;
    private string _bedRoomId = string.Empty;
    private string _bedLabel = string.Empty;
    private string _patientSearch = string.Empty;
    private string _admitPatientId = string.Empty;
    private string _admitBedId = string.Empty;
    private string _admitReason = string.Empty;
    private string _dischargeNotes = string.Empty;
    private string _transferBedId = string.Empty;
    private string _transferNotes = string.Empty;
    private string _historyStatus = string.Empty;
    private string _editWardName = string.Empty;
    private string _editWardCode = string.Empty;
    private string _editRoomName = string.Empty;
    private string _editRoomType = string.Empty;
    private string _editBedLabel = string.Empty;
    private bool _editBedActive = true;

    private sealed record RoomOption(Guid Id, string WardName, string Name, bool IsActive);
    private sealed record BedOption(Guid Id, string Display);

    private IEnumerable<RoomOption> _allRooms =>
        _board?.Wards.SelectMany(w => w.Rooms.Select(r => new RoomOption(r.Id, w.Name, r.Name, r.IsActive && w.IsActive)))
        ?? Enumerable.Empty<RoomOption>();

    private IEnumerable<BedOption> _availableBeds =>
        _board?.Wards
            .Where(w => w.IsActive)
            .SelectMany(w => w.Rooms.Where(r => r.IsActive).SelectMany(r => r.Beds
                .Where(b => b.IsActive && b.Status == "Available")
                .Select(b => new BedOption(b.Id, AppResources.Format("Inpatient_BedDisplayFormat", w.Name, r.Name, b.Label)))))
        ?? Enumerable.Empty<BedOption>();

    private IReadOnlyList<SelectOption<string>> FacilitySelectOptions =>
        _physicalFacilities.Select(facility => new SelectOption<string>(facility.Id.ToString(), facility.Name)).ToArray();

    private IReadOnlyList<SelectOption<string>> WardSelectOptions =>
        (_board?.Wards.Where(ward => ward.IsActive) ?? Enumerable.Empty<ClinicWard>())
            .Select(ward => new SelectOption<string>(ward.Id.ToString(), $"{ward.Name} ({ward.FacilityName})"))
            .ToArray();

    private IReadOnlyList<SelectOption<string>> RoomSelectOptions =>
        _allRooms.Where(room => room.IsActive)
            .Select(room => new SelectOption<string>(room.Id.ToString(), $"{room.WardName} / {room.Name}"))
            .ToArray();

    private IReadOnlyList<SelectOption<string>> AdmitPatientOptions =>
        _patients.Select(patient => new SelectOption<string>(patient.PatientId.ToString(), $"{patient.FirstName} {patient.LastName}")).ToArray();

    private IReadOnlyList<SelectOption<string>> AvailableBedOptions =>
        _availableBeds.Select(bed => new SelectOption<string>(bed.Id.ToString(), bed.Display)).ToArray();

    private IReadOnlyList<SelectOption<string>> HistoryStatusOptions =>
    [
        new(string.Empty, AppResources.T("Common_All")),
        new("Admitted", AppResources.T("Inpatient_StatusAdmitted")),
        new("Discharged", AppResources.T("Inpatient_StatusDischarged"))
    ];

    protected override void OnInitialized() =>
        CultureService.CultureChanged += OnCultureChanged;

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    protected override async Task OnInitializedAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            _clinicCountry = clinicResponse.Data.Country;
            _facilityCountry = clinicResponse.Data.Country;
            _physicalFacilities = clinicResponse.Data.Facilities.Where(f => !f.IsVirtual).ToList();
            _showFacilityForm = _physicalFacilities.Count == 0;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        if (_isAdministrator)
            await SearchPatientsAsync();

        await LoadBoardAsync();
        await LoadHistoryAsync();
        ApplyInitialTab();
    }

    private bool IsTabAllowed(string tab) =>
        tab is "admissions" or "beds" or "history"
        || (_isAdministrator && tab is "capacity" or "admit");

    private void ApplyInitialTab()
    {
        if (!string.IsNullOrWhiteSpace(TabQuery) && IsTabAllowed(TabQuery))
        {
            _tab = TabQuery;
            return;
        }

        _tab = _isAdministrator && (_board is null || _board.Wards.Count == 0)
            ? "capacity"
            : "admissions";
    }

    private void SetTab(string tab)
    {
        if (!IsTabAllowed(tab))
            return;

        _tab = tab;
        if (tab != "admissions")
        {
            CancelDischarge();
            CancelTransfer();
        }
    }

    private async Task LoadBoardAsync()
    {
        var showFullPage = _board is null;
        if (showFullPage)
            _loading = true;
        _error = null;
        var response = await AdminClinicService.GetInpatientBoardAsync(ClinicId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
            _board = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotLoadInpatientBoard");
    }

    private async Task SearchPatientsAsync()
    {
        _searchingPatients = true;
        var patients = await AdminClinicService.GetPatientsAsync(
            ClinicId, 1, 50, string.IsNullOrWhiteSpace(_patientSearch) ? null : _patientSearch.Trim());
        _searchingPatients = false;

        if (patients.IsSuccess && patients.Data is not null)
            _patients = patients.Data.Items;
        else
            _error = patients.ErrorMessage ?? AppResources.T("Common_CouldNotLoadPatients");
    }

    private async Task LoadHistoryAsync()
    {
        _historyPage = 1;
        _loadingHistory = true;
        var response = await AdminClinicService.GetAdmissionsAsync(
            ClinicId, _historyPage, HistoryPageSize, string.IsNullOrWhiteSpace(_historyStatus) ? null : _historyStatus);
        _loadingHistory = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _history = response.Data.Items.ToList();
            _historyTotal = response.Data.TotalCount;
        }
        else
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotLoadAdmissionHistory");
    }

    private async Task LoadMoreHistoryAsync()
    {
        _historyPage++;
        _loadingHistory = true;
        var response = await AdminClinicService.GetAdmissionsAsync(
            ClinicId, _historyPage, HistoryPageSize, string.IsNullOrWhiteSpace(_historyStatus) ? null : _historyStatus);
        _loadingHistory = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _history.AddRange(response.Data.Items);
            _historyTotal = response.Data.TotalCount;
        }
        else
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotLoadMoreAdmissions");
    }

    private void BeginAddFacility()
    {
        _facilitySelect?.Close();
        if (string.IsNullOrWhiteSpace(_facilityCountry))
            _facilityCountry = _clinicCountry;
        _showFacilityForm = true;
    }

    private void CancelAddFacility()
    {
        _showFacilityForm = false;
        ResetFacilityForm();
    }

    private void ResetFacilityForm()
    {
        _facilityName = string.Empty;
        _facilityCity = string.Empty;
        _facilityAddress = string.Empty;
        _facilityCountry = _clinicCountry;
    }

    private async Task CreateFacilityAsync()
    {
        if (string.IsNullOrWhiteSpace(_facilityName))
        {
            _error = AppResources.T("Inpatient_FacilityNameRequired");
            return;
        }

        var country = string.IsNullOrWhiteSpace(_facilityCountry) ? _clinicCountry : _facilityCountry.Trim();
        if (string.IsNullOrWhiteSpace(country))
        {
            _error = AppResources.T("Inpatient_FacilityCountryRequired");
            return;
        }

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.CreateFacilityAsync(ClinicId, new SaveFacilityRequest
        {
            Name = _facilityName.Trim(),
            City = _facilityCity.Trim(),
            Address = _facilityAddress.Trim(),
            Country = country,
            IsVirtual = false
        });
        _saving = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _error = response.ErrorMessage ?? AppResources.T("HospitalDetail_CouldNotAddFacility");
            return;
        }

        if (!response.Data.IsVirtual)
        {
            _physicalFacilities = _physicalFacilities.Append(response.Data).ToList();
            _wardFacilityId = response.Data.Id.ToString();
        }

        _success = AppResources.T("Inpatient_FacilityCreated");
        _showFacilityForm = false;
        ResetFacilityForm();
    }

    private async Task CreateWardAsync()
    {
        if (!Guid.TryParse(_wardFacilityId, out var facilityId) || string.IsNullOrWhiteSpace(_wardName))
        {
            _error = AppResources.T("Inpatient_SelectFacilityAndWard");
            return;
        }

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.CreateWardAsync(ClinicId, new CreateWardRequest
        {
            FacilityId = facilityId,
            Name = _wardName.Trim(),
            Code = string.IsNullOrWhiteSpace(_wardCode) ? null : _wardCode.Trim()
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotCreateWard");
            return;
        }

        _success = AppResources.T("Inpatient_WardCreated");
        _wardName = string.Empty;
        _wardCode = string.Empty;
        if (response.Data is not null)
            _roomWardId = response.Data.Id.ToString();
        await LoadBoardAsync();
    }

    private async Task CreateRoomAsync()
    {
        if (!Guid.TryParse(_roomWardId, out var wardId) || string.IsNullOrWhiteSpace(_roomName))
        {
            _error = AppResources.T("Inpatient_SelectWardAndRoom");
            return;
        }

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.CreateRoomAsync(ClinicId, new CreateRoomRequest
        {
            WardId = wardId,
            Name = _roomName.Trim(),
            RoomType = string.IsNullOrWhiteSpace(_roomType) ? null : _roomType.Trim()
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotCreateRoom");
            return;
        }

        _success = AppResources.T("Inpatient_RoomCreated");
        _roomName = string.Empty;
        _roomType = string.Empty;
        if (response.Data is not null)
            _bedRoomId = response.Data.Id.ToString();
        await LoadBoardAsync();
    }

    private async Task CreateBedAsync()
    {
        if (!Guid.TryParse(_bedRoomId, out var roomId) || string.IsNullOrWhiteSpace(_bedLabel))
        {
            _error = AppResources.T("Inpatient_SelectRoomAndBed");
            return;
        }

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.CreateBedAsync(ClinicId, new CreateBedRequest
        {
            RoomId = roomId,
            Label = _bedLabel.Trim()
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotCreateBed");
            return;
        }

        _success = AppResources.T("Inpatient_BedCreated");
        _bedLabel = string.Empty;
        await LoadBoardAsync();
    }

    private async Task AdmitAsync()
    {
        if (!Guid.TryParse(_admitPatientId, out var patientId) || !Guid.TryParse(_admitBedId, out var bedId))
        {
            _error = AppResources.T("Inpatient_SelectPatientAndBed");
            return;
        }

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.AdmitPatientAsync(ClinicId, new AdmitPatientRequest
        {
            PatientId = patientId,
            BedId = bedId,
            Reason = string.IsNullOrWhiteSpace(_admitReason) ? null : _admitReason.Trim()
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotAdmitPatient");
            return;
        }

        _success = AppResources.T("Inpatient_PatientAdmitted");
        _admitReason = string.Empty;
        _tab = "admissions";
        await LoadBoardAsync();
        await LoadHistoryAsync();
    }

    private void BeginDischarge(Guid admissionId)
    {
        _dischargeAdmissionId = admissionId;
        _transferAdmissionId = null;
        _dischargeNotes = string.Empty;
    }

    private void CancelDischarge() => _dischargeAdmissionId = null;

    private async Task ConfirmDischargeAsync()
    {
        if (_dischargeAdmissionId is not Guid admissionId)
            return;

        _dischargingId = admissionId;
        ClearMessages();
        var response = await AdminClinicService.DischargeAdmissionAsync(
            ClinicId, admissionId, string.IsNullOrWhiteSpace(_dischargeNotes) ? null : _dischargeNotes.Trim());
        _dischargingId = null;
        _dischargeAdmissionId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotDischargePatient");
            return;
        }

        _success = AppResources.T("Inpatient_PatientDischarged");
        await LoadBoardAsync();
        await LoadHistoryAsync();
    }

    private void BeginTransfer(Guid admissionId)
    {
        _transferAdmissionId = admissionId;
        _dischargeAdmissionId = null;
        _transferBedId = string.Empty;
        _transferNotes = string.Empty;
    }

    private void CancelTransfer() => _transferAdmissionId = null;

    private async Task ConfirmTransferAsync()
    {
        if (_transferAdmissionId is not Guid admissionId || !Guid.TryParse(_transferBedId, out var bedId))
        {
            _error = AppResources.T("Inpatient_SelectTargetBed");
            return;
        }

        _transferringId = admissionId;
        ClearMessages();
        var response = await AdminClinicService.TransferAdmissionAsync(ClinicId, admissionId, new TransferAdmissionRequest
        {
            TargetBedId = bedId,
            Notes = string.IsNullOrWhiteSpace(_transferNotes) ? null : _transferNotes.Trim()
        });
        _transferringId = null;
        _transferAdmissionId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotTransferPatient");
            return;
        }

        _success = AppResources.T("Inpatient_PatientTransferred");
        await LoadBoardAsync();
        await LoadHistoryAsync();
    }

    private void BeginEditWard(ClinicWard ward)
    {
        _editWardId = ward.Id;
        _editWardName = ward.Name;
        _editWardCode = ward.Code ?? string.Empty;
        CancelEditRoom();
        CancelEditBed();
    }

    private void CancelEditWard() => _editWardId = null;

    private async Task SaveWardAsync()
    {
        if (_editWardId is not Guid wardId || string.IsNullOrWhiteSpace(_editWardName))
        {
            _error = AppResources.T("Inpatient_WardNameRequired");
            return;
        }

        var ward = _board?.Wards.FirstOrDefault(w => w.Id == wardId);
        if (ward is null) return;

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.UpdateWardAsync(ClinicId, wardId, new UpdateWardRequest
        {
            Name = _editWardName.Trim(),
            Code = string.IsNullOrWhiteSpace(_editWardCode) ? null : _editWardCode.Trim(),
            IsActive = ward.IsActive
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotUpdateWard");
            return;
        }

        _success = AppResources.T("Inpatient_WardUpdated");
        _editWardId = null;
        await LoadBoardAsync();
    }

    private async Task ToggleWardActiveAsync(ClinicWard ward)
    {
        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.UpdateWardAsync(ClinicId, ward.Id, new UpdateWardRequest
        {
            Name = ward.Name,
            Code = ward.Code,
            IsActive = !ward.IsActive
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotUpdateWard");
            return;
        }

        _success = ward.IsActive ? AppResources.T("Inpatient_WardDeactivated") : AppResources.T("Inpatient_WardReactivated");
        await LoadBoardAsync();
    }

    private async Task DeleteWardAsync(Guid wardId)
    {
        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.DeleteWardAsync(ClinicId, wardId);
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotDeleteWard");
            return;
        }

        _success = AppResources.T("Inpatient_WardRemoved");
        await LoadBoardAsync();
    }

    private void BeginEditRoom(ClinicRoom room)
    {
        _editRoomId = room.Id;
        _editRoomName = room.Name;
        _editRoomType = room.RoomType ?? string.Empty;
        CancelEditWard();
        CancelEditBed();
    }

    private void CancelEditRoom() => _editRoomId = null;

    private async Task SaveRoomAsync()
    {
        if (_editRoomId is not Guid roomId || string.IsNullOrWhiteSpace(_editRoomName))
        {
            _error = AppResources.T("Inpatient_RoomNameRequired");
            return;
        }

        var room = _board?.Wards.SelectMany(w => w.Rooms).FirstOrDefault(r => r.Id == roomId);
        if (room is null) return;

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.UpdateRoomAsync(ClinicId, roomId, new UpdateRoomRequest
        {
            Name = _editRoomName.Trim(),
            RoomType = string.IsNullOrWhiteSpace(_editRoomType) ? null : _editRoomType.Trim(),
            IsActive = room.IsActive
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotUpdateRoom");
            return;
        }

        _success = AppResources.T("Inpatient_RoomUpdated");
        _editRoomId = null;
        await LoadBoardAsync();
    }

    private async Task ToggleRoomActiveAsync(ClinicRoom room)
    {
        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.UpdateRoomAsync(ClinicId, room.Id, new UpdateRoomRequest
        {
            Name = room.Name,
            RoomType = room.RoomType,
            IsActive = !room.IsActive
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotUpdateRoom");
            return;
        }

        _success = room.IsActive ? AppResources.T("Inpatient_RoomDeactivated") : AppResources.T("Inpatient_RoomReactivated");
        await LoadBoardAsync();
    }

    private async Task DeleteRoomAsync(Guid roomId)
    {
        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.DeleteRoomAsync(ClinicId, roomId);
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotDeleteRoom");
            return;
        }

        _success = AppResources.T("Inpatient_RoomRemoved");
        await LoadBoardAsync();
    }

    private void BeginEditBed(ClinicBed bed)
    {
        _editBedId = bed.Id;
        _editBedLabel = bed.Label;
        _editBedActive = bed.IsActive;
        CancelEditWard();
        CancelEditRoom();
    }

    private void CancelEditBed() => _editBedId = null;

    private async Task SaveBedAsync()
    {
        if (_editBedId is not Guid bedId || string.IsNullOrWhiteSpace(_editBedLabel))
        {
            _error = AppResources.T("Inpatient_BedLabelRequired");
            return;
        }

        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.UpdateBedAsync(ClinicId, bedId, new UpdateBedRequest
        {
            Label = _editBedLabel.Trim(),
            IsActive = _editBedActive
        });
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotUpdateBed");
            return;
        }

        _success = AppResources.T("Inpatient_BedUpdated");
        _editBedId = null;
        await LoadBoardAsync();
    }

    private async Task SetBedStatusAsync(Guid bedId, string status)
    {
        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.SetBedStatusAsync(ClinicId, bedId, status);
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotUpdateBedStatus");
            return;
        }

        _success = status == MaintenanceStatus ? AppResources.T("Inpatient_BedMaintenance") : AppResources.T("Inpatient_BedAvailable");
        await LoadBoardAsync();
    }

    private async Task DeleteBedAsync(Guid bedId)
    {
        _saving = true;
        ClearMessages();
        var response = await AdminClinicService.DeleteBedAsync(ClinicId, bedId);
        _saving = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Inpatient_CouldNotDeleteBed");
            return;
        }

        _success = AppResources.T("Inpatient_BedRemoved");
        await LoadBoardAsync();
    }

    private const string AvailableStatus = "Available";
    private const string MaintenanceStatus = "Maintenance";

    private static string BedTitle(ClinicBed bed)
    {
        var label = bed.CurrentPatientName ?? bed.Status;
        return bed.IsActive ? label : $"{label}{AppResources.T("HospitalDetail_InactiveBedSuffix")}";
    }

    private void ClearMessages()
    {
        _error = null;
        _success = null;
    }
}
