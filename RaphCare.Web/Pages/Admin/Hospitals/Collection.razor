@page "/admin/hospitals/{ClinicId:guid}/collection"
@layout AdminLayout
@using RaphCare.Domain.Common
@using RaphCare.Client
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("Collection_PageTitle")</PageTitle>

<section class="admin-page hospital-deck">
    @if (_loading && _board is null)
    {
        <HospitalDeckLoading Message="@AppResources.T("Collection_Loading")" />
    }
    else
    {
        <HospitalDeckMasthead BackHref="@($"/admin/hospitals/{ClinicId}")"
                              BackText="@AppResources.T("Common_BackToHospital")"
                              Monogram="@HospitalDeckInitials.FromName(_clinicName)"
                              Eyebrow="@AppResources.T("Collection_Title")"
                              Title="@_clinicName"
                              Lead="@AppResources.Format("Collection_Lead", _clinicName)"
                              StatusText="@FormatPendingCount()">
            <HospitalDeckChip Label="@AppResources.T("Collection_PrescriptionsTitle")" Value="@PendingPrescriptions.ToString()" />
            <HospitalDeckChip Label="@AppResources.T("Collection_LabsTitle")" Value="@PendingLabs.ToString()" />
        </HospitalDeckMasthead>

        <AdminAlert Message="@_error" />
        <AdminAlert Tone="success" Message="@_success" />

        <div class="hospital-deck-workspace">
        <HospitalDeckRail AriaLabel="@AppResources.T("Collection_Title")"
                          Kicker="@AppResources.T("Collection_Title")">
            <HospitalDeckRailItem Index="01" Icon="grid" IsActive="@(_tab == "find")" OnSelect='() => SetTab("find")'>
                @AppResources.T("Collection_FindTitle")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="02" Icon="collection" IsActive="@(_tab == "prescriptions")" Count="@PendingPrescriptions" OnSelect='() => SetTab("prescriptions")'>
                @AppResources.T("Collection_PrescriptionsTitle")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="03" Icon="lab" IsActive="@(_tab == "labs")" Count="@PendingLabs" OnSelect='() => SetTab("labs")'>
                @AppResources.T("Collection_LabsTitle")
            </HospitalDeckRailItem>
            <HospitalDeckRailItem Index="04" Icon="history" IsActive="@(_tab == "recent")" OnSelect='() => SetTab("recent")'>
                @AppResources.T("Collection_RecentPrescriptionsTitle")
            </HospitalDeckRailItem>
        </HospitalDeckRail>

        <div class="hospital-deck-stage">
        @if (_tab == "find")
        {
            <div class="hospital-overview">
                <HospitalIdentityPlate Kicker="@AppResources.T("Collection_Title")"
                                       Serial="@FormatPendingCount()">
                    <dl class="hospital-identity-facts">
                        <HospitalIdentityFact Label="@AppResources.T("Collection_PrescriptionsTitle")" Value="@PendingPrescriptions.ToString()" />
                        <HospitalIdentityFact Label="@AppResources.T("Collection_LabsTitle")" Value="@PendingLabs.ToString()" />
                    </dl>
                </HospitalIdentityPlate>

                <AdminPageCard Eyebrow="@AppResources.T("Collection_Eyebrow")" Title="@AppResources.T("Collection_FindTitle")">
                    <div class="admin-page-card-body">
                        <div class="form-grid collection-find-grid">
                            <label>
                                @AppResources.T("Collection_SearchLabel")
                                <input class="form-control" @bind="_search" @bind:event="oninput" placeholder="@AppResources.T("Collection_SearchPlaceholder")" />
                            </label>
                        </div>
                        <div class="admin-page-actions collection-find-actions">
                            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="LoadOrdersAsync">
                                @AppResources.T("Collection_Search")
                            </button>
                            <button type="button" class="btn btn-secondary" disabled="@_scanning" @onclick="StartScanAsync">
                                @AppResources.T("Collection_ScanQr")
                            </button>
                            <button type="button" class="btn btn-ghost" @onclick="PrintPosterAsync">
                                @AppResources.T("Collection_PrintPoster")
                            </button>
                            <button type="button" class="btn btn-ghost" disabled="@_busy" @onclick="OpenWaitingScreenAsync">
                                @AppResources.T("Collection_OpenDisplay")
                            </button>
                        </div>
                        <p class="hint">@AppResources.T("Collection_ScanBrowserHint")</p>
                        <p class="hint">@AppResources.T("Collection_DisplayHint")</p>
                    </div>
                </AdminPageCard>
            </div>
        }
        else if (_tab == "prescriptions")
        {
        <AdminPageCard Eyebrow="@AppResources.T("Collection_PharmacyEyebrow")" Title="@AppResources.T("Collection_PrescriptionsTitle")">
            <div class="admin-page-card-body">
                @if (_board is null || _board.Prescriptions.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Collection_NoPrescriptions")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_PickupCode")</th>
                                    <th>@AppResources.T("Common_Patient")</th>
                                    <th>@AppResources.T("Common_Medications")</th>
                                    <th>@AppResources.T("Common_Issued")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rx in _board.Prescriptions)
                                {
                                    <tr>
                                        <td class="pickup-code">
                                            @rx.PickupCode
                                            @if (rx.CalledAt is not null)
                                            {
                                                <span class="badge badge-success">@AppResources.T("Collection_OnScreen")</span>
                                            }
                                        </td>
                                        <td>
                                            <HospitalDirectoryPerson Name="@rx.PatientName"
                                                                     Href="@($"/admin/hospitals/{ClinicId}/patients/{rx.PatientId}")" />
                                            @if (!string.IsNullOrWhiteSpace(rx.NationalHealthId))
                                            {
                                                <span class="hint">@rx.NationalHealthId</span>
                                            }
                                        </td>
                                        <td>
                                            @if (rx.Items.Count == 0)
                                            {
                                                @AppResources.T("Common_EmptyCell")
                                            }
                                            else
                                            {
                                                <ul class="admin-inline-list">
                                                    @foreach (var item in rx.Items)
                                                    {
                                                        <li>@item.MedicationName @(item.Dosage ?? "") @(item.Frequency ?? "")</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                        <td>@FormatLocal(rx.IssuedAt)</td>
                                        <td>
                                            <button type="button" class="btn btn-secondary" disabled="@(_savingId == rx.Id)" @onclick="() => CallPrescriptionAsync(rx.Id)">
                                                @AppResources.T("Collection_Call")
                                            </button>
                                            @if (_canDispense)
                                            {
                                                <button type="button" class="btn btn-primary" disabled="@(_savingId == rx.Id)" @onclick="() => DispenseAsync(rx.Id)">
                                                    @(_savingId == rx.Id ? AppResources.T("Collection_MarkingCollected") : AppResources.T("Collection_MarkCollected"))
                                                </button>
                                            }
                                            <button type="button" class="btn btn-secondary" @onclick="() => PrintPrescription(rx)">
                                                @AppResources.T("Collection_PrintSlip")
                                            </button>
                                            <button type="button" class="btn btn-ghost" disabled="@(_savingId == rx.Id)" @onclick="() => CancelPrescriptionAsync(rx.Id)">
                                                @AppResources.T("Collection_CancelOrder")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </AdminPageCard>
        }
        else if (_tab == "labs")
        {
        <AdminPageCard Eyebrow="@AppResources.T("Collection_LabEyebrow")" Title="@AppResources.T("Collection_LabsTitle")">
            <div class="admin-page-card-body">
                @if (_board is null || _board.LabOrders.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Collection_NoLabs")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_PickupCode")</th>
                                    <th>@AppResources.T("Common_Patient")</th>
                                    <th>@AppResources.T("Common_Test")</th>
                                    <th>@AppResources.T("Common_Requested")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lab in _board.LabOrders)
                                {
                                    <tr>
                                        <td class="pickup-code">
                                            @lab.PickupCode
                                            @if (lab.CalledAt is not null)
                                            {
                                                <span class="badge badge-success">@AppResources.T("Collection_OnScreen")</span>
                                            }
                                        </td>
                                        <td>
                                            <HospitalDirectoryPerson Name="@lab.PatientName"
                                                                     Href="@($"/admin/hospitals/{ClinicId}/patients/{lab.PatientId}")" />
                                            @if (!string.IsNullOrWhiteSpace(lab.NationalHealthId))
                                            {
                                                <span class="hint">@lab.NationalHealthId</span>
                                            }
                                        </td>
                                        <td>@lab.TestName</td>
                                        <td>@FormatLocal(lab.RequestedAt)</td>
                                        <td>
                                            <button type="button" class="btn btn-secondary" disabled="@(_savingId == lab.Id)" @onclick="() => CallLabAsync(lab.Id)">
                                                @AppResources.T("Collection_Call")
                                            </button>
                                            @if (_canCompleteLabs)
                                            {
                                                <button type="button" class="btn btn-secondary" @onclick="() => SelectLab(lab.Id)">
                                                    @AppResources.T("Collection_EnterResult")
                                                </button>
                                            }
                                            <button type="button" class="btn btn-secondary" @onclick="() => PrintLab(lab)">
                                                @AppResources.T("Collection_PrintSlip")
                                            </button>
                                            <button type="button" class="btn btn-ghost" disabled="@(_savingId == lab.Id)" @onclick="() => CancelLabAsync(lab.Id)">
                                                @AppResources.T("Collection_CancelOrder")
                                            </button>
                                        </td>
                                    </tr>
                                    @if (_selectedLabId == lab.Id)
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="form-grid">
                                                    <label>
                                                        @AppResources.T("Common_Value")
                                                        <input class="form-control" @bind="_labResultValue" />
                                                    </label>
                                                    <label>
                                                        @AppResources.T("Visit_UnitLabel")
                                                        <input class="form-control" @bind="_labUnit" />
                                                    </label>
                                                    <label>
                                                        @AppResources.T("Common_ReferenceRange")
                                                        <input class="form-control" @bind="_labReferenceRange" />
                                                    </label>
                                                </div>
                                                <div class="admin-page-actions inpatient-nested-actions">
                                                    <button type="button" class="btn btn-primary" disabled="@(_savingId == lab.Id)" @onclick="() => CompleteLabAsync(lab.Id)">
                                                        @(_savingId == lab.Id ? AppResources.T("Collection_SavingResult") : AppResources.T("Collection_SaveResult"))
                                                    </button>
                                                    <button type="button" class="btn btn-ghost" @onclick="ClearLabForm">@AppResources.T("Common_Cancel")</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </AdminPageCard>
        }
        else if (_tab == "recent")
        {
        <AdminPageCard Eyebrow="@AppResources.T("Collection_PharmacyEyebrow")" Title="@AppResources.T("Collection_RecentPrescriptionsTitle")">
            <div class="admin-page-card-body">
                @if (_board is null || _board.RecentPrescriptions.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Collection_NoRecent")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_PickupCode")</th>
                                    <th>@AppResources.T("Common_Patient")</th>
                                    <th>@AppResources.T("Common_Medications")</th>
                                    <th>@AppResources.T("Common_Status")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rx in _board.RecentPrescriptions)
                                {
                                    <tr>
                                        <td class="pickup-code">@rx.PickupCode</td>
                                        <td>
                                            <HospitalDirectoryPerson Name="@rx.PatientName"
                                                                     Href="@($"/admin/hospitals/{ClinicId}/patients/{rx.PatientId}")" />
                                        </td>
                                        <td>
                                            @if (rx.Items.Count == 0)
                                            {
                                                @AppResources.T("Common_EmptyCell")
                                            }
                                            else
                                            {
                                                <ul class="admin-inline-list">
                                                    @foreach (var item in rx.Items)
                                                    {
                                                        <li>@item.MedicationName @(item.Dosage ?? "") @(item.Frequency ?? "")</li>
                                                    }
                                                </ul>
                                            }
                                        </td>
                                        <td>@FormatOrderStatus(rx.Status)</td>
                                        <td>
                                            <button type="button" class="btn btn-ghost" disabled="@(_savingId == rx.Id)" @onclick="() => UndoPrescriptionAsync(rx.Id)">
                                                @AppResources.T("Collection_Undo")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </AdminPageCard>

        <AdminPageCard Eyebrow="@AppResources.T("Collection_LabEyebrow")" Title="@AppResources.T("Collection_RecentLabsTitle")">
            <div class="admin-page-card-body">
                @if (_board is null || _board.RecentLabOrders.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Collection_NoRecent")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_PickupCode")</th>
                                    <th>@AppResources.T("Common_Patient")</th>
                                    <th>@AppResources.T("Common_Test")</th>
                                    <th>@AppResources.T("Common_Status")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lab in _board.RecentLabOrders)
                                {
                                    <tr>
                                        <td class="pickup-code">@lab.PickupCode</td>
                                        <td>
                                            <HospitalDirectoryPerson Name="@lab.PatientName"
                                                                     Href="@($"/admin/hospitals/{ClinicId}/patients/{lab.PatientId}")" />
                                        </td>
                                        <td>@lab.TestName</td>
                                        <td>@FormatOrderStatus(lab.Status)</td>
                                        <td>
                                            <button type="button" class="btn btn-ghost" disabled="@(_savingId == lab.Id)" @onclick="() => UndoLabAsync(lab.Id)">
                                                @AppResources.T("Collection_Undo")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </AdminPageCard>
        }
        </div>
        </div>

        <div class="hospital-deck-foot">
            <HospitalDeckBackLink Href="@($"/admin/hospitals/{ClinicId}")" Text="@AppResources.T("Common_BackToHospital")" />
        </div>
    }
</section>

@if (_scanning)
{
    <div class="qr-scan-overlay">
        <video id="qr-scan-video" autoplay playsinline muted></video>
        <button type="button" class="btn btn-secondary" @onclick="StopScanAsync">
            @AppResources.T("Collection_StopScan")
        </button>
    </div>
}

@if (_printSlip is not null)
{
    <div class="print-slip">
        <p class="print-slip-eyebrow">@_clinicName</p>
        <h1>@_printSlip.Title</h1>
        @if (!string.IsNullOrWhiteSpace(_printSlip.PatientName))
        {
            <p class="print-slip-patient">@_printSlip.PatientName</p>
        }
        @if (!string.IsNullOrWhiteSpace(_printSlip.NationalHealthId))
        {
            <p>@_printSlip.NationalHealthId</p>
        }
        <p class="print-slip-hint">@_printSlip.Hint</p>
        @if (!string.IsNullOrWhiteSpace(_printSlip.PickupCode))
        {
            <p class="pickup-code print-slip-code">@_printSlip.PickupCode</p>
        }
        <img class="print-slip-qr" src="@_printSlip.QrDataUri" alt="" />
        <p>@_printSlip.Detail</p>
    </div>
}

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool _loading = true;
    private bool _busy;
    private bool _scanning;
    private bool _canDispense;
    private bool _canCompleteLabs;
    private string _tab = "find";
    private Guid? _savingId;
    private Guid? _selectedLabId;
    private string? _error;
    private string? _success;
    private string _clinicName = AppResources.T("Common_ThisHospital");
    private string _clinicTimeZone = "UTC";
    private string _search = string.Empty;
    private string _labResultValue = string.Empty;
    private string _labUnit = string.Empty;
    private string _labReferenceRange = string.Empty;
    private ClinicCollectionBoard? _board;
    private PrintSlip? _printSlip;

    private sealed class PrintSlip
    {
        public string Title { get; init; } = string.Empty;
        public string PatientName { get; init; } = string.Empty;
        public string? NationalHealthId { get; init; }
        public string PickupCode { get; init; } = string.Empty;
        public string Hint { get; init; } = string.Empty;
        public string Detail { get; init; } = string.Empty;
        public string QrDataUri { get; init; } = string.Empty;
    }

    private DotNetObjectReference<Collection>? _jsSelf;

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            _canDispense = clinicResponse.Data.CurrentUserCanDispense;
            _canCompleteLabs = clinicResponse.Data.CurrentUserCanCompleteLabs;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        await LoadOrdersAsync();
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CultureService.CultureChanged -= OnCultureChanged;
        try
        {
            _ = Js.InvokeVoidAsync("raphCareClinic.stopQrScan");
        }
        catch
        {
            // Page is closing.
        }
        _jsSelf?.Dispose();
    }

    private string FormatPendingCount()
    {
        var count = PendingPrescriptions + PendingLabs;
        return count == 1
            ? AppResources.Format("Collection_PendingOne", count)
            : AppResources.Format("Collection_PendingMany", count);
    }

    private int PendingPrescriptions => _board?.Prescriptions.Count ?? 0;

    private int PendingLabs => _board?.LabOrders.Count ?? 0;

    private void SetTab(string tab) => _tab = tab;

    private string FormatLocal(DateTime utc) =>
        ClinicTimeZoneHelper.FormatClinicLocal(utc, _clinicTimeZone);

    private async Task LoadOrdersAsync()
    {
        _busy = true;
        if (_board is null)
            _loading = true;
        _error = null;
        var response = await AdminClinicService.GetCollectionOrdersAsync(ClinicId, _search);
        _busy = false;
        _loading = false;
        if (response.IsSuccess && response.Data is not null)
            _board = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotLoad");
    }

    private async Task DispenseAsync(Guid prescriptionId)
    {
        _savingId = prescriptionId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.DispensePrescriptionAsync(ClinicId, prescriptionId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotCollect");
            return;
        }

        _success = AppResources.T("Collection_PrescriptionCollected");
        await LoadOrdersAsync();
    }

    private async Task CallPrescriptionAsync(Guid prescriptionId)
    {
        _savingId = prescriptionId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CallPrescriptionAsync(ClinicId, prescriptionId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotCall");
            return;
        }

        _success = AppResources.T("Collection_Called");
        await LoadOrdersAsync();
    }

    private async Task CallLabAsync(Guid labRequestId)
    {
        _savingId = labRequestId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CallLabOrderAsync(ClinicId, labRequestId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotCall");
            return;
        }

        _success = AppResources.T("Collection_Called");
        await LoadOrdersAsync();
    }

    private async Task OpenWaitingScreenAsync()
    {
        _busy = true;
        _error = null;
        var response = await AdminClinicService.EnsureCollectionDisplayTokenAsync(ClinicId);
        _busy = false;
        if (!response.IsSuccess || string.IsNullOrWhiteSpace(response.Data))
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotOpenDisplay");
            return;
        }

        var url = Navigation.ToAbsoluteUri($"display/{response.Data}").ToString();
        await Js.InvokeVoidAsync("raphCareClinic.openWindow", url, "raphcareCollectionDisplay");
    }

    private void SelectLab(Guid labRequestId)
    {
        _selectedLabId = labRequestId;
        _labResultValue = string.Empty;
        _labUnit = string.Empty;
        _labReferenceRange = string.Empty;
    }

    private void ClearLabForm()
    {
        _selectedLabId = null;
        _labResultValue = string.Empty;
        _labUnit = string.Empty;
        _labReferenceRange = string.Empty;
    }

    private async Task CompleteLabAsync(Guid labRequestId)
    {
        _savingId = labRequestId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CompleteLabOrderAsync(ClinicId, labRequestId, new CompleteVisitLabOrderRequest
        {
            ResultValue = _labResultValue,
            Unit = _labUnit,
            ReferenceRange = _labReferenceRange
        });
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotSaveResult");
            return;
        }

        _success = AppResources.T("Collection_ResultSaved");
        ClearLabForm();
        await LoadOrdersAsync();
    }

    private static string FormatOrderStatus(string? status) =>
        status switch
        {
            "Dispensed" => AppResources.T("Common_Collected"),
            "Completed" => AppResources.T("Common_CompletedStatus"),
            "Pending" => AppResources.T("Common_Waiting"),
            "Cancelled" => AppResources.T("Common_Cancelled"),
            _ => string.IsNullOrWhiteSpace(status) ? AppResources.T("Common_EmptyCell") : status
        };

    private async Task CancelPrescriptionAsync(Guid prescriptionId)
    {
        _savingId = prescriptionId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CancelPrescriptionAsync(ClinicId, prescriptionId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotCancel");
            return;
        }

        _success = AppResources.T("Collection_OrderCancelled");
        await LoadOrdersAsync();
    }

    private async Task UndoPrescriptionAsync(Guid prescriptionId)
    {
        _savingId = prescriptionId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.UndoPrescriptionAsync(ClinicId, prescriptionId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotUndo");
            return;
        }

        _success = AppResources.T("Collection_OrderRestored");
        await LoadOrdersAsync();
    }

    private async Task CancelLabAsync(Guid labRequestId)
    {
        _savingId = labRequestId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.CancelLabOrderAsync(ClinicId, labRequestId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotCancel");
            return;
        }

        _success = AppResources.T("Collection_OrderCancelled");
        await LoadOrdersAsync();
    }

    private async Task UndoLabAsync(Guid labRequestId)
    {
        _savingId = labRequestId;
        _error = null;
        _success = null;
        var response = await AdminClinicService.UndoLabOrderAsync(ClinicId, labRequestId);
        _savingId = null;
        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Collection_CouldNotUndo");
            return;
        }

        _success = AppResources.T("Collection_OrderRestored");
        await LoadOrdersAsync();
    }

    private async Task PrintPrescription(ClinicCollectionPrescription rx)
    {
        var detail = rx.Items.Count == 0
            ? AppResources.T("Common_PrescriptionsTitle")
            : string.Join(", ", rx.Items.Select(i => i.MedicationName));
        await PrintAsync(rx.PatientName, rx.NationalHealthId, rx.PickupCode, detail);
    }

    private async Task PrintLab(ClinicCollectionLabOrder lab) =>
        await PrintAsync(lab.PatientName, lab.NationalHealthId, lab.PickupCode, lab.TestName);

    private async Task PrintAsync(string patientName, string? nationalHealthId, string pickupCode, string detail)
    {
        _printSlip = new PrintSlip
        {
            Title = AppResources.T("Collection_SlipTitle"),
            PatientName = patientName,
            NationalHealthId = nationalHealthId,
            PickupCode = pickupCode,
            Hint = AppResources.T("Collection_ShowCode"),
            Detail = detail,
            QrDataUri = PickupQr.ToPngDataUri(pickupCode)
        };
        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("raphCareClinic.printPage");
    }

    private async Task PrintPosterAsync()
    {
        _printSlip = new PrintSlip
        {
            Title = AppResources.T("Collection_PosterTitle"),
            Hint = AppResources.T("Collection_PosterHint"),
            Detail = AppResources.T("Collection_PosterDetail"),
            QrDataUri = PickupQr.ToPngDataUri(CollectionQr.ForPoster(ClinicId))
        };
        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("raphCareClinic.printPage");
    }

    private async Task StartScanAsync()
    {
        _error = null;
        _scanning = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);
        _jsSelf ??= DotNetObjectReference.Create(this);
        var started = false;
        try
        {
            started = await Js.InvokeAsync<bool>("raphCareClinic.startQrScan", _jsSelf);
        }
        catch
        {
            started = false;
        }

        if (!started)
        {
            _scanning = false;
            _error = AppResources.T("Collection_ScanUnsupported");
        }
    }

    private async Task StopScanAsync()
    {
        _scanning = false;
        try
        {
            await Js.InvokeVoidAsync("raphCareClinic.stopQrScan");
        }
        catch
        {
            // Overlay is already closing.
        }
    }

    [JSInvokable]
    public async Task OnQrDetected(string value)
    {
        await StopScanAsync();
        if (CollectionQr.TryParsePickupCode(value, out var code))
        {
            _search = code;
            _success = AppResources.T("Collection_ScanFound");
            await LoadOrdersAsync();
            return;
        }

        if (CollectionQr.TryParsePoster(value, out var clinicId))
        {
            _error = clinicId == ClinicId
                ? AppResources.T("Collection_ScanPosterHere")
                : AppResources.T("Collection_ScanPosterOther");
            return;
        }

        _error = AppResources.T("Collection_ScanUnrecognized");
    }
}
