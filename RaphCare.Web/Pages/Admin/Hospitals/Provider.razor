@page "/admin/hospitals/{ClinicId:guid}/providers/{ProviderId:guid}"
@layout AdminLayout
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@(_provider?.DisplayName ?? AppResources.T("ProviderDetail_PageTitleFallback")) @AppResources.T("Common_PageTitleAdminSuffix")</PageTitle>

<section class="admin-page">
    @if (_loading)
    {
        <p class="text-muted">@AppResources.T("Common_LoadingProvider")</p>
    }
    else if (_provider is null)
    {
        <div class="alert alert-error">@(_error ?? AppResources.T("Common_ProviderNotFound"))</div>
        <a class="btn btn-secondary" href="@BackUrl">@AppResources.T("Common_BackToHospital")</a>
    }
    else
    {
        <header class="admin-page-header">
            <div>
                <h1>@_provider.DisplayName</h1>
                <p class="admin-page-lead">@AppResources.Format("Common_WeeklyScheduleLead", ClinicDisplayName)</p>
            </div>
            <span class="badge @(_provider.IsActive ? "badge-success" : "badge-muted")">
                @(_provider.IsActive ? AppResources.T("Common_Active") : AppResources.T("Common_Inactive"))
            </span>
        </header>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error">@_error</div>
        }

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_Profile")</p>
                    <h2>@AppResources.T("Common_ProviderDetailsTitle")</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                <dl class="admin-detail-grid">
                    <div>
                        <dt>@AppResources.T("Common_Email")</dt>
                        <dd>@_provider.Email</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("Common_License")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_provider.LicenseNumber) ? AppResources.T("Common_EmptyCell") : _provider.LicenseNumber)</dd>
                    </div>
                </dl>
                @if (_isAdministrator)
                {
                    <div class="admin-page-actions" style="margin-top: 1rem;">
                        @if (_provider.IsActive)
                        {
                            <button type="button" class="btn btn-ghost" disabled="@_togglingActive" @onclick="() => SetActiveAsync(false)">
                                @(_togglingActive ? AppResources.T("Common_Updating") : AppResources.T("Common_DeactivateProvider"))
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" disabled="@_togglingActive" @onclick="() => SetActiveAsync(true)">
                                @(_togglingActive ? AppResources.T("Common_Updating") : AppResources.T("Common_ReactivateProvider"))
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("ProviderDetail_AvailabilityEyebrow")</p>
                    <h2>@AppResources.T("Common_WeeklyScheduleTitle")</h2>
                </div>
                <span class="admin-progress-pill">@FormatScheduleSlotCount(_provider.Schedules.Count)</span>
            </header>
            <div class="admin-page-card-body">
                @if (_isAdministrator)
                {
                    <div class="admin-inline-form">
                        <h3>@AppResources.T("Common_AddScheduleSlot")</h3>
                        <div class="form-grid">
                            <label>
                                @AppResources.T("Common_Day")
                                <select class="form-control" @bind="_scheduleDay">
                                    @foreach (var day in _days)
                                    {
                                        <option value="@day">@FormatDayOfWeek(day)</option>
                                    }
                                </select>
                            </label>
                            <label>
                                @AppResources.T("Common_Start")
                                <input class="form-control" type="time" @bind="_startTime" />
                            </label>
                            <label>
                                @AppResources.T("Common_End")
                                <input class="form-control" type="time" @bind="_endTime" />
                            </label>
                        </div>
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-primary" disabled="@_savingSchedule" @onclick="AddScheduleAsync">
                                @(_savingSchedule ? AppResources.T("Common_Adding") : AppResources.T("Common_AddSlot"))
                            </button>
                        </div>
                    </div>
                }

                @if (_provider.Schedules.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoScheduleSlots")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Day")</th>
                                    <th>@AppResources.T("Common_Start")</th>
                                    <th>@AppResources.T("Common_End")</th>
                                    @if (_isAdministrator)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in _provider.Schedules)
                                {
                                    <tr>
                                        <td>@FormatDayOfWeek(slot.Day)</td>
                                        <td>@slot.StartTime.ToString(@"hh\:mm")</td>
                                        <td>@slot.EndTime.ToString(@"hh\:mm")</td>
                                        @if (_isAdministrator)
                                        {
                                            <td>
                                                <button type="button"
                                                        class="btn btn-ghost btn-sm"
                                                        disabled="@(_deletingScheduleId == slot.Id)"
                                                        @onclick="() => DeleteScheduleAsync(slot.Id)">
                                                    @(_deletingScheduleId == slot.Id ? AppResources.T("Common_Removing") : AppResources.T("Common_Remove"))
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-actions">
            <a class="btn btn-secondary" href="@BackUrl">@AppResources.T("Common_BackToHospital")</a>
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }
    [Parameter] public Guid ProviderId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private static readonly DayOfWeek[] _days =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    ];

    private bool _loading = true;
    private bool _isAdministrator;
    private bool _savingSchedule;
    private bool _togglingActive;
    private Guid? _deletingScheduleId;
    private string? _error;
    private string? _clinicName;
    private ClinicProviderDetail? _provider;
    private DayOfWeek _scheduleDay = DayOfWeek.Monday;
    private TimeOnly? _startTime = new(9, 0);
    private TimeOnly? _endTime = new(17, 0);

    private string BackUrl => $"/admin/hospitals/{ClinicId}?tab=providers";

    private string ClinicDisplayName => _clinicName ?? AppResources.T("Common_ThisHospital");

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        await LoadProviderAsync();
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private async Task SetActiveAsync(bool isActive)
    {
        _togglingActive = true;
        _error = null;
        var response = await AdminClinicService.SetProviderActiveAsync(ClinicId, ProviderId, isActive);
        _togglingActive = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotUpdateProviderStatus");
            return;
        }

        await LoadProviderAsync();
    }

    private async Task LoadProviderAsync()
    {
        _loading = true;
        _error = null;
        var response = await AdminClinicService.GetProviderDetailAsync(ClinicId, ProviderId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
            _provider = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotLoadProvider");
    }

    private async Task AddScheduleAsync()
    {
        if (_startTime is not { } start || _endTime is not { } end)
        {
            _error = AppResources.T("Common_EnterValidStartEnd");
            return;
        }

        if (end <= start)
        {
            _error = AppResources.T("Common_EndTimeAfterStart");
            return;
        }

        _savingSchedule = true;
        _error = null;
        var response = await AdminClinicService.CreateProviderScheduleAsync(ClinicId, ProviderId, new CreateProviderScheduleRequest
        {
            Day = _scheduleDay,
            StartTime = start.ToTimeSpan(),
            EndTime = end.ToTimeSpan()
        });
        _savingSchedule = false;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotAddScheduleSlot");
            return;
        }

        await LoadProviderAsync();
    }

    private async Task DeleteScheduleAsync(Guid scheduleId)
    {
        _deletingScheduleId = scheduleId;
        _error = null;
        var response = await AdminClinicService.DeleteProviderScheduleAsync(ClinicId, ProviderId, scheduleId);
        _deletingScheduleId = null;

        if (!response.IsSuccess)
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotRemoveScheduleSlot");
            return;
        }

        await LoadProviderAsync();
    }

    private static string FormatDayOfWeek(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => AppResources.T("Common_DayMonday"),
        DayOfWeek.Tuesday => AppResources.T("Common_DayTuesday"),
        DayOfWeek.Wednesday => AppResources.T("Common_DayWednesday"),
        DayOfWeek.Thursday => AppResources.T("Common_DayThursday"),
        DayOfWeek.Friday => AppResources.T("Common_DayFriday"),
        DayOfWeek.Saturday => AppResources.T("Common_DaySaturday"),
        DayOfWeek.Sunday => AppResources.T("Common_DaySunday"),
        _ => day.ToString()
    };

    private static string FormatScheduleSlotCount(int count) =>
        count == 1
            ? AppResources.Format("Common_ScheduleSlotCount", count)
            : AppResources.Format("Common_ScheduleSlotCountPlural", count);
}
