@page "/admin/hospitals/{ClinicId:guid}/appointments/{AppointmentId:guid}/tele"
@layout AdminLayout
@implements IAsyncDisposable
@inject IJSRuntime Js

<PageTitle>Telehealth — RaphCare Admin</PageTitle>

<section class="admin-page">
    <header class="admin-page-header">
        <div>
            <h1>Telehealth session</h1>
            <p class="admin-page-lead">
                @if (_join is not null)
                {
                    <text>@_join.PatientName · @_join.ProviderDisplayName</text>
                }
                else
                {
                    <text>Connecting…</text>
                }
            </p>
        </div>
        @if (_join is not null)
        {
            <span class="badge badge-success">@_join.Status</span>
        }
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
        <div class="alert alert-info">@_info</div>
    }

    @if (_loading)
    {
        <p class="text-muted">Preparing telehealth session…</p>
    }
    else if (_join is not null)
    {
        <div class="admin-page-card">
            <div class="admin-page-card-body">
                <dl class="admin-detail-grid">
                    <div>
                        <dt>Channel</dt>
                        <dd><code>@_join.ChannelName</code></dd>
                    </div>
                    <div>
                        <dt>Session</dt>
                        <dd><code>@_join.TeleSessionId</code></dd>
                    </div>
                    <div>
                        <dt>Visit</dt>
                        <dd><a href="/admin/hospitals/@ClinicId/visits/@_join.VisitId">Open visit chart</a></dd>
                    </div>
                </dl>

                @if (!_join.RtcConfigured || string.IsNullOrWhiteSpace(_join.AppId) || string.IsNullOrWhiteSpace(_join.RtcToken))
                {
                    <div class="alert alert-info" style="margin-top: 1rem;">
                        Agora is not configured on the API. Session was created, but live video cannot start until
                        <code>Agora:AppId</code> and <code>Agora:AppCertificate</code> are set. See docs/10_Agora_Twilio_Setup.md.
                    </div>
                }
                else
                {
                    <div class="tele-stage" style="margin-top: 1.25rem;">
                        <div class="tele-player" id="tele-remote-player" aria-label="Remote video"></div>
                        <div class="tele-player tele-player-local" id="tele-local-player" aria-label="Local video"></div>
                    </div>
                    <div class="admin-page-actions" style="margin-top: 1rem;">
                        @if (!_inCall)
                        {
                            <button type="button" class="btn btn-primary" disabled="@_joining" @onclick="JoinCallAsync">
                                @(_joining ? "Joining…" : "Join video")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-ghost" @onclick="LeaveCallAsync">Leave call</button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="admin-page-actions">
        <a class="btn btn-secondary" href="/admin/hospitals/@ClinicId/appointments">← Appointments</a>
    </div>
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }
    [Parameter] public Guid AppointmentId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _joining;
    private bool _inCall;
    private string? _error;
    private string? _info;
    private ClinicTeleJoinInfo? _join;

    protected override async Task OnInitializedAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        _loading = true;
        _error = null;
        var response = await AdminClinicService.StartTeleSessionAsync(ClinicId, AppointmentId);
        _loading = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _error = response.ErrorMessage ?? "Could not start telehealth session.";
            return;
        }

        _join = response.Data;
        if (!_join.RtcConfigured)
            _info = "Session ready. Configure Agora on the API to enable live video.";
    }

    private async Task JoinCallAsync()
    {
        if (_join is null || string.IsNullOrWhiteSpace(_join.AppId) || string.IsNullOrWhiteSpace(_join.RtcToken))
            return;

        _joining = true;
        _error = null;
        try
        {
            await Js.InvokeVoidAsync(
                "raphCareTelehealth.join",
                _join.AppId,
                _join.ChannelName,
                _join.RtcToken,
                _join.Uid);
            _inCall = true;
        }
        catch (JSException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _joining = false;
        }
    }

    private async Task LeaveCallAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("raphCareTelehealth.leave");
        }
        catch
        {
        }

        _inCall = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_inCall)
            await LeaveCallAsync();
    }
}
