@page "/admin/hospitals/{ClinicId:guid}/patients/{PatientId:guid}"
@layout AdminLayout
@using RaphCare.Domain.Common
@using RaphCare.Client.Models.Clinical
@inject NavigationManager Navigation
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@(_patient is null ? AppResources.T("PatientDetail_PageTitleFallback") : $"{_patient.FirstName} {_patient.LastName}") @AppResources.T("Common_PageTitleAdminSuffix")</PageTitle>

<section class="admin-page">
    @if (_loading)
    {
        <p class="text-muted">@AppResources.T("Common_LoadingPatient")</p>
    }
    else if (_patient is null)
    {
        <div class="alert alert-error">@(_error ?? AppResources.T("Common_PatientNotFound"))</div>
        <a class="btn btn-secondary" href="@BackUrl">@AppResources.T("Common_BackToHospital")</a>
    }
    else
    {
        <header class="admin-page-header">
            <div>
                <h1>@_patient.FirstName @_patient.LastName</h1>
                <p class="admin-page-lead">@AppResources.Format("Common_PatientChartLead", ClinicDisplayName, TimeZoneLabel)</p>
            </div>
            <span class="badge badge-success">@_patient.AccessType</span>
        </header>

        @if (!string.IsNullOrEmpty(_actionError))
        {
            <div class="alert alert-error">@_actionError</div>
        }

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_DemographicsEyebrow")</p>
                    <h2>@AppResources.T("Common_Profile")</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                <dl class="admin-detail-grid">
                    <div>
                        <dt>@AppResources.T("Common_DateOfBirth")</dt>
                        <dd>@_patient.DateOfBirth.ToString("dd MMM yyyy")</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("PatientDetail_Gender")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_patient.Gender) ? AppResources.T("Common_EmptyCell") : _patient.Gender)</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("Common_Email")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_patient.Email) ? AppResources.T("Common_EmptyCell") : _patient.Email)</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("PatientDetail_Phone")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_patient.PhoneNumber) ? AppResources.T("Common_EmptyCell") : _patient.PhoneNumber)</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_HospitalLinkEyebrow")</p>
                    <h2>@AppResources.T("Common_AccessSection")</h2>
                </div>
            </header>
            <div class="admin-page-card-body">
                <dl class="admin-detail-grid">
                    <div>
                        <dt>@AppResources.T("Common_Granted")</dt>
                        <dd>@_patient.GrantedAt.ToString("dd MMM yyyy")</dd>
                    </div>
                    <div>
                        <dt>@AppResources.T("PatientDetail_Rule")</dt>
                        <dd>@_patient.GrantedByRule</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_patient.Notes))
                    {
                        <div class="admin-detail-grid-full">
                            <dt>@AppResources.T("Common_Notes")</dt>
                            <dd>@_patient.Notes</dd>
                        </div>
                    }
                </dl>
                @if (_isAdministrator)
                {
                    <div class="admin-page-actions">
                        <button type="button" class="btn btn-ghost" disabled="@_revoking" @onclick="RevokeAccessAsync">
                            @(_revoking ? AppResources.T("Common_Revoking") : AppResources.T("Common_RevokeHospitalAccess"))
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_WearablesEyebrow")</p>
                    <h2>@AppResources.T("Common_DeviceReadingsTitle")</h2>
                    <p class="admin-page-lead">@AppResources.T("Common_DeviceReadingsLead")</p>
                </div>
            </header>
            <div class="admin-page-card-body">
                @if (_patient.DeviceDailyRollups.Count == 0 && _patient.RecentDeviceReadings.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoDeviceReadings")</p>
                }
                else
                {
                    @if (_patient.DeviceDailyRollups.Count > 0)
                    {
                        <div class="chart-rollup-grid">
                            @foreach (var day in _patient.DeviceDailyRollups)
                            {
                                <div class="chart-rollup-day">
                                    <div class="chart-rollup-date">@day.Date.ToString("dd MMM")</div>
                                    @if (day.AvgHeartRateBpm is { } hr)
                                    {
                                        <div class="chart-rollup-metric" title="@AppResources.T("Common_HeartRateTitle")">
                                            <span class="chart-rollup-label">@AppResources.T("Common_HeartRateLabel")</span>
                                            <span class="chart-rollup-value">@AppResources.Format("Common_HeartRateBpm", hr.ToString("0"))</span>
                                            <span class="chart-rollup-range">@day.MinHeartRateBpm–@day.MaxHeartRateBpm</span>
                                            <div class="chart-rollup-bar" style="width: @(Math.Clamp((int)(hr / 1.6m), 8, 100))%"></div>
                                        </div>
                                    }
                                    @if (day.AvgSpO2Percent is { } spo2)
                                    {
                                        <div class="chart-rollup-metric chart-rollup-metric-spo2" title="@AppResources.T("Common_Spo2Title")">
                                            <span class="chart-rollup-label">@AppResources.T("Common_Spo2Label")</span>
                                            <span class="chart-rollup-value">@AppResources.Format("PatientDetail_Spo2Value", spo2.ToString("0"))</span>
                                            <span class="chart-rollup-range">@day.MinSpO2Percent–@day.MaxSpO2Percent</span>
                                            <div class="chart-rollup-bar" style="width: @Math.Clamp((int)spo2, 8, 100)%"></div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (_patient.RecentDeviceReadings.Count > 0)
                    {
                        <div class="table-wrap" style="margin-top: 1rem;">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>@AppResources.T("Common_Recorded")</th>
                                        <th>@AppResources.T("Common_Type")</th>
                                        <th>@AppResources.T("Common_Value")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var reading in _patient.RecentDeviceReadings)
                                    {
                                        <tr>
                                            <td>@FormatLocal(reading.RecordedAt)</td>
                                            <td>@reading.ReadingType</td>
                                            <td>@FormatDeviceValue(reading)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_EmergencyEyebrow")</p>
                    <h2>@AppResources.T("Common_EmergencyEventsTitle")</h2>
                    <p class="admin-page-lead">@AppResources.T("Common_EmergencyEventsLeadPatient")</p>
                </div>
                <span class="admin-progress-pill">@FormatEventCount(_emergencyTotal)</span>
            </header>
            <div class="admin-page-card-body">
                @if (_loadingEmergencies)
                {
                    <p class="text-muted">@AppResources.T("Common_LoadingEmergencyEvents")</p>
                }
                else if (!string.IsNullOrEmpty(_emergencyError))
                {
                    <div class="alert alert-error">@_emergencyError</div>
                }
                else if (_emergencyEvents.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoEmergencyEventsPatient")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Occurred")</th>
                                    <th>@AppResources.T("Common_Type")</th>
                                    <th>@AppResources.T("PatientDetail_Device")</th>
                                    <th>@AppResources.T("Common_Location")</th>
                                    <th>@AppResources.T("Common_Caregivers")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ev in _emergencyEvents)
                                {
                                    <tr>
                                        <td>@FormatLocal(ev.OccurredAtUtc)</td>
                                        <td><span class="badge badge-error">@ev.EventType</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(ev.Model) ? ev.SerialNumber : $"{ev.Model} · {ev.SerialNumber}")</td>
                                        <td>@FormatLocation(ev)</td>
                                        <td>
                                            @if (ev.CaregiversNotified)
                                            {
                                                <span title="@(ev.CaregiverNotificationSummary ?? "")">@AppResources.T("Common_Notified") @(ev.CaregiversNotifiedAtUtc is null ? "" : FormatLocal(ev.CaregiversNotifiedAtUtc.Value))</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@AppResources.T("Common_EmptyCell")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_emergencyTotal > _emergencyEvents.Count)
                    {
                        <div class="admin-page-actions">
                            <button type="button" class="btn btn-secondary" disabled="@_loadingEmergencies" @onclick="LoadMoreEmergenciesAsync">
                                @AppResources.Format("Common_LoadMore", _emergencyEvents.Count, _emergencyTotal)
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("PatientDetail_ClinicalEyebrow")</p>
                    <h2>@AppResources.T("Common_VisitVitalsTitle")</h2>
                    <p class="admin-page-lead">@AppResources.T("Common_VisitVitalsLead")</p>
                </div>
                <span class="admin-progress-pill">@FormatVitalCount(_patient.RecentVitals.Count)</span>
            </header>
            <div class="admin-page-card-body">
                @if (_patient.RecentVitals.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoVisitVitals")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Recorded")</th>
                                    <th>@AppResources.T("Common_Type")</th>
                                    <th>@AppResources.T("Common_Value")</th>
                                    <th>@AppResources.T("Common_Visit")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var vital in _patient.RecentVitals)
                                {
                                    <tr>
                                        <td>@FormatLocal(vital.RecordedAt)</td>
                                        <td>@vital.Type</td>
                                        <td>@vital.Value @vital.Unit</td>
                                        <td>@(vital.VisitType ?? AppResources.T("Common_EmptyCell"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("Common_SchedulingEyebrow")</p>
                    <h2>@AppResources.T("Common_Appointments")</h2>
                    <p class="admin-page-lead">@AppResources.T("PatientDetail_AppointmentsLead")</p>
                </div>
                <span class="admin-progress-pill">@FormatAppointmentCount(_patient.Appointments.Count)</span>
            </header>
            <div class="admin-page-card-body">
                @if (_patient.Appointments.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoAppointmentsPatient") <a href="/admin/hospitals/@ClinicId/appointments">@AppResources.T("Common_BookOneLink")</a>.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Date")</th>
                                    <th>@AppResources.T("Common_Provider")</th>
                                    <th>@AppResources.T("Common_Type")</th>
                                    <th>@AppResources.T("Common_Status")</th>
                                    <th>@AppResources.T("Common_Reason")</th>
                                    @if (_isAdministrator)
                                    {
                                        <th></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in _patient.Appointments)
                                {
                                    <tr>
                                        <td>@FormatLocal(appt.ScheduledStart)</td>
                                        <td>@appt.ProviderName</td>
                                        <td>@appt.Type</td>
                                        <td>@appt.Status</td>
                                        <td>@(string.IsNullOrWhiteSpace(appt.Reason) ? AppResources.T("Common_EmptyCell") : appt.Reason)</td>
                                        @if (_isAdministrator && appt.Status != "Cancelled")
                                        {
                                            <td class="admin-table-actions">
                                                <a class="btn btn-ghost btn-sm" href="/admin/hospitals/@ClinicId/appointments">@AppResources.T("Common_Manage")</a>
                                            </td>
                                        }
                                        else if (_isAdministrator)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-card">
            <header class="admin-page-card-head">
                <div>
                    <p class="admin-page-eyebrow">@AppResources.T("PatientDetail_ClinicalEyebrow")</p>
                    <h2>@AppResources.T("Common_RecentVisitsTitle")</h2>
                    <p class="admin-page-lead">@AppResources.T("Common_RecentVisitsLead")</p>
                </div>
                <span class="admin-progress-pill">@FormatVisitCount(_patient.RecentVisits.Count)</span>
            </header>
            <div class="admin-page-card-body">
                @if (_patient.RecentVisits.Count == 0)
                {
                    <p class="text-muted">@AppResources.T("Common_NoVisitsPatient")</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>@AppResources.T("Common_Date")</th>
                                    <th>@AppResources.T("Common_Type")</th>
                                    <th>@AppResources.T("Common_Status")</th>
                                    <th>@AppResources.T("Common_Summary")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var visit in _patient.RecentVisits)
                                {
                                    <tr>
                                        <td>
                                            <a href="/admin/hospitals/@ClinicId/visits/@visit.Id">@FormatLocal(visit.VisitStart)</a>
                                        </td>
                                        <td>@visit.VisitType</td>
                                        <td>@visit.Status</td>
                                        <td>@(string.IsNullOrWhiteSpace(visit.Summary) ? AppResources.T("Common_EmptyCell") : visit.Summary)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="admin-page-actions">
            <a class="btn btn-secondary" href="@BackUrl">@AppResources.T("Common_BackToHospital")</a>
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }
    [Parameter] public Guid PatientId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicalPatientDeviceReadingsService DeviceReadingsService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _loadingEmergencies;
    private bool _revoking;
    private bool _isAdministrator;
    private string? _error;
    private string? _actionError;
    private string? _emergencyError;
    private string? _clinicName;
    private string _clinicTimeZone = "UTC";
    private ClinicPatientDetail? _patient;
    private List<PatientDeviceEmergencyEventViewModel> _emergencyEvents = [];
    private int _emergencyTotal;
    private int _emergencyPage = 1;
    private const int EmergencyPageSize = 20;

    private string BackUrl => $"/admin/hospitals/{ClinicId}?tab=patients";

    private string ClinicDisplayName => _clinicName ?? AppResources.T("Common_ThisHospital");

    private string TimeZoneLabel =>
        string.IsNullOrWhiteSpace(_clinicTimeZone) ? AppResources.T("Common_HospitalTime") : _clinicTimeZone;

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        _clinicName = ClinicContext.CurrentClinicName;

        var clinicResponse = await AdminClinicService.GetClinicAsync(ClinicId);
        if (clinicResponse.IsSuccess && clinicResponse.Data is not null)
        {
            _clinicName = clinicResponse.Data.Name;
            _isAdministrator = clinicResponse.Data.CurrentUserIsAdministrator;
            _clinicTimeZone = clinicResponse.Data.TimeZone;
            await ClinicContext.SetCurrentClinicAsync(ClinicId, clinicResponse.Data.Name).ConfigureAwait(false);
        }

        await LoadPatientAsync();
        if (_patient is not null)
            await LoadEmergenciesAsync(reset: true);
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private async Task LoadPatientAsync()
    {
        _loading = true;
        _error = null;
        var response = await AdminClinicService.GetPatientDetailAsync(ClinicId, PatientId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
            _patient = response.Data;
        else
            _error = response.ErrorMessage ?? AppResources.T("PatientDetail_CouldNotLoadPatient");
    }

    private async Task LoadEmergenciesAsync(bool reset)
    {
        if (reset)
        {
            _emergencyPage = 1;
            _emergencyEvents = [];
            _emergencyTotal = 0;
        }

        _loadingEmergencies = true;
        _emergencyError = null;
        var response = await DeviceReadingsService.GetEmergencyEventsAsync(
            PatientId, _emergencyPage, EmergencyPageSize);
        _loadingEmergencies = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _emergencyError = response.ErrorMessage ?? AppResources.T("Common_CouldNotLoadEmergencyEvents");
            return;
        }

        if (reset)
            _emergencyEvents = response.Data.Items.ToList();
        else
            _emergencyEvents.AddRange(response.Data.Items);

        _emergencyTotal = response.Data.TotalCount;
    }

    private async Task LoadMoreEmergenciesAsync()
    {
        _emergencyPage++;
        await LoadEmergenciesAsync(reset: false);
    }

    private string FormatLocal(DateTime utc) =>
        ClinicTimeZoneHelper.FormatClinicLocal(utc, _clinicTimeZone);

    private string FormatLocation(PatientDeviceEmergencyEventViewModel ev)
    {
        if (ev.Latitude is null || ev.Longitude is null)
            return AppResources.T("Common_EmptyCell");
        var coords = $"{ev.Latitude:0.#####}, {ev.Longitude:0.#####}";
        if (ev.HorizontalAccuracyMeters is { } acc)
            return AppResources.Format("PatientDetail_LocationWithAccuracy", coords, acc.ToString("0"));
        return coords;
    }

    private string FormatDeviceValue(ClinicPatientDeviceReadingSummary reading)
    {
        if (reading.HeartRateBpm is int hr)
            return AppResources.Format("Common_HeartRateBpm", hr);
        if (reading.SpO2Percent is decimal spo2)
            return AppResources.Format("PatientDetail_Spo2Value", spo2.ToString("0"));
        return $"{reading.PrimaryValue} {reading.Unit}".Trim();
    }

    private static string FormatEventCount(int count) =>
        count == 1
            ? AppResources.Format("Common_EventCountLabel", count)
            : AppResources.Format("Common_EventCountLabelPlural", count);

    private static string FormatVitalCount(int count) =>
        count == 1
            ? AppResources.Format("Common_VitalCountLabel", count)
            : AppResources.Format("Common_VitalCountLabelPlural", count);

    private static string FormatAppointmentCount(int count) =>
        count == 1
            ? AppResources.Format("Common_AppointmentCountLabel", count)
            : AppResources.Format("Common_AppointmentCountLabelPlural", count);

    private static string FormatVisitCount(int count) =>
        count == 1
            ? AppResources.Format("Common_VisitCountLabel", count)
            : AppResources.Format("Common_VisitCountLabelPlural", count);

    private async Task RevokeAccessAsync()
    {
        _revoking = true;
        _actionError = null;
        var response = await AdminClinicService.RevokePatientAccessAsync(ClinicId, PatientId);
        _revoking = false;

        if (!response.IsSuccess)
        {
            _actionError = response.ErrorMessage ?? AppResources.T("Common_CouldNotRevokeAccess");
            return;
        }

        Navigation.NavigateTo(BackUrl);
    }
}
