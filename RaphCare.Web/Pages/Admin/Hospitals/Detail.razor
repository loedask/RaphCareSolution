@page "/admin/hospitals/{ClinicId:guid}"
@layout AdminLayout

<PageTitle>@(_detail?.Name ?? "Hospital") — RaphCare Admin</PageTitle>

<section class="admin-page">
    @if (_loading)
    {
        <p class="text-muted">Loading hospital…</p>
    }
    else if (_detail is null)
    {
        <div class="alert alert-error">@(_error ?? "Hospital not found.")</div>
        <a class="btn btn-secondary" href="/admin/hospitals">Back to hospitals</a>
    }
    else
    {
        <header class="admin-page-header">
            <div>
                <h1>@_detail.Name</h1>
                <p class="admin-page-lead">Hospital profile, facilities, and staff.</p>
            </div>
            <span class="badge @(_detail.IsActive ? "badge-success" : "badge-muted")">
                @(_detail.IsActive ? "Active" : "Inactive")
            </span>
        </header>

        <nav class="admin-detail-tabs" aria-label="Hospital sections">
            <button type="button" class="admin-detail-tab @(_tab == "overview" ? "active" : "")" @onclick='() => SetTab("overview")'>
                <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Overview
            </button>
            <button type="button" class="admin-detail-tab @(_tab == "facilities" ? "active" : "")" @onclick='() => SetTab("facilities")'>
                <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
                Facilities
            </button>
            <button type="button" class="admin-detail-tab @(_tab == "patients" ? "active" : "")" @onclick='() => SetTab("patients")'>
                <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                Patients
            </button>
            <button type="button" class="admin-detail-tab @(_tab == "staff" ? "active" : "")" @onclick='() => SetTab("staff")'>
                <svg class="admin-detail-tab-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3.1-6 7-6"/><circle cx="17" cy="9" r="2.5"/><path d="M14 20c0-2.5 2.2-4.5 5-4.5"/></svg>
                Staff
            </button>
        </nav>

        @if (!string.IsNullOrEmpty(_actionError))
        {
            <div class="alert alert-error">@_actionError</div>
        }

        @if (_tab == "overview")
        {
            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Hospital profile</p>
                        <h1>Organization details</h1>
                        <p class="admin-page-lead">Update your hospital name, country, and time zone.</p>
                    </div>
                </header>
                <div class="admin-page-card-body">
                    <div class="admin-inline-form">
                        <div class="form-grid">
                            <label>
                                Hospital name
                                <input class="form-control" @bind="_clinicForm.Name" />
                            </label>
                            <label>
                                Country
                                <input class="form-control" @bind="_clinicForm.Country" />
                            </label>
                            <label>
                                Time zone
                                <input class="form-control" @bind="_clinicForm.TimeZone" placeholder="Africa/Johannesburg" />
                            </label>
                            @if (_isAdministrator)
                            {
                                <label class="form-check">
                                    <input type="checkbox" @bind="_clinicForm.IsActive" />
                                    Hospital is active
                                </label>
                            }
                        </div>
                        <div class="admin-form-actions">
                            <button type="button" class="btn btn-primary" disabled="@_savingClinic" @onclick="SaveClinicAsync">
                                @(_savingClinic ? "Saving…" : "Save changes")
                            </button>
                        </div>
                    </div>

                    <div class="review-grid" style="margin-top: 1.5rem;">
                        <div class="review-item">
                            <span class="review-label">Registration #</span>
                            <span class="review-value">@_detail.RegistrationNumber</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">Registered</span>
                            <span class="review-value">@_detail.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="review-item">
                            <span class="review-label">Hospital ID</span>
                            <span class="review-value"><code>@_detail.Id</code></span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (_tab == "facilities")
        {
            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Locations</p>
                        <h1>Facilities</h1>
                        <p class="admin-page-lead">Physical campuses and virtual sites for this hospital.</p>
                    </div>
                    <span class="admin-progress-pill">@_detail.Facilities.Count facility@(_detail.Facilities.Count == 1 ? "" : "ies")</span>
                </header>
                <div class="admin-page-card-body">
                    <div class="admin-inline-form">
                        <h3>@(_editingFacilityId is null ? "Add facility" : "Edit facility")</h3>
                        <div class="form-grid">
                            <label>
                                Name
                                <input class="form-control" @bind="_facilityForm.Name" placeholder="Main Campus" />
                            </label>
                            <label>
                                City
                                <input class="form-control" @bind="_facilityForm.City" placeholder="Johannesburg" />
                            </label>
                            <label>
                                Address
                                <input class="form-control" @bind="_facilityForm.Address" placeholder="Street address" />
                            </label>
                            <label>
                                Country
                                <input class="form-control" @bind="_facilityForm.Country" placeholder="@_detail.Country" />
                            </label>
                            <label class="form-check">
                                <input type="checkbox" @bind="_facilityForm.IsVirtual" />
                                Virtual site (no physical address)
                            </label>
                        </div>
                        <div class="admin-form-actions">
                            @if (_editingFacilityId is null)
                            {
                                <button type="button" class="btn btn-primary" disabled="@_savingFacility" @onclick="CreateFacilityAsync">
                                    @(_savingFacility ? "Adding…" : "Add facility")
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary" disabled="@_savingFacility" @onclick="UpdateFacilityAsync">
                                    @(_savingFacility ? "Saving…" : "Save changes")
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="CancelEditFacility">Cancel</button>
                            }
                        </div>
                    </div>

                    @if (_detail.Facilities.Count == 0)
                    {
                        <p class="text-muted">No facilities yet. Add your first location above.</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>City</th>
                                        <th>Address</th>
                                        <th>Country</th>
                                        <th>Type</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var facility in _detail.Facilities)
                                    {
                                        <tr>
                                            <td><strong>@facility.Name</strong></td>
                                            <td>@(string.IsNullOrWhiteSpace(facility.City) ? "—" : facility.City)</td>
                                            <td>@(string.IsNullOrWhiteSpace(facility.Address) ? "—" : facility.Address)</td>
                                            <td>@facility.Country</td>
                                            <td>@(facility.IsVirtual ? "Virtual" : "Physical")</td>
                                            <td class="admin-row-actions">
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => StartEditFacility(facility)">Edit</button>
                                                @if (_isAdministrator)
                                                {
                                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@_deletingFacilityId == facility.Id" @onclick="() => DeleteFacilityAsync(facility.Id)">
                                                        @(_deletingFacilityId == facility.Id ? "Deleting…" : "Delete")
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_tab == "patients")
        {
            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Care recipients</p>
                        <h1>Patients</h1>
                        <p class="admin-page-lead">Patients who have access to this hospital.</p>
                    </div>
                    <span class="admin-progress-pill">@_patientTotalCount patient@(_patientTotalCount == 1 ? "" : "s")</span>
                </header>
                <div class="admin-page-card-body">
                    <div class="admin-table-toolbar">
                        <div class="claim-form-row">
                            <input class="form-control"
                                   @bind="_patientSearch"
                                   @bind:event="oninput"
                                   placeholder="Search by name, email, or phone"
                                   @onkeydown="OnPatientSearchKeyDown" />
                            <button type="button" class="btn btn-secondary" @onclick="SearchPatientsAsync">Search</button>
                        </div>
                    </div>

                    @if (_loadingPatients)
                    {
                        <p class="text-muted">Loading patients…</p>
                    }
                    else if (_patientTotalCount == 0 && string.IsNullOrWhiteSpace(_patientSearchApplied))
                    {
                        <p class="text-muted">No patients linked to this hospital yet.</p>
                    }
                    else if (_patients.Count == 0)
                    {
                        <p class="text-muted">No patients match your search.</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Date of birth</th>
                                        <th>Access</th>
                                        <th>Granted</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var patient in _patients)
                                    {
                                        <tr>
                                            <td><strong>@patient.FirstName @patient.LastName</strong></td>
                                            <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                                            <td>@patient.AccessType</td>
                                            <td>@patient.GrantedAt.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="admin-pagination">
                            <span class="admin-pagination-meta">
                                Page @_patientPageNumber of @_patientPageCount · @_patientTotalCount patient@(_patientTotalCount == 1 ? "" : "s")
                            </span>
                            <div class="admin-pagination-actions">
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_patientPageNumber <= 1 || _loadingPatients)" @onclick="PreviousPatientsPageAsync">Previous</button>
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_patientPageNumber >= _patientPageCount || _loadingPatients)" @onclick="NextPatientsPageAsync">Next</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_tab == "staff")
        {
            <div class="admin-page-card">
                <header class="admin-page-card-head">
                    <div>
                        <p class="admin-page-eyebrow">Team</p>
                        <h1>Staff</h1>
                        <p class="admin-page-lead">Professionals linked to this hospital. Administrators can invite colleagues by email.</p>
                    </div>
                    <span class="admin-progress-pill">@_staff.Count member@(_staff.Count == 1 ? "" : "s")</span>
                </header>
                <div class="admin-page-card-body">
                    @if (_isAdministrator)
                    {
                        <div class="admin-inline-form">
                            <h3>Invite staff</h3>
                            <div class="claim-form-row">
                                <input class="form-control" @bind="_inviteEmail" placeholder="colleague@hospital.com" />
                                <button type="button" class="btn btn-primary" disabled="@_inviting" @onclick="InviteStaffAsync">
                                    @(_inviting ? "Inviting…" : "Invite")
                                </button>
                            </div>
                            <p class="hint">Invite colleagues by email. If they do not have a RaphCare account yet, they will receive a registration link.</p>
                        </div>
                    }
                    else
                    {
                        <p class="hint">Only hospital administrators can invite or manage staff.</p>
                    }

                    @if (_loadingStaff)
                    {
                        <p class="text-muted">Loading staff…</p>
                    }
                    else if (_staff.Count == 0)
                    {
                        <p class="text-muted">No staff linked yet.</p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Roles</th>
                                        <th>Status</th>
                                        <th>Joined</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var member in _staff)
                                    {
                                        <tr>
                                            <td><strong>@member.DisplayName</strong></td>
                                            <td>@member.Email</td>
                                            <td>@string.Join(", ", member.Roles)</td>
                                            <td>
                                                @if (member.IsPendingInvitation)
                                                {
                                                    <span class="badge badge-muted">Pending registration</span>
                                                }
                                                else if (member.HasLoggedIn)
                                                {
                                                    <span class="badge badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-muted">Pending sign-in</span>
                                                }
                                            </td>
                                            <td>@member.JoinedAt.ToString("dd MMM yyyy")</td>
                                            <td class="admin-row-actions">
                                                @if (_isAdministrator)
                                                {
                                                    @if (member.IsPendingInvitation && member.InvitationId is { } invitationId)
                                                    {
                                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_resendingInvitationId == invitationId" @onclick="() => ResendPendingInvitationAsync(invitationId)">
                                                            @(_resendingInvitationId == invitationId ? "Sending…" : "Resend invite")
                                                        </button>
                                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_cancellingInvitationId == invitationId" @onclick="() => CancelPendingInvitationAsync(invitationId)">
                                                            @(_cancellingInvitationId == invitationId ? "Cancelling…" : "Cancel")
                                                        </button>
                                                    }
                                                    else if (!member.HasLoggedIn && member.UserId is { } userId)
                                                    {
                                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_resendingUserId == userId" @onclick="() => ResendInvitationAsync(userId)">
                                                            @(_resendingUserId == userId ? "Sending…" : "Resend invite")
                                                        </button>
                                                        @if (CanRemoveStaff(member))
                                                        {
                                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_removingUserId == userId" @onclick="() => RemoveStaffAsync(userId)">
                                                                @(_removingUserId == userId ? "Removing…" : "Remove")
                                                            </button>
                                                        }
                                                    }
                                                    else if (member.UserId is { } activeUserId)
                                                    {
                                                        if (IsStaffAdministrator(member))
                                                        {
                                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_updatingRoleUserId == activeUserId" @onclick="() => UpdateStaffRoleAsync(activeUserId, false)">
                                                                @(_updatingRoleUserId == activeUserId ? "Saving…" : "Remove admin")
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_updatingRoleUserId == activeUserId" @onclick="() => UpdateStaffRoleAsync(activeUserId, true)">
                                                                @(_updatingRoleUserId == activeUserId ? "Saving…" : "Make admin")
                                                            </button>
                                                        }

                                                        @if (CanRemoveStaff(member))
                                                        {
                                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_removingUserId == activeUserId" @onclick="() => RemoveStaffAsync(activeUserId)">
                                                                @(_removingUserId == activeUserId ? "Removing…" : "Remove")
                                                            </button>
                                                        }
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="admin-page-actions">
            <a class="btn btn-secondary" href="/admin/hospitals">← Back to hospitals</a>
        </div>
    }
</section>

@code {
    [Parameter] public Guid ClinicId { get; set; }

    [Inject] private IAdminClinicService AdminClinicService { get; set; } = default!;
    [Inject] private IClinicContextService ClinicContext { get; set; } = default!;

    private bool _loading = true;
    private bool _loadingStaff;
    private bool _loadingPatients;
    private bool _savingFacility;
    private bool _savingClinic;
    private bool _inviting;
    private Guid? _deletingFacilityId;
    private Guid? _removingUserId;
    private Guid? _resendingUserId;
    private Guid? _resendingInvitationId;
    private Guid? _cancellingInvitationId;
    private Guid? _updatingRoleUserId;
    private string? _error;
    private string? _actionError;
    private string _tab = "overview";
    private string _inviteEmail = string.Empty;
    private string _patientSearch = string.Empty;
    private string _patientSearchApplied = string.Empty;
    private int _patientPageNumber = 1;
    private const int PatientPageSize = 20;
    private int _patientPageCount = 1;
    private bool _isAdministrator;
    private Guid? _editingFacilityId;
    private ClinicDetail? _detail;
    private IReadOnlyList<ClinicStaffMember> _staff = Array.Empty<ClinicStaffMember>();
    private IReadOnlyList<ClinicPatientListItem> _patients = Array.Empty<ClinicPatientListItem>();
    private int _patientTotalCount;
    private bool _staffLoaded;
    private bool _patientsLoaded;
    private SaveFacilityRequest _facilityForm = new();
    private UpdateClinicRequest _clinicForm = new();

    protected override async Task OnInitializedAsync()
    {
        await ClinicContext.SetCurrentClinicAsync(ClinicId).ConfigureAwait(false);
        await LoadDetailAsync();
    }

    private async Task LoadDetailAsync()
    {
        _loading = true;
        _error = null;
        var response = await AdminClinicService.GetClinicAsync(ClinicId);
        _loading = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _detail = response.Data;
            _isAdministrator = _detail.CurrentUserIsAdministrator;
            ResetFacilityForm(_detail.Country);
            ResetClinicForm(_detail);
            await ClinicContext.SetCurrentClinicAsync(ClinicId, _detail.Name).ConfigureAwait(false);
            return;
        }

        _error = response.ErrorMessage ?? "Could not load hospital.";
    }

    private async Task LoadStaffAsync()
    {
        _loadingStaff = true;
        _actionError = null;
        var response = await AdminClinicService.GetStaffAsync(ClinicId);
        _loadingStaff = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _staff = response.Data;
            _staffLoaded = true;
        }
        else
            _actionError = response.ErrorMessage ?? "Could not load staff.";
    }

    private async Task LoadPatientsAsync()
    {
        _loadingPatients = true;
        _actionError = null;
        var response = await AdminClinicService.GetPatientsAsync(
            ClinicId,
            _patientPageNumber,
            PatientPageSize,
            string.IsNullOrWhiteSpace(_patientSearchApplied) ? null : _patientSearchApplied);
        _loadingPatients = false;

        if (response.IsSuccess && response.Data is not null)
        {
            _patients = response.Data.Items;
            _patientTotalCount = response.Data.TotalCount;
            _patientPageCount = Math.Max(1, (int)Math.Ceiling(_patientTotalCount / (double)PatientPageSize));
            if (_patientPageNumber > _patientPageCount)
            {
                _patientPageNumber = _patientPageCount;
                await LoadPatientsAsync();
                return;
            }

            _patientsLoaded = true;
        }
        else
            _actionError = response.ErrorMessage ?? "Could not load patients.";
    }

    private async Task SearchPatientsAsync()
    {
        _patientSearchApplied = _patientSearch.Trim();
        _patientPageNumber = 1;
        _patientsLoaded = false;
        await LoadPatientsAsync();
    }

    private async Task OnPatientSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchPatientsAsync();
    }

    private async Task PreviousPatientsPageAsync()
    {
        if (_patientPageNumber <= 1)
            return;

        _patientPageNumber--;
        await LoadPatientsAsync();
    }

    private async Task NextPatientsPageAsync()
    {
        if (_patientPageNumber >= _patientPageCount)
            return;

        _patientPageNumber++;
        await LoadPatientsAsync();
    }

    private static bool IsStaffAdministrator(ClinicStaffMember member) =>
        RaphCareRoles.HasAdministratorRole(member.Roles);

    private async Task UpdateStaffRoleAsync(Guid userId, bool isAdministrator)
    {
        _updatingRoleUserId = userId;
        _actionError = null;
        var response = await AdminClinicService.UpdateStaffRoleAsync(ClinicId, userId, isAdministrator);
        _updatingRoleUserId = null;

        if (!response.IsSuccess)
        {
            _actionError = response.ErrorMessage ?? "Could not update staff role.";
            return;
        }

        await LoadStaffAsync();
    }

    private async Task SetTab(string tab)
    {
        _tab = tab;
        _actionError = null;
        if (tab == "staff" && !_staffLoaded)
            await LoadStaffAsync();
        else if (tab == "patients" && !_patientsLoaded)
            await LoadPatientsAsync();
    }

    private void ResetClinicForm(ClinicDetail detail)
    {
        _clinicForm = new UpdateClinicRequest
        {
            Name = detail.Name,
            Country = detail.Country,
            TimeZone = detail.TimeZone,
            IsActive = detail.IsActive
        };
    }

    private bool CanRemoveStaff(ClinicStaffMember member) =>
        member.UserId is not null
        && _detail?.RegisteredByApplicationUserId != member.UserId;

    private async Task DeleteFacilityAsync(Guid facilityId)
    {
        _deletingFacilityId = facilityId;
        _actionError = null;
        var response = await AdminClinicService.DeleteFacilityAsync(ClinicId, facilityId);
        _deletingFacilityId = null;

        if (!response.IsSuccess)
        {
            _actionError = response.ErrorMessage ?? "Could not delete facility.";
            return;
        }

        if (_editingFacilityId == facilityId)
            ResetFacilityForm(_detail?.Country ?? string.Empty);

        await LoadDetailAsync();
    }

    private async Task SaveClinicAsync()
    {
        _savingClinic = true;
        _actionError = null;
        var response = await AdminClinicService.UpdateClinicAsync(ClinicId, _clinicForm);
        _savingClinic = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _actionError = response.ErrorMessage ?? "Could not update hospital.";
            return;
        }

        _detail = response.Data;
        _isAdministrator = _detail.CurrentUserIsAdministrator;
        ResetClinicForm(_detail);
        await ClinicContext.SetCurrentClinicAsync(ClinicId, _detail.Name).ConfigureAwait(false);
    }

    private void ResetFacilityForm(string defaultCountry)
    {
        _facilityForm = new SaveFacilityRequest { Country = defaultCountry };
        _editingFacilityId = null;
    }

    private void StartEditFacility(FacilityListItem facility)
    {
        _editingFacilityId = facility.Id;
        _facilityForm = new SaveFacilityRequest
        {
            Name = facility.Name,
            Address = facility.Address,
            City = facility.City,
            Country = facility.Country,
            IsVirtual = facility.IsVirtual
        };
        _actionError = null;
    }

    private void CancelEditFacility()
    {
        ResetFacilityForm(_detail?.Country ?? string.Empty);
        _actionError = null;
    }

    private async Task CreateFacilityAsync()
    {
        _savingFacility = true;
        _actionError = null;
        var response = await AdminClinicService.CreateFacilityAsync(ClinicId, _facilityForm);
        _savingFacility = false;

        if (!response.IsSuccess || response.Data is null)
        {
            _actionError = response.ErrorMessage ?? "Could not add facility.";
            return;
        }

        await LoadDetailAsync();
        ResetFacilityForm(_detail?.Country ?? string.Empty);
    }

    private async Task UpdateFacilityAsync()
    {
        if (_editingFacilityId is null)
            return;

        _savingFacility = true;
        _actionError = null;
        var response = await AdminClinicService.UpdateFacilityAsync(ClinicId, _editingFacilityId.Value, _facilityForm);
        _savingFacility = false;

        if (!response.IsSuccess)
        {
            _actionError = response.ErrorMessage ?? "Could not update facility.";
            return;
        }

        await LoadDetailAsync();
        ResetFacilityForm(_detail?.Country ?? string.Empty);
    }

    private async Task InviteStaffAsync()
    {
        _inviting = true;
        _actionError = null;
        var response = await AdminClinicService.InviteStaffAsync(ClinicId, _inviteEmail.Trim());
        _inviting = false;

        if (!response.IsSuccess)
        {
            _actionError = response.ErrorMessage ?? "Could not invite staff.";
            return;
        }

        _inviteEmail = string.Empty;
        await LoadStaffAsync();
    }

    private async Task ResendInvitationAsync(Guid userId)
    {
        _resendingUserId = userId;
        _actionError = null;
        var response = await AdminClinicService.ResendStaffInvitationAsync(ClinicId, userId);
        _resendingUserId = null;

        if (!response.IsSuccess)
        {
            _actionError = response.ErrorMessage ?? "Could not resend invitation.";
            return;
        }

        await LoadStaffAsync();
    }

