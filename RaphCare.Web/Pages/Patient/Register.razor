@page "/patient/register"
@layout AuthShellLayout
@inject IUiCultureService CultureService
@implements IDisposable

<PageTitle>@AppResources.T("PatientRegister_PageTitle")</PageTitle>

<div class="auth-card auth-card-form @(_awaitingCode ? "auth-card-verify" : null)">
    <button type="button" class="back-link" @onclick="GoBack">
        @(_awaitingCode ? AppResources.T("Common_EditDetails") : AppResources.T("Common_Back"))
    </button>
    <h2 class="auth-card-title">@AppResources.T("PatientRegister_Title")</h2>
    <p class="auth-card-subtitle">
        @(_awaitingCode
            ? AppResources.T("PatientRegister_SubtitleCode")
            : AppResources.T("PatientRegister_SubtitleDetails"))
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_status))
    {
        <AuthStatusNotice Email="@_model.Email" />
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div class="form-grid single-column">
            @if (!_awaitingCode)
            {
                <div class="form-field">
                    <label>@AppResources.T("Common_FirstName")</label>
                    <InputText class="form-control" @bind-Value="_model.FirstName" />
                </div>
                <div class="form-field">
                    <label>@AppResources.T("Common_LastName")</label>
                    <InputText class="form-control" @bind-Value="_model.LastName" />
                </div>
                <div class="form-field">
                    <label>@AppResources.T("Common_Email")</label>
                    <InputText class="form-control" @bind-Value="_model.Email" type="email" />
                </div>
                <div class="form-field">
                    <label>@AppResources.T("Common_Password")</label>
                    <InputText class="form-control" @bind-Value="_model.Password" type="password" autocomplete="new-password" />
                    <p class="form-hint">@AppResources.T("Common_PasswordHint")</p>
                </div>
                <div class="form-field">
                    <label>@AppResources.T("Common_ConfirmPassword")</label>
                    <InputText class="form-control" @bind-Value="_model.ConfirmPassword" type="password" autocomplete="new-password" />
                </div>
                <div class="form-field">
                    <label>@AppResources.T("Common_ClinicOptional")</label>
                    <SearchableSelect TValue="string"
                                      @bind-Value="_selectedClinicId"
                                      Placeholder="@AppResources.T("Common_NoClinicYet")"
                                      Options="ClinicSelectOptions" />
                </div>
            }
            else
            {
                <div class="form-field verification-field">
                    <label>@AppResources.T("Common_VerificationCode")</label>
                    <InputText class="form-control verification-code-input" @bind-Value="_model.VerificationCode" placeholder="@AppResources.T("Common_VerificationCodePlaceholder")" maxlength="12" autocomplete="one-time-code" />
                    <div class="verification-resend">
                        <span>@AppResources.T("Common_NeedNewCode")</span>
                        <button type="button" class="link-btn" disabled="@_sendingCode" @onclick="SendCodeAsync">
                            @(_sendingCode ? AppResources.T("Common_Resending") : AppResources.T("Common_ResendCode"))
                        </button>
                    </div>
                </div>
            }
        </div>
        <div class="form-actions" style="margin-top: 1rem;">
            <button class="btn btn-primary btn-block" type="submit" disabled="@_busy">
                @(_busy
                    ? (_awaitingCode ? AppResources.T("Common_CreatingAccount") : AppResources.T("Common_SendingCode"))
                    : (_awaitingCode ? AppResources.T("Common_VerifyAndCreateAccount") : AppResources.T("Common_Continue")))
            </button>
        </div>
    </EditForm>

    @if (!_awaitingCode)
    {
        <p class="auth-card-foot">@AppResources.T("PatientRegister_FootAlready") <a href="/patient/signin">@AppResources.T("Common_SignIn")</a></p>
    }
</div>

@code {
    [Inject] private IEmailAuthService EmailAuth { get; set; } = default!;
    [Inject] private IWebAuthService WebAuth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private readonly RegisterModel _model = new();
    private IReadOnlyList<RegistrationClinicItem> _clinics = Array.Empty<RegistrationClinicItem>();
    private string _selectedClinicId = string.Empty;
    private bool _busy;
    private bool _sendingCode;
    private bool _awaitingCode;
    private string? _error;
    private string? _status;

    private IReadOnlyList<SelectOption<string>> ClinicSelectOptions =>
        _clinics.Select(clinic => new SelectOption<string>(clinic.Id.ToString(), clinic.Name)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        CultureService.CultureChanged += OnCultureChanged;
        var response = await EmailAuth.GetRegistrationClinicsAsync();
        if (response.IsSuccess && response.Data is not null)
            _clinics = response.Data;
    }

    private void OnCultureChanged() => _ = InvokeAsync(StateHasChanged);

    private void GoBack()
    {
        if (_awaitingCode)
        {
            ReturnToDetails(keepError: false);
            return;
        }

        Navigation.NavigateTo("/");
    }

    private void ReturnToDetails(bool keepError)
    {
        _awaitingCode = false;
        _model.VerificationCode = string.Empty;
        _status = null;
        if (!keepError)
            _error = null;
    }

    private async Task SendCodeAsync()
    {
        _sendingCode = true;
        _error = null;
        _status = null;

        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            _sendingCode = false;
            _error = AppResources.T("Common_EnterEmailBeforeCode");
            return;
        }

        var sent = await TrySendCodeAsync();
        _sendingCode = false;
        if (sent)
            _status = AppResources.T("Common_CodeSentCheckInbox");
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _status = null;

        if (!_awaitingCode)
        {
            await AdvanceToVerificationAsync();
            return;
        }

        await RegisterAsync();
    }

    private async Task AdvanceToVerificationAsync()
    {
        if (!ValidateDetails())
            return;

        _busy = true;
        var sent = await TrySendCodeAsync();
        _busy = false;

        if (!sent)
            return;

        _model.VerificationCode = string.Empty;
        _awaitingCode = true;
        _status = AppResources.T("Common_CodeSentCheckInbox");
    }

    private async Task RegisterAsync()
    {
        var code = VerificationCodeText.Normalize(_model.VerificationCode);
        if (code.Length == 0)
        {
            _error = AppResources.T("Common_EnterSixDigitCodeHint");
            return;
        }

        if (code.Length != 6)
        {
            _error = AppResources.T("Common_CodeMustBeSixDigits");
            return;
        }

        _busy = true;

        Guid? clinicId = Guid.TryParse(_selectedClinicId, out var id) ? id : null;
        var response = await EmailAuth.RegisterAsync(
            _model.FirstName.Trim(),
            _model.LastName.Trim(),
            _model.Email.Trim(),
            _model.Password,
            clinicId,
            code);

        _busy = false;
        if (!response.IsSuccess || string.IsNullOrWhiteSpace(response.Data?.Token))
        {
            _error = response.ErrorMessage ?? AppResources.T("Common_RegistrationFailed");
            if (RegisterAccountDetails.LooksLikeDetailsError(_error))
                ReturnToDetails(keepError: true);
            return;
        }

        await WebAuth.StoreSessionAsync(response.Data.Token, WebAccountKind.Patient);
        Navigation.NavigateTo("/patient/welcome", replace: true);
    }

    private async Task<bool> TrySendCodeAsync()
    {
        var response = await EmailAuth.SendEmailVerificationAsync(_model.Email.Trim());
        if (response.IsSuccess)
            return true;

        _error = response.ErrorMessage ?? AppResources.T("Common_CouldNotSendVerificationEmail");
        return false;
    }

    private bool ValidateDetails()
    {
        var key = RegisterAccountDetails.Validate(_model.FirstName, _model.LastName, _model.Email, _model.Password, _model.ConfirmPassword);
        if (key is null)
            return true;

        _error = AppResources.T(key);
        return false;
    }

    public void Dispose() => CultureService.CultureChanged -= OnCultureChanged;

    private sealed class RegisterModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public string VerificationCode { get; set; } = string.Empty;
    }
}
