@page "/patient/register"
@layout AuthShellLayout

<PageTitle>Register — Patient</PageTitle>

<div class="auth-card auth-card-form">
    <a class="back-link" href="/">← Back</a>
    <h2 class="auth-card-title">Create patient account</h2>
    <p class="auth-card-subtitle">Verify your email to confirm you're a real user.</p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-error">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="alert alert-info">@_status</div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div class="form-grid single-column">
            <div class="form-field">
                <label>First name</label>
                <InputText class="form-control" @bind-Value="_model.FirstName" />
            </div>
            <div class="form-field">
                <label>Last name</label>
                <InputText class="form-control" @bind-Value="_model.LastName" />
            </div>
            <div class="form-field">
                <label>Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" type="email" />
            </div>
            <div class="form-field">
                <label>Password</label>
                <InputText class="form-control" @bind-Value="_model.Password" type="password" />
            </div>
            <div class="form-field">
                <label>Clinic (optional)</label>
                <InputSelect class="form-control" @bind-Value="_selectedClinicId">
                    <option value="">No clinic yet</option>
                    @foreach (var clinic in _clinics)
                    {
                        <option value="@clinic.Id">@clinic.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="form-field verification-field">
                <label>Verification code</label>
                <div class="verification-row">
                    <InputText class="form-control" @bind-Value="_model.VerificationCode" placeholder="6-digit code" maxlength="6" />
                    <button type="button" class="btn btn-secondary" disabled="@_sendingCode" @onclick="SendCodeAsync">
                        @(_sendingCode ? "Sending…" : "Send code")
                    </button>
                </div>
            </div>
        </div>
        <div class="form-actions" style="margin-top: 1rem;">
            <button class="btn btn-primary" type="submit" disabled="@_busy">
                @(_busy ? "Creating account…" : "Create account")
            </button>
        </div>
    </EditForm>

    <p class="auth-card-foot">Already registered? <a href="/patient/signin">Sign in</a></p>
</div>

@code {
    [Inject] private IEmailAuthService EmailAuth { get; set; } = default!;
    [Inject] private IWebAuthService WebAuth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private readonly RegisterModel _model = new();
    private IReadOnlyList<RegistrationClinicItem> _clinics = Array.Empty<RegistrationClinicItem>();
    private string _selectedClinicId = string.Empty;
    private bool _busy;
    private bool _sendingCode;
    private string? _error;
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        var response = await EmailAuth.GetRegistrationClinicsAsync();
        if (response.IsSuccess && response.Data is not null)
            _clinics = response.Data;
    }

    private async Task SendCodeAsync()
    {
        _sendingCode = true;
        _error = null;
        _status = null;

        if (string.IsNullOrWhiteSpace(_model.Email))
        {
            _sendingCode = false;
            _error = "Enter your email before requesting a verification code.";
            return;
        }

        var response = await EmailAuth.SendEmailVerificationAsync(_model.Email.Trim());
        _sendingCode = false;

        if (response.IsSuccess)
            _status = "Verification code sent. Check your inbox.";
        else
            _error = response.ErrorMessage ?? "Could not send verification email.";
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _status = null;

        if (string.IsNullOrWhiteSpace(_model.VerificationCode))
        {
            _error = "Enter the 6-digit verification code from your email. Tap Send code if you have not received one yet.";
            return;
        }

        if (_model.VerificationCode.Trim().Length != 6)
        {
            _error = "Verification code must be exactly 6 digits.";
            return;
        }

        _busy = true;

        Guid? clinicId = Guid.TryParse(_selectedClinicId, out var id) ? id : null;
        var response = await EmailAuth.RegisterAsync(
            _model.FirstName.Trim(),
            _model.LastName.Trim(),
            _model.Email.Trim(),
            _model.Password,
            clinicId,
            _model.VerificationCode.Trim());

        _busy = false;
        if (!response.IsSuccess || string.IsNullOrWhiteSpace(response.Data?.Token))
        {
            _error = response.ErrorMessage ?? "Registration failed.";
            return;
        }

        await WebAuth.StoreSessionAsync(response.Data.Token, WebAccountKind.Patient);
        Navigation.NavigateTo("/patient/welcome", replace: true);
    }

    private sealed class RegisterModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string VerificationCode { get; set; } = string.Empty;
    }
}
