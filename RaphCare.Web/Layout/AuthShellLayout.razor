@inherits LayoutComponentBase

<div class="auth-shell">
    <aside class="auth-brand-panel">
        <div class="auth-brand-glow"></div>

        <div class="auth-brand-top">
            <div class="auth-brand-logo">+</div>
            <div>
                <div class="auth-brand-name">RaphCare</div>
                <div class="auth-brand-tag">Connected healthcare platform</div>
            </div>
        </div>

        <div class="auth-brand-middle">
            <h1 class="auth-brand-headline">Bring every patient, clinic and care team into one trusted view.</h1>
            <p class="auth-brand-lead">
                Register hospitals, onboard staff, and give patients secure access to records, appointments, and telehealth.
            </p>

            <div class="auth-feature-list">
                <div class="auth-feature">
                    <span class="auth-feature-icon">🏥</span>
                    <div>
                        <div class="auth-feature-title">Hospital onboarding</div>
                        <div class="auth-feature-desc">Register your clinic, facilities, and practice portal in minutes.</div>
                    </div>
                </div>
                <div class="auth-feature">
                    <span class="auth-feature-icon">📋</span>
                    <div>
                        <div class="auth-feature-title">Clinical workspace</div>
                        <div class="auth-feature-desc">Patients, visits, and reporting scoped per clinic tenant.</div>
                    </div>
                </div>
                <div class="auth-feature">
                    <span class="auth-feature-icon">🔒</span>
                    <div>
                        <div class="auth-feature-title">Verified access</div>
                        <div class="auth-feature-desc">Email verification and 2FA codes sent from your RaphCare mailbox.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-brand-footer">
            <span>Secure email sign-in</span>
            <span>© @DateTime.UtcNow.Year RaphCare</span>
        </div>
    </aside>

    <main class="auth-content-panel">
        <div class="auth-mobile-brand">
            <div class="auth-brand-logo sm">+</div>
            <div>
                <div class="auth-brand-name">RaphCare</div>
                <div class="auth-brand-tag">Healthcare platform</div>
            </div>
        </div>

        <div class="auth-card-shell">
            @Body
        </div>
    </main>
</div>
