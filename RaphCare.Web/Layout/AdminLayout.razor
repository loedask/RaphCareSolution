@inherits LayoutComponentBase
@implements IDisposable

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <div class="admin-brand-icon">+</div>
            <div>
                <div class="admin-brand-title">RaphCare</div>
                <div class="admin-brand-sub">Clinic portal</div>
            </div>
        </div>

        <nav class="admin-nav">
            <div class="admin-nav-section">Platform</div>
            <NavLink class="admin-nav-link" href="/admin" Match="NavLinkMatch.All">
                <span class="admin-nav-icon" aria-hidden="true">▦</span>
                Dashboard
            </NavLink>
            <NavLink class="admin-nav-link" href="/admin/hospitals">
                <span class="admin-nav-icon" aria-hidden="true">⌂</span>
                Hospitals
            </NavLink>

            <div class="admin-nav-section">Onboarding</div>
            <NavLink class="admin-nav-link" href="/admin/hospitals/register">
                <span class="admin-nav-icon" aria-hidden="true">＋</span>
                Register hospital
            </NavLink>
        </nav>

        <div class="admin-sidebar-footer">
            <div class="admin-user-card">
                <div class="admin-user-avatar">HC</div>
                <div class="admin-user-meta">
                    <div class="admin-user-name">Healthcare professional</div>
                    <div class="admin-user-role">Clinic administrator</div>
                </div>
            </div>
            <button type="button" class="btn btn-ghost admin-signout" @onclick="SignOutAsync">Sign out</button>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-left">
                <nav class="admin-breadcrumb" aria-label="Breadcrumb">
                    @foreach (var (label, href, isLast) in _breadcrumbs)
                    {
                        if (isLast)
                        {
                            <span class="admin-breadcrumb-current">@label</span>
                        }
                        else
                        {
                            <a href="@href">@label</a>
                            <span class="admin-breadcrumb-sep">/</span>
                        }
                    }
                </nav>
            </div>
            <div class="admin-topbar-right">
                <label class="admin-search">
                    <span class="admin-search-icon" aria-hidden="true">⌕</span>
                    <input type="search" placeholder="Search hospitals, facilities…" disabled />
                </label>
                @if (ClinicContext.MyClinics.Count > 1)
                {
                    <div class="admin-clinic-switcher">
                        <button type="button"
                                class="admin-clinic-switcher-trigger @(_clinicSwitcherOpen ? "open" : "")"
                                aria-haspopup="listbox"
                                aria-expanded="@_clinicSwitcherOpen"
                                @onclick="ToggleClinicSwitcher">
                            <span class="admin-clinic-switcher-icon" aria-hidden="true">⌂</span>
                            <span class="admin-clinic-switcher-label">@(ClinicContext.CurrentClinicName ?? "Select hospital")</span>
                            <span class="admin-clinic-switcher-caret" aria-hidden="true">▾</span>
                        </button>
                        @if (_clinicSwitcherOpen)
                        {
                            <div class="admin-clinic-switcher-menu" role="listbox" aria-label="Switch hospital">
                                @foreach (var clinic in ClinicContext.MyClinics)
                                {
                                    <button type="button"
                                            class="admin-clinic-switcher-item @(ClinicContext.CurrentClinicId == clinic.Id ? "active" : "")"
                                            role="option"
                                            aria-selected="@(ClinicContext.CurrentClinicId == clinic.Id)"
                                            @onclick="() => SwitchClinicAsync(clinic.Id, clinic.Name)">
                                        <span class="admin-clinic-switcher-item-name">@clinic.Name</span>
                                        <span class="admin-clinic-switcher-item-meta">@clinic.RegistrationNumber</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(ClinicContext.CurrentClinicName))
                {
                    <span class="admin-pill admin-pill-clinic" title="Active hospital context">@ClinicContext.CurrentClinicName</span>
                }
                <span class="admin-pill">Professional</span>
            </div>
        </header>
        <main class="admin-content">
            @Body
        </main>
    </div>
</div>
