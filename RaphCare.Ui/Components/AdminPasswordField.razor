<div class="password-field">
    <InputText class="form-control password-field-input"
               Value="@Value"
               ValueChanged="OnValueChanged"
               ValueExpression="ValueExpression"
               type="@(_showPassword ? "text" : "password")"
               disabled="@Disabled"
               autocomplete="@Autocomplete" />
    <button type="button"
            class="password-field-toggle"
            disabled="@Disabled"
            aria-pressed="@_showPassword"
            aria-label="@(_showPassword ? HideLabel : ShowLabel)"
            @onclick="Toggle">
        @(_showPassword ? HideLabel : ShowLabel)
    </button>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string ShowLabel { get; set; } = "Show";
    [Parameter] public string HideLabel { get; set; } = "Hide";

    private bool _showPassword;

    private Task OnValueChanged(string? value) => ValueChanged.InvokeAsync(value);

    private void Toggle() => _showPassword = !_showPassword;
}
